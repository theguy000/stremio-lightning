// Stremio Web Details hero column: exact Logo.less, Hero.less, Still.less, Description.less, and Links.less sizing.
import { LinkGroup, PreviewData } from "../meta-preview.slint";
import { Theme } from "../theme.slint";
import { DetailsHeroActions } from "hero-actions.slint";

export component DetailsHero inherits VerticalLayout {
    in property <PreviewData> preview;
    in property <bool> has-preview;
    in property <length> rem-size;
    in property <bool> rate-visible;
    in property <bool> rate-enabled;
    in property <bool> rated-liked;
    in property <bool> rated-loved;
    in property <bool> has-picked-episode;
    in property <string> picked-title;
    in property <string> picked-overview;
    in property <string> picked-released;
    in property <bool> picked-has-still;
    in property <image> picked-still;
    in property <bool> can-play: false;
    in property <string> play-label: "Watch";
    in property <string> play-sublabel: "";

    callback play-primary;
    callback share;
    callback rate-like;
    callback rate-love;
    callback toggle-library;
    callback toggle-watched;

    spacing: 0px;

    property <length> logo-h: 9 * root.rem-size;

    if root.has-preview && root.preview.has-logo: HorizontalLayout {
        alignment: start;
        Image {
            height: root.logo-h;
            width: Math.min(parent.width, self.source.height > 0 ? root.logo-h * (self.source.width / self.source.height) : 16 * root.rem-size);
            source: root.preview.logo;
            image-fit: contain;
        }
    }
    if root.has-preview && !root.preview.has-logo && root.preview.title != "": Text {
        text: root.preview.title;
        font-size: 2.75 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
        wrap: word-wrap;
    }

    if root.has-preview: Rectangle {
        vertical-stretch: 1;
        min-height: 1 * root.rem-size;
    }

    if root.has-preview && !root.has-picked-episode: VerticalLayout {
        spacing: 0px;
        alignment: start;

        HorizontalLayout {
            spacing: 2.5 * root.rem-size;
            alignment: start;
            if root.preview.release-info != "": Text {
                text: root.preview.release-info;
                font-size: 1 * root.rem-size;
                font-weight: 500;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.preview.runtime != "": Text {
                text: root.preview.runtime;
                font-size: 1 * root.rem-size;
                font-weight: 500;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.preview.rating != "": HorizontalLayout {
                spacing: 0.625 * root.rem-size;
                alignment: start;
                Text {
                    text: root.preview.rating;
                    font-size: 1 * root.rem-size;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 2.6 * root.rem-size;
                    height: 1.35 * root.rem-size;
                    y: (parent.height - self.height) / 2;
                    border-radius: 0.25 * root.rem-size;
                    background: #f5c518;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "IMDb";
                        font-size: 0.78 * root.rem-size;
                        font-weight: 800;
                        color: #000000;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.preview.description != "": Rectangle { height: 1.5 * root.rem-size; }
        if root.preview.description != "": Text {
            width: Math.min(parent.width, 37.5 * root.rem-size);
            text: root.preview.description;
            font-size: 0.9375 * root.rem-size;
            color: rgba(255, 255, 255, 0.64);
            wrap: word-wrap;
        }

        if root.preview.groups.length > 0: Rectangle { height: 1.75 * root.rem-size; }
        VerticalLayout {
            spacing: 1.125 * root.rem-size;
            alignment: start;
            for group in root.preview.groups: HorizontalLayout {
                spacing: 1.25 * root.rem-size;
                alignment: start;
                Text {
                    width: 3.5 * root.rem-size;
                    text: group.label;
                    font-size: 0.8125 * root.rem-size;
                    font-weight: 700;
                    color: rgba(255, 255, 255, 0.46);
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 0.625 * root.rem-size;
                    alignment: start;
                    for item in group.links: Rectangle {
                        height: 2.125 * root.rem-size;
                        width: chip-label.preferred-width + 2.25 * root.rem-size;
                        border-radius: 1.0625 * root.rem-size;
                        background: Theme.overlay;
                        chip-label := Text {
                            width: parent.width;
                            height: parent.height;
                            text: item;
                            font-size: 0.875 * root.rem-size;
                            font-weight: 500;
                            color: Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.has-preview && root.has-picked-episode: VerticalLayout {
        spacing: 0px;
        alignment: start;

        if root.picked-has-still: Rectangle {
            width: Math.min(parent.width, 19 * root.rem-size);
            height: self.width * 9 / 16;
            border-radius: 0.75 * root.rem-size;
            clip: true;
            background: Theme.overlay;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.picked-still;
                image-fit: cover;
                opacity: 0.92;
            }
        }
        if root.picked-has-still: Rectangle { height: 1.25 * root.rem-size; }
        Text {
            text: root.picked-title;
            font-size: 1.75 * root.rem-size;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.picked-released != "" || root.preview.runtime != "": Rectangle { height: 0.85 * root.rem-size; }
        if root.picked-released != "" || root.preview.runtime != "": HorizontalLayout {
            spacing: 2.5 * root.rem-size;
            alignment: start;
            if root.picked-released != "": Text {
                text: root.picked-released;
                font-size: 0.95 * root.rem-size;
                font-weight: 600;
                color: Theme.text;
            }
            if root.preview.runtime != "": Text {
                text: root.preview.runtime;
                font-size: 0.95 * root.rem-size;
                font-weight: 600;
                color: Theme.text;
            }
        }
        if root.picked-overview != "" || root.preview.description != "": Rectangle { height: 0.85 * root.rem-size; }
        if root.picked-overview != "" || root.preview.description != "": Text {
            width: Math.min(parent.width, 37.5 * root.rem-size);
            text: root.picked-overview != "" ? root.picked-overview : root.preview.description;
            font-size: 0.9375 * root.rem-size;
            color: rgba(255, 255, 255, 0.64);
            wrap: word-wrap;
        }
    }

    if root.has-preview: Rectangle {
        height: 2.5 * root.rem-size;
    }

    if root.has-preview: DetailsHeroActions {
        preview: root.preview;
        rem-size: root.rem-size;
        rate-visible: root.rate-visible;
        rate-enabled: root.rate-enabled;
        rated-liked: root.rated-liked;
        rated-loved: root.rated-loved;
        can-play: root.can-play;
        play-label: root.play-label;
        play-sublabel: root.play-sublabel;
        play-primary => { root.play-primary(); }
        share => { root.share(); }
        rate-like => { root.rate-like(); }
        rate-love => { root.rate-love(); }
        toggle-library => { root.toggle-library(); }
        toggle-watched => { root.toggle-watched(); }
    }
}
