// Stremio Web Details pill action bar: PlayButton, Trailer, ToggleButton (Library/Watched), RateButton, Share.
import { PreviewData } from "../meta-preview.slint";
import { Theme } from "../theme.slint";

component CheckMark inherits Path {
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: #141414;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    MoveTo { x: 3; y: 8.5; }
    LineTo { x: 6.5; y: 12; }
    LineTo { x: 13; y: 4.5; }
}

component ToggleSlot inherits Rectangle {
    in property <length> rem-size;
    in property <image> base-icon;
    in property <image> on-icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    background: touch.has-hover && root.enabled ? rgba(255, 255, 255, 0.1) : transparent;
    animate background { duration: 150ms; }

    Rectangle {
        width: 1.625 * root.rem-size;
        height: 1.625 * root.rem-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Image {
            width: 1.375 * root.rem-size;
            height: 1.375 * root.rem-size;
            x: root.active ? 0px : (parent.width - self.width) / 2;
            y: root.active ? 0px : (parent.height - self.height) / 2;
            source: root.active ? root.on-icon : root.base-icon;
            colorize: Theme.text;
            opacity: (touch.has-hover || root.active) ? 1 : 0.7;
            transform-scale: root.active ? 0.82 : 1.0;
            animate opacity { duration: 150ms; }
            animate transform-scale { duration: 220ms; easing: ease-out; }
            animate x { duration: 220ms; easing: ease-out; }
            animate y { duration: 220ms; easing: ease-out; }
        }

        Rectangle {
            x: parent.width - self.width;
            y: parent.height - self.height;
            width: 0.875 * root.rem-size;
            height: 0.875 * root.rem-size;
            border-radius: 0.4375 * root.rem-size;
            background: #f5c518;
            opacity: root.active ? 1 : 0;
            transform-scale: root.active ? 1.0 : 0.0;
            animate opacity { duration: 180ms; easing: ease-out; }
            animate transform-scale { duration: 240ms; easing: ease-out; }

            CheckMark {
                width: 0.56 * root.rem-size;
                height: 0.56 * root.rem-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RateDual inherits Rectangle {
    in property <length> rem-size;
    in property <image> left-icon;
    in property <image> right-icon;
    in property <bool> enabled: true;
    callback left-clicked;
    callback right-clicked;

    width: 7 * root.rem-size;
    height: 3.5 * root.rem-size;
    border-radius: 1.75 * root.rem-size;
    background: Theme.overlay;
    opacity: root.enabled ? 1 : 0.45;
    clip: true;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        Rectangle {
            horizontal-stretch: 1;
            background: lt.has-hover && root.enabled ? rgba(255, 255, 255, 0.1) : transparent;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.375 * root.rem-size;
                height: 1.375 * root.rem-size;
                source: root.left-icon;
                colorize: Theme.text;
                opacity: lt.has-hover ? 1 : 0.85;
            }
            lt := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.left-clicked(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: rt.has-hover && root.enabled ? rgba(255, 255, 255, 0.1) : transparent;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.375 * root.rem-size;
                height: 1.375 * root.rem-size;
                source: root.right-icon;
                colorize: Theme.text;
                opacity: rt.has-hover ? 1 : 0.85;
            }
            rt := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.right-clicked(); }
            }
        }
    }
}

export component DetailsHeroActions inherits HorizontalLayout {
    in property <PreviewData> preview;
    in property <length> rem-size;
    in property <bool> rate-visible;
    in property <bool> rate-enabled;
    in property <bool> rated-liked;
    in property <bool> rated-loved;
    in property <bool> can-play: false;
    in property <string> play-label: "Watch";
    in property <string> play-sublabel: "";

    callback play-primary;
    callback share;
    callback rate-like;
    callback rate-love;
    callback toggle-library;
    callback toggle-watched;

    height: 3.5 * root.rem-size;
    spacing: 0.875 * root.rem-size;
    alignment: start;

    if root.can-play: Rectangle {
        width: play-row.preferred-width;
        height: 3.5 * root.rem-size;
        border-radius: 1.75 * root.rem-size;
        background: play-touch.has-hover ? #27c470 : Theme.accent-green;
        play-row := HorizontalLayout {
            padding-left: 1.75 * root.rem-size;
            padding-right: 1.75 * root.rem-size;
            spacing: 0.75 * root.rem-size;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 1.375 * root.rem-size;
                    height: 1.375 * root.rem-size;
                    source: @image-url("../icons/play.svg");
                    colorize: #ffffff;
                }
            }
            Text {
                text: root.play-label != "" ? root.play-label : "Watch";
                font-size: 0.9375 * root.rem-size;
                font-weight: 700;
                color: #ffffff;
                vertical-alignment: center;
            }
            if root.play-sublabel != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 1.25 * root.rem-size;
                    background: rgba(255, 255, 255, 0.4);
                }
            }
            if root.play-sublabel != "": Text {
                text: root.play-sublabel;
                font-size: 0.9375 * root.rem-size;
                font-weight: 500;
                color: #ffffff;
                opacity: 0.85;
                vertical-alignment: center;
            }
        }
        play-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.play-primary(); }
        }
    }

    if root.preview.has-trailer: Rectangle {
        width: trailer-row.preferred-width;
        height: 3.5 * root.rem-size;
        border-radius: 1.75 * root.rem-size;
        background: trailer-touch.has-hover ? rgba(255, 255, 255, 0.1) : Theme.overlay;
        trailer-row := HorizontalLayout {
            padding-left: 1.5 * root.rem-size;
            padding-right: 1.5 * root.rem-size;
            spacing: 0.65 * root.rem-size;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 1.375 * root.rem-size;
                    height: 1.375 * root.rem-size;
                    source: @image-url("../icons/trailer.svg");
                    colorize: Theme.text;
                    opacity: 0.9;
                }
            }
            Text {
                text: "Trailer";
                font-size: 0.9375 * root.rem-size;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        trailer-touch := TouchArea { mouse-cursor: pointer; }
    }

    Rectangle {
        width: 7 * root.rem-size;
        height: 3.5 * root.rem-size;
        border-radius: 1.75 * root.rem-size;
        background: Theme.overlay;
        clip: true;

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            ToggleSlot {
                horizontal-stretch: 1;
                rem-size: root.rem-size;
                base-icon: @image-url("../icons/library-outline.svg");
                on-icon: @image-url("../icons/library.svg");
                active: root.preview.in-library;
                clicked => { root.toggle-library(); }
            }
            ToggleSlot {
                horizontal-stretch: 1;
                rem-size: root.rem-size;
                base-icon: @image-url("../icons/eye.svg");
                on-icon: @image-url("../icons/eye.svg");
                active: root.preview.watched;
                clicked => { root.toggle-watched(); }
            }
        }
    }

    if root.rate-visible: RateDual {
        rem-size: root.rem-size;
        enabled: root.rate-enabled;
        left-icon: root.rated-liked ? @image-url("../icons/thumbs-up.svg") : @image-url("../icons/thumbs-up-outline.svg");
        right-icon: root.rated-loved ? @image-url("../icons/heart.svg") : @image-url("../icons/heart-outline.svg");
        left-clicked => { root.rate-like(); }
        right-clicked => { root.rate-love(); }
    }

    Rectangle {
        width: 3.5 * root.rem-size;
        height: 3.5 * root.rem-size;
        border-radius: 1.75 * root.rem-size;
        background: share-touch.has-hover ? rgba(255, 255, 255, 0.1) : Theme.overlay;
        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 1.375 * root.rem-size;
            height: 1.375 * root.rem-size;
            source: @image-url("../icons/share.svg");
            colorize: Theme.text;
            opacity: 0.9;
        }
        share-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.share(); }
        }
    }
}
