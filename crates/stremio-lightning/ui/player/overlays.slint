// HUD overlays, navigation bar, side-drawer tab, and floating skip disc for the Player.
import { Theme } from "../theme.slint";
import { PlayerSlider } from "slider.slint";

export component PlayerBufferingOverlay inherits Rectangle {
    in property <length> rem-size;
    in property <image> backdrop;
    in property <bool> has-backdrop;
    in property <image> logo;
    in property <bool> has-logo;
    in property <bool> expects-logo;
    in property <string> title;
    in property <bool> buffering;
    in property <bool> pulse;

    background: #000000;

    if root.has-backdrop: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.backdrop;
        image-fit: cover;
        opacity: 0.6;
    }
    if root.has-logo: Image {
        width: Math.min(parent.width, 15 * root.rem-size);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.logo;
        image-fit: contain;
        opacity: root.pulse ? 1 : 0.4;
        animate opacity { duration: 1s; easing: ease-in-out; }
    }
    if !root.has-logo && !root.expects-logo: Text {
        width: parent.width - 16 * root.rem-size;
        x: 8 * root.rem-size;
        y: (parent.height - self.height) / 2;
        text: root.title;
        font-size: 2 * root.rem-size;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
        opacity: root.pulse ? 1 : 0.4;
        animate opacity { duration: 1s; easing: ease-in-out; }
    }
    if root.buffering: Text {
        x: 0;
        width: parent.width;
        y: parent.height / 2 + 8 * root.rem-size;
        text: "Buffering";
        font-size: 1 * root.rem-size;
        color: Theme.text;
        opacity: 0.7;
        horizontal-alignment: center;
    }
}

export component PlayerErrorOverlay inherits Rectangle {
    in property <length> rem-size;
    in property <string> error;

    background: #000000;
    Text {
        width: Math.min(parent.width - 16 * root.rem-size, 40 * root.rem-size);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.error;
        font-size: 2 * root.rem-size;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component PlayerVolumeIndicator inherits Rectangle {
    in property <length> rem-size;
    in property <image> volume-glyph;
    in property <float> volume-value;

    width: 9 * root.rem-size;
    height: 13 * root.rem-size;
    border-radius: 0.75 * root.rem-size;
    background: Theme.overlay;

    VerticalLayout {
        padding: 2 * root.rem-size;
        spacing: 1 * root.rem-size;
        alignment: space-between;
        VerticalLayout {
            alignment: center;
            Image {
                width: 6.5 * root.rem-size;
                height: 6.5 * root.rem-size;
                source: root.volume-glyph;
                colorize: Theme.text;
            }
        }
        PlayerSlider {
            rem-size: root.rem-size;
            height: 1 * root.rem-size;
            value: root.volume-value;
            minimum: 0;
            maximum: 200;
            boost: true;
            enabled: false;
            track-size: 0.35 * root.rem-size;
            thumb-size: 1 * root.rem-size;
        }
    }
}

export component PlayerToastIndicator inherits Rectangle {
    in property <length> rem-size;
    in property <string> text;

    width: label.width + 4 * root.rem-size;
    height: 4 * root.rem-size;
    border-radius: 4 * root.rem-size;
    background: Theme.modal-background;

    label := Text {
        x: 2 * root.rem-size;
        y: 0;
        height: parent.height;
        text: root.text;
        font-size: 1.1 * root.rem-size;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
}

export component PlayerNavBar inherits Rectangle {
    in property <length> rem-size;
    in property <string> title;
    in property <bool> fullscreen;
    callback back();
    callback toggle-fullscreen();

    height: 5 * root.rem-size;
    opacity: 1;
    animate opacity { duration: 200ms; }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 8 * root.rem-size;
        background: @linear-gradient(180deg, #00000059 0%, transparent 100%);
    }

    Rectangle {
        x: 0;
        y: 1 * root.rem-size;
        width: parent.width;
        height: 4 * root.rem-size;

        Rectangle {
            x: 1.5 * root.rem-size;
            y: 0;
            width: 4 * root.rem-size;
            height: 4 * root.rem-size;
            border-radius: 0.75 * root.rem-size;
            background: back-touch.has-hover ? Theme.overlay : transparent;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 2.2 * root.rem-size;
                height: 2.2 * root.rem-size;
                source: @image-url("../icons/chevron-back.svg");
                colorize: Theme.text;
                opacity: 0.7;
            }
            back-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.back(); }
            }
        }

        Text {
            x: 6 * root.rem-size;
            y: 0;
            width: parent.width - 12 * root.rem-size;
            height: 4 * root.rem-size;
            text: root.title;
            font-size: 1.1 * root.rem-size;
            font-weight: 500;
            color: Theme.text;
            opacity: 0.9;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: parent.width - 5.5 * root.rem-size;
            y: 0;
            width: 4 * root.rem-size;
            height: 4 * root.rem-size;
            border-radius: 0.75 * root.rem-size;
            background: full-touch.has-hover ? Theme.overlay : transparent;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 2.2 * root.rem-size;
                height: 2.2 * root.rem-size;
                source: root.fullscreen ? @image-url("../icons/minimize.svg") : @image-url("../icons/maximize.svg");
                colorize: Theme.text;
            }
            full-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-fullscreen(); }
            }
        }
    }
}

export component PlayerDrawerTab inherits Rectangle {
    in property <length> rem-size;
    callback clicked;

    width: 7.5 * root.rem-size;
    height: 12.5 * root.rem-size;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../icons/drawer-shape.svg");
        colorize: Theme.modal-background;
    }
    Image {
        x: 0.5 * root.rem-size;
        y: (parent.height - self.height) / 2;
        width: 2.5 * root.rem-size;
        height: 2.5 * root.rem-size;
        source: @image-url("../icons/chevron-back.svg");
        colorize: Theme.text;
        opacity: 0.6;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PlayerSkipDisc inherits Rectangle {
    in property <length> rem-size;
    callback clicked;

    width: 2.6 * root.rem-size;
    height: 2.6 * root.rem-size;
    border-radius: self.width / 2;
    background: Theme.accent-yellow;
    border-width: 1px;
    border-color: #ffffff40;
    drop-shadow-blur: 1.3 * root.rem-size;
    drop-shadow-color: #000000e0;

    Image {
        width: 1.4 * root.rem-size;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("../icons/skip-forward.svg");
        colorize: Theme.on-accent;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
