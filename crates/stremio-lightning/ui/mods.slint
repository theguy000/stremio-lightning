// The Mods section: a menu of six pages on the left, the page on screen to its right.
//
// Plugin settings, Marketplace, Logs and About are drawn as headings only until their stages
// land; each of those stages fills in its branch of `if root.data.page == ...` and adds what its
// card needs to `ModsViewData` below. Nothing here reads a file or runs a plugin: it all arrives
// in `data`.
import { ClassStyles } from "class-styles.slint";
import { Theme } from "theme.slint";
import { ModsNavItem } from "shell.slint";
import { ScrollBar } from "scroll-bar.slint";
import { LineEdit, Slider } from "std-widgets.slint";

// One plugin or theme file, as its card draws it.
export struct ModCardData {
    /// The file name. Every button on the card names the card by it.
    id: string,
    filename: string,
    /// The metadata name, or the file name for a file that has no metadata comment.
    name: string,
    /// The author and the version, or empty when the file names neither.
    byline: string,
    description: string,
    /// What the card says when its file carries no metadata comment.
    unreadable: string,
    /// What reading the file said it does not understand: one theme warning a line.
    warnings: [string],
    /// Whether the plugin is switched on, or the theme is the one on.
    enabled: bool,
    /// Whether this card's Remove button has been pressed once and is waiting for the second
    /// press. A card in this state says so and its button reads "Confirm remove".
    armed: bool,
    /// What this page calls the on state: "enabled" for a plugin, "on" for a theme.
    state: string,
    /// What the update check found for this file: "Up to date.", "Update to 1.2.0", or a
    /// sentence about a check that could not answer. Empty until a check has answered.
    update: string,
}

// One thing the registry offers, as its card on the Marketplace page.
export struct MarketCardData {
    /// The entry's download, which is what its buttons name it by.
    id: string,
    /// "plugin" or "theme".
    kind: string,
    name: string,
    author: string,
    version: string,
    description: string,
    /// The file it is installed as, empty when it is not installed.
    filename: string,
    /// The card's one button: "install", "uninstall", or "update".
    action: string,
    /// Whether this card's Uninstall button has been pressed once and waits for the second press.
    armed: bool,
    /// Whether this card's file is being fetched right now, which turns its button into a
    /// sentence and stops every other press on it.
    installing: bool,
}

// One row of the Plugin settings page's left list.
export struct SettingsPluginData {
    /// The file name, which is what every press on the page names the plugin by.
    filename: string,
    /// The name the file gives, or the file name when it gives none.
    name: string,
    /// How many controls the plugin registered, as the row says it.
    controls: string,
    enabled: bool,
}

// One control on the Plugin settings page. The page draws the field whose `kind` it is, and no
// other: a field of a kind this app cannot draw arrives as "unsupported" and says so.
export struct SettingsFieldData {
    /// The plugin's own key for the value, which is what a press names it by.
    key: string,
    label: string,
    kind: string,
    /// What a kind this app cannot draw says it is.
    hint: string,
    /// The on state of a toggle.
    on: bool,
    /// The text of a text field, and the value a select shows.
    text: string,
    /// A select's options, one per row.
    options: [string],
    /// A slider's position, already on one of its steps.
    number: float,
    min: float,
    max: float,
    /// The small number the slider shows: the position, without a trailing zero.
    shown: string,
}

// What the window holds for the Mods section. Later stages add their fields here and fill them in
// `shell/view.rs`'s `mods_view`.
export struct ModsViewData {
    /// The id of the page on screen: "plugins", "themes", "marketplace", "settings", "logs",
    /// "about".
    page: string,
    menu: [ModsNavItem],
    /// One line about the last thing the user did. Empty when nothing has happened yet.
    notice: string,
    notice-failed: bool,
    plugins: [ModCardData],
    themes: [ModCardData],
    /// The sentence above the Plugins list that says what the switch does.
    plugins-note: string,
    /// What the Themes page says when no theme is on.
    themes-note: string,
    /// The Plugin settings page: the plugins on its left list, the one picked, and its controls.
    settings-plugins: [SettingsPluginData],
    settings-plugin: string,
    settings-fields: [SettingsFieldData],
    /// One line per thing wrong with the page as it stands: a schema that cannot be used, a file
    /// that cannot be read, values typed and not saved.
    settings-trouble: [string],
    settings-empty: string,
    /// Where the picked plugin stands: whether it runs, why it stopped, and its last warning. The
    /// page says this in the runtime's own words.
    settings-plugin-running: bool,
    /// The whole sentence: "Running.", "Stopped: ...", or empty for a plugin that is off.
    settings-state: string,
    /// Whether that sentence is bad news, which draws it in the warning colour.
    settings-state-failed: bool,
    /// Whether the page has something typed and not saved. Only this turns Save on.
    settings-dirty: bool,
    /// The Marketplace page: the sentence above its search box, the lines about the presses, the
    /// registry's plugins and themes as cards, and the line for a registry that could not be read.
    market-note: string,
    market-summary: [string],
    market-trouble: string,
    market-plugins: [MarketCardData],
    market-themes: [MarketCardData],
    market-empty: string,
    /// What the search box holds, and whether the update check is running right now.
    market-search: string,
    market-checking: bool,
    /// Whether the check found at least one installed plugin or theme a newer version, which is
    /// the only time Update all has anything to do.
    updates-ready: bool,
}

// Web: the Settings menu's `.button`, which the Mods menu borrows: a 4rem pill, dim until it is
// selected or the pointer is on it.
component ModsMenuButton inherits Rectangle {
    in property <string> label-text;
    in property <bool> selected;
    in property <length> rem-size;
    callback clicked();

    height: 4 * root.rem-size;
    border-radius: 2 * root.rem-size;
    background: (root.selected || touch.has-hover) ? ClassStyles.background-or(ClassStyles.mods-menu-button, Theme.overlay) : transparent;
    opacity: ClassStyles.opacity-or(ClassStyles.mods-menu-button, root.selected ? 1.0 : 0.4);
    visible: !ClassStyles.mods-menu-button.hidden;

    mods-menu-label := Text {
        x: 2 * root.rem-size;
        y: 0px;
        width: parent.width - 4 * root.rem-size;
        height: parent.height;
        text: root.label-text;
        overflow: elide;
        vertical-alignment: center;
        font-size: 1.1 * root.rem-size;
        font-weight: root.selected ? 600 : 500;
        color: ClassStyles.color-or(ClassStyles.mods-menu-button, Theme.text);
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        // The page's name, so a screen reader -- or a test driving the window -- can find it.
        accessible-role: button;
        accessible-label: root.label-text;
        accessible-checkable: true;
        accessible-checked: root.selected;
        clicked => {
            root.clicked();
        }
    }
}

// The switch on a card: a pill that says where it is, and moves.
component ModToggle inherits Rectangle {
    in property <bool> on;
    in property <string> name;
    in property <length> rem-size;
    callback toggled();

    width: 3.2 * root.rem-size;
    height: 1.8 * root.rem-size;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: ClassStyles.color-or(ClassStyles.mod-toggle, root.on ? Theme.accent-green : Theme.placeholder);
    background: ClassStyles.background-or(ClassStyles.mod-toggle, root.on ? Theme.accent-green : transparent);
    opacity: ClassStyles.opacity-or(ClassStyles.mod-toggle, 1.0);
    visible: !ClassStyles.mod-toggle.hidden;

    knob := Rectangle {
        x: root.on ? parent.width - self.width - 2 * root.rem-size / 14 : 2 * root.rem-size / 14;
        y: (parent.height - self.height) / 2;
        width: parent.height - 4 * root.rem-size / 14;
        height: self.width;
        border-radius: self.width / 2;
        background: root.on ? Theme.on-accent : Theme.placeholder;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // The switch is named for what pressing it will do, so a test presses the step it means.
        accessible-role: switch;
        // "Disable " + "example.plugin.js": the file name.
        accessible-label: (root.on ? "Disable " : "Enable ") + root.name;
        accessible-checkable: true;
        accessible-checked: root.on;
        clicked => {
            root.toggled();
        }
    }
}

// One Remove button. It removes nothing on its first press: it arms the card, and the second
// press is the one that deletes the file.
component ModRemoveButton inherits Rectangle {
    in property <bool> armed;
    in property <string> name;
    in property <length> rem-size;
    callback clicked();

    height: 3 * root.rem-size;
    width: remove-label.width + 2 * root.rem-size;
    border-radius: self.height / 2;
    border-width: 2px;
    border-color: root.armed ? Theme.accent-red : Theme.text;
    background: ClassStyles.background-or(ClassStyles.mod-remove-button, touch.has-hover || root.armed ? Theme.overlay : transparent);
    opacity: ClassStyles.opacity-or(ClassStyles.mod-remove-button, touch.has-hover || root.armed ? 1.0 : 0.3);
    visible: !ClassStyles.mod-remove-button.hidden;

    remove-label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        text: root.armed ? "Confirm remove" : "Remove";
        font-size: root.rem-size;
        font-weight: 700;
        color: ClassStyles.color-or(ClassStyles.mod-remove-button-label, root.armed ? Theme.accent-red : Theme.text);
        visible: !ClassStyles.mod-remove-button-label.hidden;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // Its name says which press it is, so a test presses the step it means: the first press
        // arms the card and the second removes the file.
        accessible-role: button;
        accessible-label: (root.armed ? "Confirm removing " : "Remove ") + root.name;
        clicked => {
            root.clicked();
        }
    }
}

// One pill button on the Marketplace page or above the Plugins and Themes lists: Check for
// updates, Update all, and a card's Update. It says what it does and nothing else.
// Web: the addon card's action pill (`uninstall-button-container`), borrowed as a plain button.
component MarketButton inherits Rectangle {
    in property <string> label-text;
    /// The whole name a press is found by: "Install Example", "Check for updates".
    in property <string> name;
    in property <bool> enabled;
    in property <bool> primary;
    in property <length> rem-size;
    callback clicked();

    height: 3 * rem-size;
    width: market-button-label.width + 2 * rem-size;
    border-radius: self.height / 2;
    border-width: 2px;
    border-color: (root.primary && root.enabled) ? Theme.accent-green : Theme.text;
    background: ClassStyles.background-or(ClassStyles.market-button,
        (root.enabled && root.primary) ? Theme.accent-green
        : (root.enabled && market-button-touch.has-hover) ? Theme.overlay : transparent);
    opacity: ClassStyles.opacity-or(ClassStyles.market-button, root.enabled ? 1.0 : 0.3);
    visible: !ClassStyles.market-button.hidden;

    market-button-label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        text: root.label-text;
        overflow: elide;
        font-size: root.rem-size;
        font-weight: 700;
        color: ClassStyles.color-or(ClassStyles.market-button-label,
            (root.primary && root.enabled) ? Theme.on-accent : Theme.text);
        visible: !ClassStyles.market-button-label.hidden;
    }
    market-button-touch := TouchArea {
        width: 100%;
        height: 100%;
        // A button that would do nothing is not a target.
        mouse-cursor: root.enabled ? pointer : default;
        accessible-role: button;
        accessible-label: root.name;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

// The sentence a card shows in place of its button while its file is being fetched.
component MarketProgress inherits Text {
    in property <length> rem-size;
    height: 3 * rem-size;
    text: "Installing…";
    horizontal-alignment: right;
    vertical-alignment: center;
    font-size: rem-size;
    color: ClassStyles.color-or(ClassStyles.mod-notice, Theme.text);
    opacity: ClassStyles.opacity-or(ClassStyles.mod-notice, 0.7);
    visible: !ClassStyles.mod-notice.hidden;
}

// Web: an addon card's shape, for a plugin or a theme: the name and the version on the first
// line, the description under them, the switch and Remove on the right.
component ModCardView inherits Rectangle {
    in property <ModCardData> data;
    in property <length> rem-size;
    callback toggle();
    callback remove();
    // The card's Update button, which only an update makes visible.
    callback update();
    // A press that is not the Remove button's second press: it takes back any armed card.
    callback dismiss();

    property <length> pad: 1.5 * root.rem-size;
    property <length> buttons-width: 9 * root.rem-size;
    property <length> text-width: root.width - 2 * root.pad - root.buttons-width - root.rem-size;
    // What the card says under its title block: the description, then why it has no name, then
    // one line per warning. The card grows to fit them, so no line is cut off.
    property <length> body-height: (root.data.description == "" ? 0px : 2 * root.rem-size)
        + (root.data.unreadable == "" ? 0px : 2 * root.rem-size)
        + root.data.warnings.length * 1.2 * root.rem-size;
    // The list gives every card the row's height, so this default is only what a card drawn on
    // its own would take. It stays positive whatever the data says.
    height: Math.max(10 * root.rem-size, 5.2 * root.rem-size + root.pad + root.body-height);

    mod-card := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 0.75 * root.rem-size;
        border-width: 2 * root.rem-size / 14;
        // An armed card is outlined in the warning colour, so the second press is never a press
        // on a card that looks like every other one.
        border-color: root.data.armed ? Theme.accent-red : transparent;
        background: ClassStyles.background-or(ClassStyles.mod-card, Theme.overlay);
        opacity: ClassStyles.opacity-or(ClassStyles.mod-card, 1.0);
        visible: !ClassStyles.mod-card.hidden;

        // Any press on the card body takes back an armed Remove: a person who pressed the wrong
        // card does not have to wait five seconds for the arm on it to lapse.
        body-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.dismiss();
            }
        }

        mod-title := Text {
            x: root.pad;
            y: root.pad;
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.name;
            overflow: elide;
            vertical-alignment: center;
            font-size: 1.6 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-title, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-title, 1.0);
            visible: !ClassStyles.mod-title.hidden;
        }
        mod-byline := Text {
            x: root.pad;
            y: root.pad + 2 * root.rem-size;
            width: root.text-width;
            height: 1.2 * root.rem-size;
            text: root.data.byline;
            overflow: elide;
            vertical-alignment: center;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-byline, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-byline, 0.6);
            visible: !ClassStyles.mod-byline.hidden;
        }

        mod-description := Text {
            x: root.pad;
            y: root.pad + 3.6 * root.rem-size;
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.description;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-description, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-description, 1.0);
            visible: root.data.description != "" && !ClassStyles.mod-description.hidden;
        }
        mod-unreadable := Text {
            x: root.pad;
            y: mod-description.y + (root.data.description == "" ? 0px : 2 * root.rem-size);
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.unreadable;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-warning, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-warning, 0.7);
            visible: root.data.unreadable != "" && !ClassStyles.mod-warning.hidden;
        }
        // A theme that reaches something this app has no component for says so here, before it is
        // turned on, rather than only on stderr where nobody sees it.
        for warning[index] in root.data.warnings: mod-warning := Text {
            x: root.pad;
            y: mod-unreadable.y + (root.data.unreadable == "" ? 0px : 2 * root.rem-size) + index * 1.2 * root.rem-size;
            width: root.text-width;
            height: 1.2 * root.rem-size;
            text: warning;
            overflow: elide;
            font-size: 0.9 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-warning, Theme.accent-yellow);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-warning, 1.0);
            visible: !ClassStyles.mod-warning.hidden;
        }

        mod-toggle-container := Rectangle {
            x: parent.width - root.pad - root.buttons-width;
            y: root.pad;
            width: root.buttons-width;
            height: 1.8 * root.rem-size;
            background: ClassStyles.background-or(ClassStyles.mod-toggle-container, transparent);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-toggle-container, 1.0);
            visible: !ClassStyles.mod-toggle-container.hidden;

            mod-toggle := ModToggle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                rem-size: root.rem-size;
                on: root.data.enabled;
                // The file's own name, which is what the settings file records.
                name: root.data.filename;
                toggled => {
                    root.toggle();
                }
            }
            mod-state := Text {
                x: mod-toggle.width + 0.6 * root.rem-size;
                y: 0px;
                width: parent.width - self.x;
                height: parent.height;
                text: (root.data.enabled ? "" : "Not ") + root.data.state;
                overflow: elide;
                vertical-alignment: center;
                font-size: root.rem-size;
                color: ClassStyles.color-or(ClassStyles.mod-toggle-container, root.data.enabled ? Theme.accent-green : Theme.text);
            }
        }

        // What the update check found for this file. It sits under the byline, on a card with or
        // without anything else on it, because a card that says nothing here has not been checked.
        if root.data.update != "": mod-update := Text {
            x: parent.width - root.pad - root.buttons-width - root.text-width;
            y: root.pad + 1.5 * root.rem-size;
            width: root.text-width;
            height: 1.2 * root.rem-size;
            text: root.data.update;
            overflow: elide;
            font-size: 0.9 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-update, Theme.placeholder);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-update, 1.0);
            visible: !ClassStyles.mod-update.hidden;
        }

        if root.data.armed: mod-armed-note := Text {
            x: parent.width - root.pad - root.buttons-width - root.text-width;
            y: root.pad + 2.2 * root.rem-size;
            width: root.text-width;
            height: 2.4 * root.rem-size;
            text: "Pressing Confirm remove deletes " + root.data.filename + " from this computer.";
            wrap: word-wrap;
            font-size: 0.9 * root.rem-size;
            color: Theme.accent-red;
        }

        // Update is above Remove, and only on a card the check found a newer version for. It is
        // not a destructive press: the new file replaces the old one and the switch stays as it is.
        if root.data.update.starts-with("Update to "): MarketButton {
            x: parent.width - root.pad - self.width;
            y: parent.height - root.pad - self.height - self.height - 0.6 * root.rem-size;
            rem-size: root.rem-size;
            label-text: "Update";
            name: "Update " + root.data.filename;
            enabled: true;
            primary: false;
            clicked => {
                root.update();
            }
        }
        ModRemoveButton {
            x: parent.width - root.pad - self.width;
            y: parent.height - root.pad - self.height;
            rem-size: root.rem-size;
            armed: root.data.armed;
            name: root.data.filename;
            clicked => {
                root.remove();
            }
        }
    }
}

// One row of the Plugin settings page's left list: the plugin's name, and whether it is on.
// Web: the Settings menu's rows, a pill per plugin rather than per page.
component SettingsPluginRow inherits Rectangle {
    in property <SettingsPluginData> entry;
    in property <bool> selected;
    in property <length> rem-size;
    callback clicked();

    property <length> pad: 0.8 * rem-size;
    height: 5.2 * rem-size;
    border-radius: 0.75 * rem-size;
    background: (root.selected || touch.has-hover) ? Theme.overlay : transparent;
    border-width: 2 * rem-size / 14;
    border-color: root.selected ? Theme.accent-green : transparent;

    settings-plugin-name := Text {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: 1.6 * rem-size;
        text: root.entry.name;
        overflow: elide;
        vertical-alignment: center;
        font-size: 1.1 * rem-size;
        font-weight: root.selected ? 600 : 500;
        color: Theme.text;
    }
    settings-plugin-state := Text {
        x: root.pad;
        y: root.pad + 1.8 * rem-size;
        width: parent.width - 2 * root.pad;
        height: 1.2 * rem-size;
        text: (root.entry.enabled ? "On, " : "Off, ") + root.entry.controls;
        overflow: elide;
        vertical-alignment: center;
        font-size: 0.9 * rem-size;
        color: root.entry.enabled ? Theme.accent-green : Theme.placeholder;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // The file name, so a test presses the row it means. The metadata name on the row can
        // repeat, the file name cannot.
        accessible-role: button;
        accessible-label: root.entry.filename;
        accessible-checkable: true;
        accessible-checked: root.selected;
        clicked => {
            root.clicked();
        }
    }
}

// The box a text setting is typed into. It only writes the window's own value on a press in the
// box, so a new value the app hands back does not move the cursor under anyone's typing.
component SettingsTextField inherits LineEdit {
    in property <length> rem-size;
    in property <string> label-text;
    in property <string> shown;
    callback said(string);

    font-size: 1.1 * root.rem-size;
    // The label, so a test finds the box it means to type in.
    accessible-description: root.label-text;
    // A press in the box first puts what the page holds into it: the editor is then the page's,
    // and a frame that arrives while it has focus does not overwrite what is being typed.
    init => {
        self.text = root.shown;
    }
    edited(text) => {
        root.said(text);
    }
}

// One control on the Plugin settings page, drawn as the field's kind. A press in it changes the
// value on the page; nothing is written until Save.
component SettingsFieldView inherits Rectangle {
    in property <SettingsFieldData> field;
    in property <length> rem-size;
    callback toggled(bool);
    callback typed(string);
    callback picked(string);
    callback slid(float);

    property <length> pad: 0.8 * rem-size;
    property <length> label-width: 16 * rem-size;
    property <length> control-width: Math.max(0px, root.width - root.pad - root.label-width - 2 * rem-size);
    // Where the field's own control goes: beside its label, under the first line of it.
    property <length> control-x: root.pad + root.label-width;
    property <length> control-y: root.pad + 0.2 * rem-size;

    // The row: the label, the control beside it, and the hint under the control. Every row is this
    // height, so the rows of the page's `for` line up.
    height: 6.4 * rem-size;

    settings-field-label := Text {
        x: root.pad;
        y: root.pad + 0.2 * rem-size;
        width: root.label-width - 2 * rem-size;
        height: 2 * rem-size;
        text: root.field.label;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
        font-size: 1.1 * rem-size;
        color: Theme.text;
    }
    // Every kind says what it is under its control, in one line: the range, the options, or what
    // the app makes of a kind it cannot draw. A kind it cannot draw has no control at all.
    settings-field-hint := Text {
        x: root.control-x;
        y: root.pad + 3.4 * rem-size;
        width: root.control-width;
        height: 1.2 * rem-size;
        text: root.field.hint;
        overflow: elide;
        font-size: 0.9 * rem-size;
        color: root.field.kind == "unsupported" ? Theme.accent-yellow : Theme.placeholder;
    }

    if root.field.kind == "toggle": settings-field-toggle := Rectangle {
        x: root.control-x;
        y: root.control-y;
        width: 3.2 * root.rem-size;
        height: 1.8 * root.rem-size;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: root.field.on ? Theme.accent-green : Theme.placeholder;
        background: root.field.on ? Theme.accent-green : transparent;

        knob := Rectangle {
            x: root.field.on ? parent.width - self.width - 2 * root.rem-size / 14 : 2 * root.rem-size / 14;
            y: (parent.height - self.height) / 2;
            width: parent.height - 4 * root.rem-size / 14;
            height: self.width;
            border-radius: self.width / 2;
            background: root.field.on ? Theme.on-accent : Theme.placeholder;
        }
        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            // Named for what the press will do, so a test presses the step it means.
            accessible-role: switch;
            accessible-label: (root.field.on ? "Turn off " : "Turn on ") + root.field.label;
            accessible-checkable: true;
            accessible-checked: root.field.on;
            clicked => {
                root.toggled(!root.field.on);
            }
        }
    }
    if root.field.kind == "text": settings-field-text := SettingsTextField {
        x: root.control-x;
        y: root.control-y;
        width: root.control-width;
        height: 2.4 * root.rem-size;
        rem-size: root.rem-size;
        label-text: root.field.label;
        shown: root.field.text;
        said(text) => {
            root.typed(text);
        }
    }
    if root.field.kind == "select": settings-field-select := HorizontalLayout {
        x: root.control-x;
        y: root.control-y;
        width: root.control-width;
        height: 2.4 * root.rem-size;
        spacing: 0.6 * root.rem-size;
        alignment: start;

        // One pill per option, the one the field holds marked. A select with many options wraps
        // past the row rather than being cut off: the hint under it says the whole list too.
        for option[index] in root.field.options: option-pill := Rectangle {
            width: option-label.width + 1.6 * root.rem-size;
            height: parent.height;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: option == root.field.text ? Theme.accent-green : Theme.placeholder;
            background: (option == root.field.text || option-touch.has-hover) ? Theme.overlay : transparent;

            option-label := Text {
                x: 0.8 * root.rem-size;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                text: option;
                font-size: root.rem-size;
                color: option == root.field.text ? Theme.accent-green : Theme.text;
            }
            option-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                // The field's key and the option, so a test presses the option it means.
                accessible-role: radio-button;
                accessible-label: root.field.label + ": " + option;
                accessible-checkable: true;
                accessible-checked: option == root.field.text;
                clicked => {
                    root.picked(option);
                }
            }
        }
    }
    if root.field.kind == "range": settings-field-range := Slider {
        x: root.control-x;
        y: root.control-y;
        width: root.control-width - 8 * root.rem-size;
        height: 2.4 * root.rem-size;
        minimum: root.field.min;
        maximum: root.field.max > root.field.min ? root.field.max : root.field.min + 1;
        value: root.field.number;
        // The label, so a test finds the slider it means.
        accessible-description: root.field.label;
        changed(value) => {
            root.slid(value);
        }
    }
    if root.field.kind == "range": settings-field-number := Text {
        x: root.control-x + parent.width - 8 * root.rem-size;
        y: root.control-y;
        width: 7 * root.rem-size;
        height: 2.4 * root.rem-size;
        text: root.field.shown;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: root.rem-size;
        color: Theme.text;
    }
}

// A pill button on the Plugin settings page. Save and Revert are the page's only two, drawn the
// same way so neither is the one a person presses by mistake.
component SettingsButton inherits Rectangle {
    in property <string> label-text;
    in property <bool> enabled;
    in property <bool> primary;
    in property <string> name;
    in property <length> rem-size;
    callback clicked();

    height: 3 * rem-size;
    width: settings-button-label.width + 2 * rem-size;
    border-radius: self.height / 2;
    border-width: 2px;
    border-color: root.primary && root.enabled ? Theme.accent-green : Theme.text;
    background: (root.enabled && root.primary) ? Theme.accent-green
        : (root.enabled && settings-button-touch.has-hover) ? Theme.overlay : transparent;
    opacity: root.enabled ? 1.0 : 0.3;

    settings-button-label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        text: root.label-text;
        font-size: rem-size;
        font-weight: 700;
        color: root.primary && root.enabled ? Theme.on-accent : Theme.text;
    }
    settings-button-touch := TouchArea {
        width: 100%;
        height: 100%;
        // A button that would do nothing is not a target: it says so and presses do not reach it.
        mouse-cursor: root.enabled ? pointer : default;
        accessible-role: button;
        accessible-label: root.name;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

// One thing the registry offers: its name and version, its author, its description, and one button
// on the right that says Install, Uninstall, or Update.
// Web: the addon card's shape again, `addon` and its text block.
component MarketCardView inherits Rectangle {
    in property <MarketCardData> data;
    in property <length> rem-size;
    callback pressed();
    callback dismiss();

    property <length> pad: 1.5 * root.rem-size;
    property <length> buttons-width: 10 * root.rem-size;
    property <length> text-width: root.width - 2 * root.pad - root.buttons-width - root.rem-size;
    height: Math.max(10 * root.rem-size, 5.2 * root.rem-size + root.pad + (root.data.description == "" ? 0px : 2 * root.rem-size));

    market-card := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 0.75 * root.rem-size;
        border-width: 2 * root.rem-size / 14;
        // An armed card is outlined in the warning colour: its second press deletes a file.
        border-color: root.data.armed ? Theme.accent-red : transparent;
        background: ClassStyles.background-or(ClassStyles.market-card, Theme.overlay);
        opacity: ClassStyles.opacity-or(ClassStyles.market-card, 1.0);
        visible: !ClassStyles.market-card.hidden;

        body-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.dismiss();
            }
        }

        market-title := Text {
            x: root.pad;
            y: root.pad;
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.name;
            overflow: elide;
            vertical-alignment: center;
            font-size: 1.6 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.market-title, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.market-title, 1.0);
            visible: !ClassStyles.market-title.hidden;
        }
        market-byline := Text {
            x: root.pad;
            y: root.pad + 2 * root.rem-size;
            width: root.text-width;
            height: 1.2 * root.rem-size;
            // The author and the version the registry gives it.
            text: root.data.author + " v" + root.data.version;
            overflow: elide;
            vertical-alignment: center;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.market-byline, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.market-byline, 0.6);
            visible: !ClassStyles.market-byline.hidden;
        }
        market-description := Text {
            x: root.pad;
            y: root.pad + 3.6 * root.rem-size;
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.description;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.market-description, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.market-description, 1.0);
            visible: root.data.description != "" && !ClassStyles.market-description.hidden;
        }
        // What the second press will delete, in the same words the Plugins and Themes cards use.
        if root.data.armed: market-armed-note := Text {
            x: parent.width - root.pad - root.buttons-width - root.text-width;
            y: root.pad + 2.2 * root.rem-size;
            width: root.text-width;
            height: 2.4 * root.rem-size;
            text: "Pressing Confirm uninstall deletes " + root.data.filename + " from this computer.";
            wrap: word-wrap;
            font-size: 0.9 * root.rem-size;
            color: Theme.accent-red;
        }

        if root.data.installing: MarketProgress {
            x: parent.width - root.pad - self.width;
            y: parent.height - root.pad - self.height;
            rem-size: root.rem-size;
        }
        if !root.data.installing: MarketButton {
            x: parent.width - root.pad - self.width;
            y: parent.height - root.pad - self.height;
            rem-size: root.rem-size;
            // The button says what it is when it is ready: uninstalling is two presses, so its
            // second step is the one that says Confirm.
            label-text: root.data.action == "uninstall" ? (root.data.armed ? "Confirm uninstall" : "Uninstall")
                : root.data.action == "update" ? "Install update" : "Install";
            // Every press of the one button is an Install: of a mod already installed, of a newer
            // version, or of a mod that is not here yet. Only Uninstall is a different press.
            name: (root.data.action == "uninstall" ? (root.data.armed ? "Confirm uninstalling " : "Uninstall ") : "Install ") + root.data.name + " (" + root.data.version + ")";
            enabled: true;
            primary: root.data.action == "install";
            clicked => {
                root.pressed();
            }
        }
    }
}

export component ModsContent inherits Rectangle {    // The height every card on a page takes: the tallest card the page has to draw, so the list's
    // row pitch matches what each card draws.
    pure function tallest(cards: [ModCardData], rem-size: length) -> length {
        return Math.max(10 * rem-size, cards.length == 0 ? 0px : 5.2 * rem-size + 1.5 * rem-size
            + (cards[0].description == "" ? 0px : 2 * rem-size)
            + (cards[0].unreadable == "" ? 0px : 2 * rem-size)
            + cards[0].warnings.length * 1.2 * rem-size);
    }

    in property <ModsViewData> data;
    /// The width of the window, which decides one rem.
    in property <length> viewport-width;

    // Pick a page of the menu.
    callback select-page(string);
    // A card's switch, naming the file and the state the switch asks for. One pair of callbacks
    // for both pages: which list a file belongs to is the page's business, not the window's.
    callback toggle-mod(string, bool);
    // A card's Remove button. The first press of a card arms it and removes nothing; the second
    // press of the same card removes the file.
    callback remove-mod(string);
    /// Any other press on a card, which takes back an armed Remove.
    callback dismiss-remove();
    /// The Plugin settings page's left list, naming the file picked. Empty means nothing is
    /// picked.
    callback pick-settings-plugin(string);
    /// A press in one control: the plugin's key for the value, and the value it now holds. One
    /// callback per kind of control, because a toggle's on state, a text's string and a slider's
    /// number are three kinds of value.
    callback edit-settings-toggle(string, bool);
    callback edit-settings-text(string, string);
    callback edit-settings-number(string, float);
    /// The Save press: what the page holds goes into the plugin's settings file.
    callback save-settings();
    /// The Revert press: what is typed goes back to what the file holds.
    callback revert-settings();
    /// A press in the Marketplace's search box: the text it now holds.
    callback search-market(string);
    /// A Marketplace card's one button, naming the entry by its download. An installed card's
    /// Uninstall arms on the first press and removes on the second; every other press is the
    /// install it says.
    callback install-market(string);
    /// A press on Update on a Plugin or Theme card, naming the file.
    callback update-mod(string);
    /// Update all on the Plugins or Themes page, and Check for updates, which checks both pages.
    callback update-all-mods();
    callback check-mods-updates();
    /// Any other press on a Marketplace card, which takes back an armed Uninstall.
    callback dismiss-market();

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <length> menu-width: 18 * root.rem-size;
    property <length> page-padding: 3 * root.rem-size;
    property <length> page-width: root.width - root.menu-width - 2 * root.page-padding;
    property <length> page-top: 2 * root.rem-size + (root.data.notice == "" ? 0px : 3.4 * root.rem-size);
    property <length> list-top: root.page-top + 6 * root.rem-size;
    property <length> list-height: Math.max(root.height - root.list-top, 0px);
    // A card plus the 0.75rem under it. Every card is the height of the tallest one on screen,
    // because a `for` row cannot ask its neighbours how tall they are.
    property <length> card-height: root.on-plugins ? tallest(root.data.plugins, root.rem-size)
        : root.on-themes ? tallest(root.data.themes, root.rem-size) : 10 * root.rem-size;
    property <length> card-pitch: root.card-height + 0.75 * root.rem-size;

    property <bool> on-plugins: root.data.page == "plugins";
    property <bool> on-themes: root.data.page == "themes";
    property <bool> on-market: root.data.page == "marketplace";
    property <bool> on-settings: root.data.page == "settings";
    // The lines a press left on the Marketplace page, and the line for a registry that could not
    // be read: one row each, so the list starts below all of them.
    property <length> market-lines-height: root.data.market-summary.length * 1.4 * root.rem-size
        + (root.data.market-trouble == "" ? 0px : 2.4 * root.rem-size);
    // The left list of the Plugin settings page: a column 18rem wide beside the page's controls.
    property <length> choice-width: 18 * root.rem-size;
    property <length> fields-width: Math.max(0px, root.page-width - root.choice-width - 2 * root.rem-size);

    mods-menu-container := Rectangle {
        x: 0px;
        y: 0px;
        width: root.menu-width;
        height: root.height;
        background: ClassStyles.background-or(ClassStyles.mods-menu-container, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-menu-container, 1.0);
        visible: !ClassStyles.mods-menu-container.hidden;

        for item[index] in root.data.menu: ModsMenuButton {
            x: 1.5 * root.rem-size;
            y: 3 * root.rem-size + index * 4.5 * root.rem-size;
            width: 15 * root.rem-size;
            rem-size: root.rem-size;
            label-text: item.label;
            // Derived from the page on screen rather than taken from the row: the menu itself only
            // changes when a page is picked, and rebuilding it under a press would take the row
            // the press was made on out from under it.
            selected: item.id == root.data.page;
            clicked => {
                root.select-page(item.id);
            }
        }
    }

    mods-content := Rectangle {
        x: root.menu-width;
        y: 0px;
        width: root.width - root.menu-width;
        height: root.height;
        background: ClassStyles.background-or(ClassStyles.mods-content, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-content, 1.0);
        visible: !ClassStyles.mods-content.hidden;

        // The page's name, and the line about the last action under it.
        mods-page-title := Text {
            x: root.page-padding;
            y: 2 * root.rem-size;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: root.on-plugins ? "Plugins"
                : root.on-themes ? "Themes"
                : root.data.page == "marketplace" ? "Marketplace"
                : root.data.page == "settings" ? "Plugin settings"
                : root.data.page == "logs" ? "Logs" : "About";
            vertical-alignment: center;
            font-size: 2.2 * root.rem-size;
            font-weight: 700;
            color: ClassStyles.color-or(ClassStyles.mods-page-title, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-page-title, 1.0);
            visible: !ClassStyles.mods-page-title.hidden;
        }

        if root.data.notice != "": mod-notice := Text {
            x: root.page-padding;
            y: 5.4 * root.rem-size;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: root.data.notice;
            wrap: word-wrap;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-notice, root.data.notice-failed ? Theme.accent-red : Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-notice, root.data.notice-failed ? 1.0 : 0.7);
            visible: !ClassStyles.mod-notice.hidden;
        }

        // One sentence per page above its list: what the switch does on Plugins, and that the app
        // is drawing its own colours when no theme is on.
        mods-page-note := Text {
            x: root.page-padding;
            y: root.page-top;
            width: root.page-width;
            height: 4 * root.rem-size;
            text: root.on-plugins ? root.data.plugins-note
                : root.on-themes ? root.data.themes-note
                : root.on-market ? root.data.market-note
                : root.data.page == "settings" ? "Pick a plugin on the left. Its settings are saved only when you press Save."
                : root.data.page == "logs" ? "The Logs page arrives in a later release."
                : "The About page arrives in a later release.";
            wrap: word-wrap;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-page-note, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-page-note, 0.7);
            visible: !ClassStyles.mods-page-note.hidden;
        }

        if root.on-plugins && root.data.plugins.length == 0: mods-empty-plugins := Text {
            x: root.page-padding;
            y: root.list-top;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: "No plugins are installed.";
            font-size: 1.4 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-empty, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-empty, 0.8);
            visible: !ClassStyles.mods-empty.hidden;
        }
        if root.on-themes && root.data.themes.length == 0: mods-empty-themes := Text {
            x: root.page-padding;
            y: root.list-top;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: "No themes are installed.";
            font-size: 1.4 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-empty, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-empty, 0.8);
            visible: !ClassStyles.mods-empty.hidden;
        }

        mods-list := Flickable {
            x: 0px;
            y: root.list-top;
            width: parent.width;
            height: root.list-height;
            content-width: self.width;
            content-height: (root.on-plugins ? root.data.plugins.length : root.on-themes ? root.data.themes.length : 0) * root.card-pitch;

            // One `for` per page, each drawn only while its page is the one on screen -- the same
            // shape the addons list uses. A `for` cannot follow an `if` directly, so the row is
            // written out twice rather than held in a container: a container's own origin is not
            // the list's, and its rows end up drawn above the list instead of inside it.
            for entry[index] in root.data.plugins: ModCardView {
                x: root.page-padding;
                y: index * root.card-pitch;
                width: root.page-width - 8px;
                rem-size: root.rem-size;
                // Every card is the row's height: a card is never shorter than the tallest.
                height: root.card-height;
                visible: root.on-plugins;
                data: entry;
                toggle => {
                    root.toggle-mod(entry.filename, !entry.enabled);
                }
                remove => {
                    root.remove-mod(entry.filename);
                }
                update => {
                    root.update-mod(entry.filename);
                }
                dismiss => {
                    root.dismiss-remove();
                }
            }
            for entry[index] in root.data.themes: ModCardView {
                x: root.page-padding;
                y: index * root.card-pitch;
                width: root.page-width - 8px;
                rem-size: root.rem-size;
                height: root.card-height;
                visible: root.on-themes;
                data: entry;
                toggle => {
                    root.toggle-mod(entry.filename, !entry.enabled);
                }
                remove => {
                    root.remove-mod(entry.filename);
                }
                update => {
                    root.update-mod(entry.filename);
                }
                dismiss => {
                    root.dismiss-remove();
                }
            }
        }

        ScrollBar {
            x: parent.width - 8px;
            y: root.list-top;
            height: root.list-height;
            view-height: root.list-height;
            content-height: mods-list.content-height;
            offset <=> mods-list.content-y;
            visible: root.on-plugins || root.on-themes;
        }

        // ---- Marketplace ----------------------------------------------------------------
        // The registry's plugins and themes as two lists with one search box above them, and Check
        // for updates in the corner. Every press here is one the shell turns into a fetch and a
        // write; the page itself says what happened, one sentence a line.
        if root.on-market: market-search := LineEdit {
            x: root.page-padding;
            y: root.list-top;
            width: Math.min(root.page-width - 12 * root.rem-size, 28 * root.rem-size);
            height: 3 * root.rem-size;
            font-size: 1.1 * root.rem-size;
            placeholder-text: "Search the registry";
            accessible-description: "Search the registry";
            init => {
                self.text = root.data.market-search;
            }
            edited(text) => {
                root.search-market(text);
            }
        }
        if root.on-market: MarketButton {
            x: parent.width - root.page-padding - self.width;
            y: root.list-top;
            rem-size: root.rem-size;
            label-text: root.data.market-checking ? "Checking…" : "Check for updates";
            name: "Check for updates";
            enabled: !root.data.market-checking;
            primary: false;
            clicked => {
                root.check-mods-updates();
            }
        }
        if root.on-market: market-lines := Rectangle {
            x: root.page-padding;
            y: root.list-top + 3.6 * root.rem-size;
            width: root.page-width;
            height: root.market-lines-height;
            background: transparent;

            if root.data.market-trouble != "": market-trouble := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 2.4 * root.rem-size;
                text: root.data.market-trouble;
                wrap: word-wrap;
                vertical-alignment: top;
                font-size: root.rem-size;
                color: ClassStyles.color-or(ClassStyles.mod-notice, Theme.accent-red);
                opacity: ClassStyles.opacity-or(ClassStyles.mod-notice, 1.0);
                visible: !ClassStyles.mod-notice.hidden;
            }
            for line[index] in root.data.market-summary: market-summary-line := Text {
                x: 0px;
                y: (root.data.market-trouble == "" ? 0px : 2.4 * root.rem-size) + index * 1.4 * root.rem-size;
                width: parent.width;
                height: 1.4 * root.rem-size;
                text: line;
                overflow: elide;
                font-size: root.rem-size;
                color: ClassStyles.color-or(ClassStyles.mod-notice, Theme.text);
                opacity: ClassStyles.opacity-or(ClassStyles.mod-notice, 0.8);
                visible: !ClassStyles.mod-notice.hidden;
            }
        }
        // One heading per kind, then its cards. The list is one Flickable so a search that leaves
        // both kinds full scrolls as one page; a card's height is the tallest one the page draws.
        if root.on-market: market-list-view := Flickable {
            x: 0px;
            y: root.list-top + 3.6 * root.rem-size + root.market-lines-height + 0.6 * root.rem-size;
            width: parent.width;
            height: Math.max(root.height - self.y, 0px);
            content-width: self.width;
            content-height: 4.4 * root.rem-size + root.data.market-plugins.length * root.card-pitch
                + 4.4 * root.rem-size + root.data.market-themes.length * root.card-pitch;

            market-plugins-heading := Text {
                x: root.page-padding;
                y: 0px;
                width: root.page-width;
                height: 2.6 * root.rem-size;
                text: "Plugins";
                vertical-alignment: center;
                font-size: 1.4 * root.rem-size;
                font-weight: 700;
                color: ClassStyles.color-or(ClassStyles.market-heading, Theme.text);
                opacity: ClassStyles.opacity-or(ClassStyles.market-heading, 1.0);
                visible: !ClassStyles.market-heading.hidden;
            }
            for entry[index] in root.data.market-plugins: MarketCardView {
                x: root.page-padding;
                y: 3 * root.rem-size + index * root.card-pitch;
                width: root.page-width - 8px;
                rem-size: root.rem-size;
                height: root.card-height;
                data: entry;
                pressed => {
                    root.install-market(entry.id);
                }
                dismiss => {
                    root.dismiss-market();
                }
            }
            market-themes-heading := Text {
                x: root.page-padding;
                y: 3 * root.rem-size + root.data.market-plugins.length * root.card-pitch + 1 * root.rem-size;
                width: root.page-width;
                height: 2.6 * root.rem-size;
                text: "Themes";
                vertical-alignment: center;
                font-size: 1.4 * root.rem-size;
                font-weight: 700;
                color: ClassStyles.color-or(ClassStyles.market-heading, Theme.text);
                opacity: ClassStyles.opacity-or(ClassStyles.market-heading, 1.0);
                visible: !ClassStyles.market-heading.hidden;
            }
            for entry[index] in root.data.market-themes: MarketCardView {
                x: root.page-padding;
                y: 3 * root.rem-size + root.data.market-plugins.length * root.card-pitch + 4 * root.rem-size + index * root.card-pitch;
                width: root.page-width - 8px;
                rem-size: root.rem-size;
                height: root.card-height;
                data: entry;
                pressed => {
                    root.install-market(entry.id);
                }
                dismiss => {
                    root.dismiss-market();
                }
            }
        }
        if root.on-market && root.data.market-empty != "": market-empty := Text {
            x: root.page-padding;
            y: root.list-top + 4.8 * root.rem-size + root.market-lines-height;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: root.data.market-empty;
            wrap: word-wrap;
            font-size: 1.4 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-empty, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-empty, 0.8);
            visible: !ClassStyles.mods-empty.hidden;
        }
        // Update all sits above the Plugins and Themes lists, on the right, beside the sentence
        // that says what the check found. It is drawn only once a check has answered: before that
        // there is nothing to update.
        if (root.on-plugins || root.on-themes) && root.data.updates-ready: MarketButton {
            x: parent.width - root.page-padding - self.width;
            y: root.page-top + 0.4 * root.rem-size;
            rem-size: root.rem-size;
            label-text: "Update all";
            name: "Update all";
            enabled: true;
            primary: false;
            clicked => {
                root.update-all-mods();
            }
        }

        // ---- Plugin settings ------------------------------------------------------------
        // The installed plugins on the left, the picked one's schema on the right. The page only
        // edits: Save writes the plugin's settings file, Revert reads it back, and nothing here
        // deletes a value or the schema itself.
        if root.on-settings: settings-choice := Flickable {
            x: root.page-padding;
            y: root.list-top;
            width: root.choice-width;
            height: root.list-height;
            content-width: self.width;
            content-height: root.data.settings-plugins.length * 5.95 * root.rem-size;

            for entry[index] in root.data.settings-plugins: SettingsPluginRow {
                x: 0px;
                y: index * 5.95 * root.rem-size;
                width: settings-choice.width - 8px;
                rem-size: root.rem-size;
                entry: entry;
                selected: entry.filename == root.data.settings-plugin;
                clicked => {
                    root.pick-settings-plugin(entry.filename);
                }
            }
        }
        if root.on-settings && root.data.settings-plugins.length == 0: settings-empty := Text {
            x: root.page-padding;
            y: root.list-top;
            width: root.choice-width;
            height: 3 * root.rem-size;
            text: "No plugins are installed.";
            font-size: 1.1 * root.rem-size;
            color: Theme.text;
            opacity: 0.8;
        }

        if root.on-settings: Rectangle {
            x: root.page-padding + root.choice-width + 2 * root.rem-size;
            y: root.list-top;
            width: root.fields-width;
            height: root.list-height;

            settings-fields := Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                // The picked plugin's name and state, then what is wrong with the page, then Save and
                // Revert, then one row per control.
                content-height: settings-name.height + (settings-state.text == "" ? 0px : 2.4 * root.rem-size)
                    + 2 * 1.2 * root.rem-size + 4 * root.rem-size
                    + root.data.settings-fields.length * (6.4 * root.rem-size + 0.75 * root.rem-size);

                settings-name := Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 8px;
                    height: 3 * root.rem-size;
                    text: root.data.settings-plugin;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: 1.6 * root.rem-size;
                    font-weight: 700;
                    color: Theme.text;
                }
                settings-state := Text {
                    x: 0px;
                    y: settings-name.height;
                    width: parent.width - 8px;
                    height: 2.4 * root.rem-size;
                    // Running, why it stopped, or nothing at all for a plugin that is off: the
                    // runtime's own sentence, never this page's guess.
                    text: root.data.settings-state;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    font-size: root.rem-size;
                    color: root.data.settings-state-failed ? Theme.accent-red : Theme.accent-green;
                }
                // What is wrong with the page: a schema this app cannot use, a file it cannot read,
                // values typed and not saved. Save is still on while values are typed.
                for trouble[index] in root.data.settings-trouble: settings-trouble := Text {
                    x: 0px;
                    y: settings-name.height + (settings-state.text == "" ? 0px : 2.4 * root.rem-size) + index * 1.2 * root.rem-size;
                    width: parent.width - 8px;
                    height: 1.2 * root.rem-size;
                    text: trouble;
                    overflow: elide;
                    font-size: 0.9 * root.rem-size;
                    color: Theme.accent-red;
                }
                settings-buttons := HorizontalLayout {
                    x: 0px;
                    y: settings-name.height + (settings-state.text == "" ? 0px : 2.4 * root.rem-size)
                        + 2 * 1.2 * root.rem-size;
                    width: parent.width - 8px;
                    height: 3 * root.rem-size;
                    spacing: 1.2 * root.rem-size;
                    alignment: start;

                    SettingsButton {
                        rem-size: root.rem-size;
                        label-text: "Save";
                        name: "Save " + root.data.settings-plugin;
                        primary: true;
                        enabled: root.data.settings-dirty;
                        clicked => {
                            root.save-settings();
                        }
                    }
                    SettingsButton {
                        rem-size: root.rem-size;
                        label-text: "Revert";
                        name: "Revert " + root.data.settings-plugin;
                        primary: false;
                        enabled: root.data.settings-dirty;
                        clicked => {
                            root.revert-settings();
                        }
                    }
                }
                for field[index] in root.data.settings-fields: SettingsFieldView {
                    x: 0px;
                    y: settings-buttons.y + settings-buttons.height + index * (6.4 * root.rem-size + 0.75 * root.rem-size);
                    width: parent.width - 8px;
                    rem-size: root.rem-size;
                    field: field;
                    toggled(value) => {
                        root.edit-settings-toggle(field.key, value);
                    }
                    typed(text) => {
                        root.edit-settings-text(field.key, text);
                    }
                    picked(option) => {
                        root.edit-settings-text(field.key, option);
                    }
                    slid(value) => {
                        root.edit-settings-number(field.key, value);
                    }
                }
                if root.data.settings-empty != "": settings-said := Text {
                    x: 0px;
                    y: settings-buttons.y + settings-buttons.height;
                    width: parent.width - 8px;
                    height: 3 * root.rem-size;
                    text: root.data.settings-empty;
                    wrap: word-wrap;
                    font-size: root.rem-size;
                    color: Theme.text;
                    opacity: 0.7;
                }
            }
            ScrollBar {
                x: parent.width - 8px;
                y: 0px;
                height: parent.height;
                view-height: parent.height;
                content-height: settings-fields.content-height;
                offset <=> settings-fields.content-y;
            }
        }
    }
}
