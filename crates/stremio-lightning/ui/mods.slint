// The Mods section: a menu of four pages on the left, the page on screen to its right.
import { ClassStyles } from "class-styles.slint";
import { Theme } from "theme.slint";
import { ModsNavItem } from "shell.slint";
import { ScrollBar } from "scroll-bar.slint";
import { LineEdit, Slider, VerticalBox } from "std-widgets.slint";
import { MultiselectMenu, SelectOption } from "multiselect-menu.slint";

// One plugin or theme file, as its card draws it.
export struct ModCardData {
    /// The file name. Every button on the card names the card by it.
    id: string,
    filename: string,
    /// The metadata name, or the file name for a file that has no metadata comment.
    name: string,
    /// The author and the version, or empty when the file names neither.
    byline: string,
    description: string,
    /// What the card says when its file carries no metadata comment.
    unreadable: string,
    /// What reading the file said it does not understand: one theme warning a line.
    warnings: [string],
    /// Whether the plugin is switched on, or the theme is the one on.
    enabled: bool,
    /// Whether this card's Remove button has been pressed once and is waiting for the second
    /// press. A card in this state says so and its button reads "Confirm remove".
    armed: bool,
    /// What this page calls the on state: "enabled" for a plugin, "on" for a theme.
    state: string,
    /// Whether the card draws Remove. A feature built into the app has no file to remove.
    removable: bool,
    /// Whether the card draws a settings button: true for a plugin that declares settings.
    has-settings: bool,
}

export struct SettingsPluginData {
    /// The file name, which is what every press on the page names the plugin by.
    filename: string,
    /// The name the file gives, or the file name when it gives none.
    name: string,
    /// How many controls the plugin registered, as the row says it.
    controls: string,
    enabled: bool,
}

// One control on the Plugin settings page. The page draws the field whose `kind` it is, and no
// other: a field of a kind this app cannot draw arrives as "unsupported" and says so.
export struct SettingsFieldData {
    /// The plugin's own key for the value, which is what a press names it by.
    key: string,
    label: string,
    kind: string,
    /// What a kind this app cannot draw says it is.
    hint: string,
    /// The on state of a toggle.
    on: bool,
    /// The text of a text field, and the value a select shows.
    text: string,
    /// A select's options, one per row.
    options: [string],
    /// A slider's position, already on one of its steps.
    number: float,
    min: float,
    max: float,
    /// The small number the slider shows: the position, without a trailing zero.
    shown: string,
}

// One record on the Logs page. `id` is what a press on the row names it by.
export struct ModsLogRow {
    id: int,
    /// The source column: "Plugin builtin:aniskip", "Theme red.theme.css", "Server".
    source: string,
    /// The level as a word: "Error", "Warning", "Info", "Debug".
    level: string,
    /// The level as the filter names it, so a row can be drawn as bad news or not.
    level-id: string,
    time: string,
    /// The record's text on one line. The full text is the detail.
    text: string,
    /// Whether this record is part of the active selection.
    selected: bool,
}

// One label and its value on the About page.
export struct ModsAboutLine {
    label: string,
    value: string,
}

// What the window holds for the Mods section. Later stages add their fields here and fill them in
// `shell/view.rs`'s `mods_view`.
export struct ModsViewData {
    /// The id of the page on screen: "plugins", "themes", "settings", "logs", "about".
    page: string,
    menu: [ModsNavItem],
    /// One line about the last thing the user did. Empty when nothing has happened yet.
    notice: string,
    notice-failed: bool,
    plugins: [ModCardData],
    themes: [ModCardData],
    /// What the Themes page says above its list.
    themes-note: string,
    /// The Plugin settings page: the one picked, the name its card shows, and its controls.
    settings-plugins: [SettingsPluginData],
    settings-plugin: string,
    /// What the page's title says: the picked plugin's name.
    settings-title: string,
    settings-fields: [SettingsFieldData],
    /// One line per thing wrong with the page as it stands.
    settings-trouble: [string],
    settings-empty: string,
    /// Whether the page has something typed and not saved. Only this turns Save on.
    settings-dirty: bool,
    /// The Logs page: each filter menu's choices and the row it opens on, what the search box
    /// holds, the rows, and the full text of the one record that is open.
    log-source-options: [SelectOption],
    log-level-options: [SelectOption],
    log-source-index: int,
    log-level-index: int,
    log-search: string,
    log-rows: [ModsLogRow],
    log-empty: string,
    /// The heading of the record on screen, the lines of its text, and the id the list marks.
    log-detail-heading: string,
    log-detail: [string],
    log-open-id: int,
    /// Visible row index of `log-open-id`, or -1 when none is open.
    log-active-index: int,
    /// How many visible rows are currently selected.
    log-selected-count: int,
    /// Compact record count badge ("42 records", "5 of 42", or empty when none).
    log-count: string,
    /// Whether any source, level, or search filter is narrowing the list.
    log-filtered: bool,
    /// Number of live records prepended at the top on the latest update, plus a monotonic token
    /// so the view can anchor scroll only when live rows land while scrolled down.
    log-prepended: int,
    log-prepend-seq: int,
    /// Whether Clear has been pressed once and the second press is the one that empties the list.
    log-clear-armed: bool,
    /// The About page: the build, the places, the counts, the enabled lists, the licence, and the
    /// path of the diagnostics file written last.
    about-build: [ModsAboutLine],
    about-places: [ModsAboutLine],
    about-counts: [ModsAboutLine],
    about-enabled: [ModsAboutLine],
    about-license: string,
    about-export: string,
}

// Left-hand Mods navigation pill, dim until selected or hovered.
component ModsMenuButton inherits Rectangle {
    in property <string> label-text;
    in property <bool> selected;
    in property <length> rem-size;
    callback clicked();

    height: 3.2 * root.rem-size;
    border-radius: self.height / 2;
    background: (root.selected || touch.has-hover) ? ClassStyles.background-or(ClassStyles.mods-menu-button, Theme.overlay) : transparent;
    opacity: ClassStyles.opacity-or(ClassStyles.mods-menu-button, root.selected ? 1.0 : 0.4);
    visible: !ClassStyles.mods-menu-button.hidden;

    mods-menu-label := Text {
        x: 1.6 * root.rem-size;
        y: 0px;
        width: parent.width - 3.2 * root.rem-size;
        height: parent.height;
        text: root.label-text;
        overflow: elide;
        vertical-alignment: center;
        font-size: 1.05 * root.rem-size;
        font-weight: root.selected ? 600 : 500;
        color: ClassStyles.color-or(ClassStyles.mods-menu-button, Theme.text);
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        // The page's name, so a screen reader -- or a test driving the window -- can find it.
        accessible-role: button;
        accessible-label: root.label-text;
        accessible-checkable: true;
        accessible-checked: root.selected;
        clicked => {
            root.clicked();
        }
    }
}

// The switch on a card: a pill that says where it is, and moves.
component ModToggle inherits Rectangle {
    in property <bool> on;
    in property <string> name;
    in property <length> rem-size;
    callback toggled();

    width: 3.2 * root.rem-size;
    height: 1.8 * root.rem-size;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: ClassStyles.color-or(ClassStyles.mod-toggle, root.on ? Theme.accent-green : Theme.placeholder);
    background: ClassStyles.background-or(ClassStyles.mod-toggle, root.on ? Theme.accent-green : transparent);
    opacity: ClassStyles.opacity-or(ClassStyles.mod-toggle, 1.0);
    visible: !ClassStyles.mod-toggle.hidden;

    knob := Rectangle {
        x: root.on ? parent.width - self.width - 2 * root.rem-size / 14 : 2 * root.rem-size / 14;
        y: (parent.height - self.height) / 2;
        width: parent.height - 4 * root.rem-size / 14;
        height: self.width;
        border-radius: self.width / 2;
        // The knob is white in both positions: the track alone says which state the switch is in.
        background: Theme.text;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // The switch is named for what pressing it will do, so a test presses the step it means.
        accessible-role: switch;
        // "Disable " + name: the built-in plugin name or theme file name.
        accessible-label: (root.on ? "Disable " : "Enable ") + root.name;
        accessible-checkable: true;
        accessible-checked: root.on;
        clicked => {
            root.toggled();
        }
    }
}

// One Remove button. It removes nothing on its first press: it arms the card, and the second
// press is the one that deletes the file.
component ModRemoveButton inherits Rectangle {
    in property <bool> armed;
    in property <string> name;
    in property <length> rem-size;
    callback clicked();

    height: 3 * root.rem-size;
    width: remove-label.width + 2 * root.rem-size;
    border-radius: self.height / 2;
    border-width: 2px;
    border-color: root.armed ? Theme.accent-red : Theme.text;
    background: ClassStyles.background-or(ClassStyles.mod-remove-button, touch.has-hover || root.armed ? Theme.overlay : transparent);
    opacity: ClassStyles.opacity-or(ClassStyles.mod-remove-button, touch.has-hover || root.armed ? 1.0 : 0.3);
    visible: !ClassStyles.mod-remove-button.hidden;

    remove-label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        text: root.armed ? "Confirm remove" : "Remove";
        font-size: root.rem-size;
        font-weight: 700;
        color: ClassStyles.color-or(ClassStyles.mod-remove-button-label, root.armed ? Theme.accent-red : Theme.text);
        visible: !ClassStyles.mod-remove-button-label.hidden;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        // Its name says which press it is, so a test presses the step it means: the first press
        // arms the card and the second removes the file.
        accessible-role: button;
        accessible-label: (root.armed ? "Confirm removing " : "Remove ") + root.name;
        clicked => {
            root.clicked();
        }
    }
}

// A card's settings button: the gear that opens a plugin's settings page in place of the list.
component ModSettingsButton inherits Rectangle {
    in property <string> name;
    in property <length> rem-size;
    callback clicked();

    width: 3 * root.rem-size;
    height: 3 * root.rem-size;
    border-radius: self.width / 2;
    // A disc behind the gear, so the button reads as a control of the page rather than an icon
    // that happens to be on the card.
    background: touch.has-hover ? #ffffff24 : #ffffff14;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1.4 * root.rem-size;
        height: 1.4 * root.rem-size;
        source: @image-url("icons/settings.svg");
        colorize: Theme.text;
        opacity: touch.has-hover ? 1.0 : 0.7;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Settings for " + root.name;
        clicked => {
            root.clicked();
        }
    }
}

// Web: an addon card's shape, for a plugin or a theme: the name and the version on the first
// line, the description under them, the switch and Remove on the right.
component ModCardView inherits Rectangle {
    in property <ModCardData> data;
    in property <length> rem-size;
    callback toggle();
    callback remove();
    // The card's settings button, drawn only when the plugin declares settings.
    callback settings();
    // A press that is not the Remove button's second press: it takes back any armed card.
    callback dismiss();

    property <length> pad: 1.5 * root.rem-size;
    // Just the switch: the card does not name the state in words, the switch is the state.
    property <length> buttons-width: 3.2 * root.rem-size;
    property <length> text-width: root.width - 2 * root.pad - root.buttons-width - root.rem-size;
    // What the card says under its title block: the description, then why it has no name, then
    // one line per warning. The card grows to fit them, so no line is cut off.
    property <length> body-height: (root.data.description == "" ? 0px : 2 * root.rem-size)
        + (root.data.unreadable == "" ? 0px : 2 * root.rem-size)
        + root.data.warnings.length * 1.2 * root.rem-size;
    // Where the lines under the description start: the description's own slot, the unreadable
    // note's, and one row per warning.
    property <length> body-end: root.pad + 4.4 * root.rem-size
        + (root.data.description == "" ? 0px : 2 * root.rem-size)
        + (root.data.unreadable == "" ? 0px : 2 * root.rem-size)
        + root.data.warnings.length * 1.2 * root.rem-size;
    // The list gives every card the row's height, so this default is only what a card drawn on
    // its own would take. It stays positive whatever the data says.
    height: Math.max(10 * root.rem-size, 6.0 * root.rem-size + root.pad + root.body-height);

    mod-card := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 0.75 * root.rem-size;
        border-width: 2 * root.rem-size / 14;
        // An armed card is outlined in the warning colour, so the second press is never a press
        // on a card that looks like every other one.
        border-color: root.data.armed ? Theme.accent-red : transparent;
        background: ClassStyles.background-or(ClassStyles.mod-card, Theme.overlay);
        opacity: ClassStyles.opacity-or(ClassStyles.mod-card, 1.0);
        visible: !ClassStyles.mod-card.hidden;

        // Any press on the card body takes back an armed Remove: a person who pressed the wrong
        // card does not have to wait five seconds for the arm on it to lapse.
        body-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.dismiss();
            }
        }

        mod-title := Text {
            x: root.pad;
            y: root.pad;
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.name;
            overflow: elide;
            vertical-alignment: center;
            font-size: 1.6 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-title, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-title, 1.0);
            visible: !ClassStyles.mod-title.hidden;
        }
        mod-byline := Text {
            x: root.pad;
            y: root.pad + 2 * root.rem-size;
            width: root.text-width;
            height: 1.2 * root.rem-size;
            text: root.data.byline;
            overflow: elide;
            vertical-alignment: center;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-byline, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-byline, 0.6);
            visible: !ClassStyles.mod-byline.hidden;
        }

        mod-description := Text {
            x: root.pad;
            // One line of space under the name and version: the description reads as its own
            // block rather than a third line of the title.
            y: root.pad + 4.4 * root.rem-size;
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.description;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-description, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-description, 1.0);
            visible: root.data.description != "" && !ClassStyles.mod-description.hidden;
        }
        mod-unreadable := Text {
            x: root.pad;
            y: mod-description.y + (root.data.description == "" ? 0px : 2 * root.rem-size);
            width: root.text-width;
            height: 2 * root.rem-size;
            text: root.data.unreadable;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-warning, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-warning, 0.7);
            visible: root.data.unreadable != "" && !ClassStyles.mod-warning.hidden;
        }
        // A theme that reaches something this app has no component for says so here, before it is
        // turned on, rather than only on stderr where nobody sees it.
        for warning[index] in root.data.warnings: mod-warning := Text {
            x: root.pad;
            y: mod-unreadable.y + (root.data.unreadable == "" ? 0px : 2 * root.rem-size) + index * 1.2 * root.rem-size;
            width: root.text-width;
            height: 1.2 * root.rem-size;
            text: warning;
            overflow: elide;
            font-size: 0.9 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-warning, Theme.accent-yellow);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-warning, 1.0);
            visible: !ClassStyles.mod-warning.hidden;
        }

        mod-toggle-container := Rectangle {
            x: parent.width - root.pad - root.buttons-width;
            y: root.pad;
            width: root.buttons-width;
            height: 1.8 * root.rem-size;
            background: ClassStyles.background-or(ClassStyles.mod-toggle-container, transparent);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-toggle-container, 1.0);
            visible: !ClassStyles.mod-toggle-container.hidden;

            mod-toggle := ModToggle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                rem-size: root.rem-size;
                on: root.data.enabled;
                // The file's own name, which is what the settings file records.
                name: root.data.filename;
                toggled => {
                    root.toggle();
                }
            }
        }

        if root.data.armed: mod-armed-note := Text {
            x: root.pad;
            y: root.body-end + 0.2 * root.rem-size;
            width: root.text-width;
            height: 2.4 * root.rem-size;
            text: "Pressing Confirm remove deletes " + root.data.filename + " from this computer.";
            wrap: word-wrap;
            font-size: 0.9 * root.rem-size;
            color: Theme.accent-red;
        }
        // The gear takes the bottom-right corner the Remove button also wants, so Remove steps
        // left when both are drawn. A card with settings and no file to remove (a built-in) keeps
        // the corner to itself.
        if root.data.has-settings: ModSettingsButton {
            x: parent.width - root.pad - self.width;
            y: parent.height - root.pad - self.height;
            rem-size: root.rem-size;
            name: root.data.filename;
            clicked => {
                root.settings();
            }
        }
        if root.data.removable: ModRemoveButton {
            x: parent.width - root.pad - self.width - (root.data.has-settings ? 3.4 * root.rem-size : 0px);
            y: parent.height - root.pad - self.height;
            rem-size: root.rem-size;
            armed: root.data.armed;
            name: root.data.filename;
            clicked => {
                root.remove();
            }
        }
    }
}

// The box a text setting is typed into. It only writes the window's own value on a press in the
// box, so a new value the app hands back does not move the cursor under anyone's typing.
export component SettingsTextField inherits LineEdit {
    in property <length> rem-size;
    in property <string> label-text;
    in property <string> shown;
    callback said(string);

    font-size: 1.1 * root.rem-size;
    // The label, so a test finds the box it means to type in.
    accessible-description: root.label-text;
    // A press in the box first puts what the page holds into it: the editor is then the page's,
    // and a frame that arrives while it has focus does not overwrite what is being typed.
    init => {
        self.text = root.shown;
    }
    // A value the page hands the box that differs from what it shows -- after a save normalises
    // it, or when the page is left -- replaces the text. The echo of a keystroke is the same text
    // and is left alone, so typing never fights the page.
    changed shown => {
        if (self.text != root.shown) {
            self.text = root.shown;
        }
    }
    edited(text) => {
        root.said(text);
    }
}

// One control on the Plugin settings page, drawn as the field's kind. A press in it changes the
// value on the page; nothing is written until Save.
component SettingsFieldView inherits Rectangle {
    in property <SettingsFieldData> field;
    in property <length> rem-size;
    callback toggled(bool);
    callback typed(string);
    callback picked(string);
    callback slid(float);

    property <length> pad: 0.8 * rem-size;
    // A setting is a block: its label, its control under it, and the hint under that. The control
    // keeps a readable width instead of stretching across a page this wide.
    property <length> control-width: Math.min(Math.max(0px, root.width - 2 * root.pad), 36 * rem-size);
    property <length> control-x: root.pad;
    property <length> control-y: root.pad + 2.2 * rem-size;

    height: 9 * rem-size;

    settings-field-label := Text {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: 1.6 * rem-size;
        text: root.field.label;
        overflow: elide;
        vertical-alignment: center;
        font-size: 1.05 * rem-size;
        font-weight: 600;
        color: Theme.text;
    }
    // Every kind says what it is under its control, in one line: the range, the options, or what
    // the app makes of a kind it cannot draw. A kind it cannot draw has no control at all.
    settings-field-hint := Text {
        x: root.control-x;
        y: root.control-y + 2.8 * rem-size;
        width: root.control-width;
        height: 2.4 * rem-size;
        text: root.field.hint;
        // Wrapped: a built-in's hint is a sentence ("leave it empty to make one..."), not a word.
        wrap: word-wrap;
        overflow: clip;
        vertical-alignment: top;
        font-size: 0.9 * rem-size;
        color: root.field.kind == "unsupported" ? Theme.accent-yellow : Theme.placeholder;
    }

    if root.field.kind == "toggle": settings-field-toggle := Rectangle {
        x: root.control-x;
        y: root.control-y;
        width: 3.2 * root.rem-size;
        height: 1.8 * root.rem-size;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: root.field.on ? Theme.accent-green : Theme.placeholder;
        background: root.field.on ? Theme.accent-green : transparent;

        knob := Rectangle {
            x: root.field.on ? parent.width - self.width - 2 * root.rem-size / 14 : 2 * root.rem-size / 14;
            y: (parent.height - self.height) / 2;
            width: parent.height - 4 * root.rem-size / 14;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.text;
        }
        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            // Named for what the press will do, so a test presses the step it means.
            accessible-role: switch;
            accessible-label: (root.field.on ? "Turn off " : "Turn on ") + root.field.label;
            accessible-checkable: true;
            accessible-checked: root.field.on;
            clicked => {
                root.toggled(!root.field.on);
            }
        }
    }
    if root.field.kind == "text": settings-field-text := SettingsTextField {
        x: root.control-x;
        y: root.control-y;
        width: root.control-width;
        height: 2.4 * root.rem-size;
        rem-size: root.rem-size;
        label-text: root.field.label;
        shown: root.field.text;
        said(text) => {
            root.typed(text);
        }
    }
    if root.field.kind == "select": settings-field-select := HorizontalLayout {
        x: root.control-x;
        y: root.control-y;
        width: root.control-width;
        height: 2.4 * root.rem-size;
        spacing: 0.6 * root.rem-size;
        alignment: start;

        // One pill per option, the one the field holds marked. A select with many options wraps
        // past the row rather than being cut off: the hint under it says the whole list too.
        for option[index] in root.field.options: option-pill := Rectangle {
            width: option-label.width + 1.6 * root.rem-size;
            height: parent.height;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: option == root.field.text ? Theme.accent-green : Theme.placeholder;
            background: (option == root.field.text || option-touch.has-hover) ? Theme.overlay : transparent;

            option-label := Text {
                x: 0.8 * root.rem-size;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                text: option;
                font-size: root.rem-size;
                color: option == root.field.text ? Theme.accent-green : Theme.text;
            }
            option-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                // The field's key and the option, so a test presses the option it means.
                accessible-role: radio-button;
                accessible-label: root.field.label + ": " + option;
                accessible-checkable: true;
                accessible-checked: option == root.field.text;
                clicked => {
                    root.picked(option);
                }
            }
        }
    }
    if root.field.kind == "range": settings-field-range := Slider {
        x: root.control-x;
        y: root.control-y;
        width: root.control-width - 8 * root.rem-size;
        height: 2.4 * root.rem-size;
        minimum: root.field.min;
        maximum: root.field.max > root.field.min ? root.field.max : root.field.min + 1;
        value: root.field.number;
        // The label, so a test finds the slider it means.
        accessible-description: root.field.label;
        changed(value) => {
            root.slid(value);
        }
    }
    if root.field.kind == "range": settings-field-number := Text {
        x: root.control-x + parent.width - 8 * root.rem-size;
        y: root.control-y;
        width: 7 * root.rem-size;
        height: 2.4 * root.rem-size;
        text: root.field.shown;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: root.rem-size;
        color: Theme.text;
    }
}

// A pill button on the Plugin settings page. Save is the page's only action, drawn the
// same way so neither is the one a person presses by mistake.
component SettingsButton inherits Rectangle {
    in property <string> label-text;
    in property <bool> enabled;
    in property <bool> primary;
    in property <bool> danger: false;
    in property <string> name;
    in property <length> rem-size;
    callback clicked();

    height: 3 * rem-size;
    width: settings-button-label.width + 2 * rem-size;
    border-radius: self.height / 2;
    border-width: 2px;
    border-color: (root.danger && root.enabled) ? Theme.accent-red
        : (root.primary && root.enabled) ? Theme.accent-green : Theme.text;
    background: (root.danger && root.enabled)
        ? (settings-button-touch.has-hover ? #ff707033 : #ff70701a)
        : (root.enabled && root.primary) ? Theme.accent-green
        : (root.enabled && settings-button-touch.has-hover) ? Theme.overlay : transparent;
    opacity: root.enabled ? 1.0 : 0.3;

    settings-button-label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        text: root.label-text;
        font-size: rem-size;
        font-weight: 700;
        color: (root.danger && root.enabled) ? Theme.accent-red
            : (root.primary && root.enabled) ? Theme.on-accent : Theme.text;
    }
    settings-button-touch := TouchArea {
        width: 100%;
        height: 100%;
        // A button that would do nothing is not a target: it says so and presses do not reach it.
        mouse-cursor: root.enabled ? pointer : default;
        accessible-role: button;
        accessible-label: root.name;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}



// One record on the Logs page: the time, the source, the level and the text on one line. A press
// opens the whole record under the list. Web: a row of the addon list, one line per record.
component ModsLogRowView inherits Rectangle {
    in property <ModsLogRow> record;
    in property <length> rem-size;
    /// Whether this row is part of the active selection.
    in property <bool> selected;
    /// Whether this row is the record currently shown in the detail panel.
    in property <bool> active;
    /// Whether the list's drag-select area is currently hovering this row.
    in property <bool> hovered;
    /// Width of the Source column, shared with the table header so columns line up cleanly.
    in property <length> source-width: Math.min(15 * root.rem-size, Math.max(9 * root.rem-size, root.width * 0.27));

    height: 2.2 * rem-size;
    background: (root.selected && root.active)
        ? (root.hovered ? #22b36530 : #22b36524)
        : root.selected
        ? (root.hovered ? #22b36520 : #22b36514)
        : root.hovered ? Theme.overlay : transparent;
    // The text, so a test presses the record it means. The time is in it, because two lines
    // of the same text are two records.
    accessible-role: button;
    // The row says whether it is selected, so what a press did is readable on screen and not only
    // in the model behind it.
    accessible-label: (root.selected ? "Open " : "Show ")
        + root.record.time + " " + root.record.source + ": " + root.record.text;
    // A hairline on the left marks every selected row, brighter on the active detail row.
    if root.selected: Rectangle {
        x: 0px;
        y: 0.2 * root.rem-size;
        width: 3px;
        height: root.height - 0.4 * root.rem-size;
        border-radius: 1.5px;
        background: Theme.accent-green;
        opacity: root.active ? 1.0 : 0.55;
    }

    log-row-time := Text {
        x: 0.75 * rem-size;
        y: 0px;
        width: 4.8 * rem-size;
        height: parent.height;
        text: root.record.time;
        vertical-alignment: center;
        font-size: 0.82 * rem-size;
        color: ClassStyles.color-or(ClassStyles.mods-log-time, Theme.placeholder);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-log-time, 1.0);
        visible: !ClassStyles.mods-log-time.hidden;
    }
    log-row-source := Text {
        x: log-row-time.x + log-row-time.width + 0.6 * rem-size;
        y: 0px;
        width: root.source-width;
        height: parent.height;
        text: root.record.source;
        overflow: elide;
        vertical-alignment: center;
        font-size: 0.85 * rem-size;
        color: ClassStyles.color-or(ClassStyles.mods-log-source, Theme.text);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-log-source, root.record.level-id == "debug" ? 0.75 : 1.0);
        visible: !ClassStyles.mods-log-source.hidden;
    }
    log-row-level-pill := Rectangle {
        x: log-row-source.x + log-row-source.width + 0.6 * rem-size;
        y: (parent.height - self.height) / 2;
        width: 5.4 * rem-size;
        height: 1.4 * rem-size;
        border-radius: 0.35 * rem-size;
        background: root.record.level-id == "error" ? #ff707022
            : root.record.level-id == "warn" ? #ffba191f
            : root.record.level-id == "info" ? #7b5bf520 : #ffffff0a;
        visible: !ClassStyles.mods-log-level.hidden;

        log-row-level := Text {
            x: 0.35 * rem-size;
            y: 0px;
            width: parent.width - 0.7 * rem-size;
            height: parent.height;
            text: root.record.level;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 0.78 * rem-size;
            font-weight: 600;
            // Each severity has its own weight: red error, yellow warning, soft accent info, muted debug.
            color: ClassStyles.color-or(ClassStyles.mods-log-level,
                root.record.level-id == "error" ? Theme.accent-red
                : root.record.level-id == "warn" ? Theme.accent-yellow
                : root.record.level-id == "info" ? Theme.accent-soft : Theme.placeholder);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-log-level, 1.0);
        }
    }
    log-row-text := Text {
        x: log-row-level-pill.x + log-row-level-pill.width + 0.8 * rem-size;
        y: 0px;
        width: Math.max(0px, parent.width - self.x - 0.75 * rem-size);
        height: parent.height;
        text: root.record.text;
        overflow: elide;
        vertical-alignment: center;
        font-size: 0.85 * rem-size;
        color: ClassStyles.color-or(ClassStyles.mods-log-text,
            root.record.level-id == "debug" ? Theme.placeholder : Theme.text);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-log-text, 1.0);
        visible: !ClassStyles.mods-log-text.hidden;
    }
    // Subtle hairline separator to help track columns horizontally across wide windows.
    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #ffffff08;
    }
}

// One label and its value on the About page: the label in a column of its own so the values line
// up. Web: a Settings row.
component ModsAboutRow inherits Rectangle {
    in property <ModsAboutLine> entry;
    in property <length> rem-size;

    height: 2.2 * rem-size;

    about-row-label := Text {
        x: 0px;
        y: 0px;
        width: 18 * rem-size;
        height: parent.height;
        text: root.entry.label;
        overflow: elide;
        vertical-alignment: center;
        font-size: 0.95 * rem-size;
        color: ClassStyles.color-or(ClassStyles.mods-about-label, Theme.text);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-about-label, 0.7);
        visible: !ClassStyles.mods-about-label.hidden;
    }
    about-row-value := Text {
        x: about-row-label.width + rem-size;
        y: 0px;
        width: Math.max(0px, parent.width - self.x - 0.4 * rem-size);
        height: parent.height;
        text: root.entry.value;
        overflow: elide;
        vertical-alignment: center;
        font-size: 0.95 * rem-size;
        color: ClassStyles.color-or(ClassStyles.mods-about-value, Theme.text);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-about-value, 1.0);
        visible: !ClassStyles.mods-about-value.hidden;
    }
}

export component ModsContent inherits Rectangle {
    // The height every card on a page takes: the tallest card the page has to draw, so the list's
    // row pitch matches what each card draws.
    pure function tallest(cards: [ModCardData], rem-size: length) -> length {
        return Math.max(10 * rem-size, cards.length == 0 ? 0px : 6.0 * rem-size + 1.5 * rem-size
            + (cards[0].description == "" ? 0px : 2 * rem-size)
            + (cards[0].unreadable == "" ? 0px : 2 * rem-size)
            + cards[0].warnings.length * 1.2 * rem-size);
    }

    pure function log-row-at(y: length, row-height: length, count: int) -> int {
        return count <= 0 ? -1
            : Math.max(0, Math.min(count - 1, Math.floor(y / row-height)));
    }

    in property <ModsViewData> data;
    /// The width of the window, which decides one rem.
    in property <length> viewport-width;

    // Pick a page of the menu.
    callback select-page(string);
    // A card's switch, naming the file and the state the switch asks for. One pair of callbacks
    // for both pages: which list a file belongs to is the page's business, not the window's.
    callback toggle-mod(string, bool);
    // A card's Remove button. The first press of a card arms it and removes nothing; the second
    // press of the same card removes the file.
    callback remove-mod(string);
    /// Any other press on a card, which takes back an armed Remove.
    callback dismiss-remove();
    /// The Plugin settings page's left list, naming the file picked. Empty means nothing is
    /// picked.
    callback pick-settings-plugin(string);
    /// A press in one control: the plugin's key for the value, and the value it now holds. One
    /// callback per kind of control, because a toggle's on state, a text's string and a slider's
    /// number are three kinds of value.
    callback edit-settings-toggle(string, bool);
    callback edit-settings-text(string, string);
    callback edit-settings-number(string, float);
    /// The Save press: what the page holds goes into the plugin's settings file.
    callback save-settings();
    /// A press on one of the Logs page's filter menus: which part of the filter ("source" or
    /// "level") and the row picked, zero being every source or every level.
    callback filter-logs(string, int);
    /// The Logs page's search box. Each change is a press.
    callback search-logs(string);
    /// Clears source, level, and search filters in one press.
    callback reset-logs-filter();
    /// Pointer press, drag-over, and release on log rows (carrying Shift and Ctrl modifiers).
    callback press-log(int, bool, bool);
    callback drag-log(int);
    callback release-log(int);
    /// Keyboard actions on the log list: select all visible rows, or step active row up/down.
    callback select-all-logs();
    callback step-log(int, bool);
    /// The toolbar's Copy press: copies all selected visible records to the clipboard.
    callback copy-log();
    /// The detail panel's Close press: the record is put away.
    callback close-log();
    /// The Logs page's Clear button. The first press arms it and empties nothing.
    callback clear-logs();
    /// The About page's buttons: read the folders again, write the diagnostics file, and copy the
    /// version to the clipboard.
    callback refresh-about();
    callback export-diagnostics();
    callback copy-version();

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <length> menu-width: 18 * root.rem-size;
    property <length> page-padding: 3 * root.rem-size;
    property <length> page-width: root.width - root.menu-width - 2 * root.page-padding;
    // Plugins, Themes, and Logs all start their content at 6.4rem (just under the 2rem..5rem
    // heading); About has a one-line subtitle and starts cleanly below it at 8.0rem. Notices sit
    // inline on the title row so they never jump the content downward.
    property <bool> has-page-note: root.on-about;
    property <length> page-top: 5.2 * root.rem-size;
    property <length> list-top: root.has-page-note ? 8.0 * root.rem-size : 6.4 * root.rem-size;
    property <length> list-height: Math.max(root.height - root.list-top, 0px);
    // A card plus the 0.75rem under it. Every card is the height of the tallest one on screen,
    // because a `for` row cannot ask its neighbours how tall they are.
    property <length> card-height: root.on-plugins ? tallest(root.data.plugins, root.rem-size)
        : root.on-themes ? tallest(root.data.themes, root.rem-size) : 10 * root.rem-size;
    property <length> card-pitch: root.card-height + 0.75 * root.rem-size;

    property <bool> on-plugins: root.data.page == "plugins";
    property <bool> on-themes: root.data.page == "themes";
    property <bool> on-settings: root.data.page == "settings";
    property <bool> on-logs: root.data.page == "logs";
    property <bool> on-about: root.data.page == "about";
    // The left list of the Plugin settings page: a column 18rem wide beside the page's controls.
    property <length> choice-width: 18 * root.rem-size;
    property <length> fields-width: Math.max(0px, root.page-width - root.choice-width - 2 * root.rem-size);

    mods-menu-container := Rectangle {
        x: 0px;
        y: 0px;
        width: root.menu-width;
        height: root.height;
        background: ClassStyles.background-or(ClassStyles.mods-menu-container, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-menu-container, 1.0);
        visible: !ClassStyles.mods-menu-container.hidden;

        for item[index] in root.data.menu: ModsMenuButton {
            x: 1.5 * root.rem-size;
            y: 2 * root.rem-size + index * 3.6 * root.rem-size;
            width: 15 * root.rem-size;
            rem-size: root.rem-size;
            label-text: item.label;
            // Derived from the page on screen rather than taken from the row: the menu itself only
            // changes when a page is picked, and rebuilding it under a press would take the row
            // the press was made on out from under it.
            selected: item.id == root.data.page;
            clicked => {
                root.select-page(item.id);
            }
        }
    }

    mods-content := Rectangle {
        x: root.menu-width;
        y: 0px;
        width: root.width - root.menu-width;
        height: root.height;
        background: ClassStyles.background-or(ClassStyles.mods-content, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.mods-content, 1.0);
        visible: !ClassStyles.mods-content.hidden;

        // The page's name, and the line about the last action under it.
        mods-page-title := Text {
            x: root.page-padding;
            y: 2 * root.rem-size;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: root.on-plugins ? "Plugins"
                : root.on-themes ? "Themes"
                : root.data.page == "logs" ? "Logs" : "About";
            vertical-alignment: center;
            font-size: 2.2 * root.rem-size;
            font-weight: 700;
            color: ClassStyles.color-or(ClassStyles.mods-page-title, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-page-title, 1.0);
            // A plugin's settings bring their own header, with its own back arrow: the section's
            // title would be a second heading over the same page.
            visible: !root.on-settings && !ClassStyles.mods-page-title.hidden;
        }

        if root.data.notice != "": mod-notice := Text {
            // Sit inline on the title row across all pages so notices never jump content downward
            // under the pointer.
            x: root.page-padding + 10 * root.rem-size;
            y: 2 * root.rem-size;
            width: Math.max(0px, root.page-width - 10 * root.rem-size);
            height: 3 * root.rem-size;
            text: root.data.notice;
            wrap: no-wrap;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 0.9 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mod-notice, root.data.notice-failed ? Theme.accent-red : Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mod-notice, root.data.notice-failed ? 1.0 : 0.7);
            visible: !ClassStyles.mod-notice.hidden;
        }

        // One-line subtitle on About; Plugins, Themes, and Logs go straight from heading to content.
        mods-page-note := Text {
            x: root.page-padding;
            y: root.page-top;
            width: root.page-width;
            height: 1.8 * root.rem-size;
            text: root.on-about ? "What this build is and what it keeps." : "";
            wrap: word-wrap;
            vertical-alignment: top;
            font-size: root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-page-note, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-page-note, 0.7);
            visible: root.has-page-note && !ClassStyles.mods-page-note.hidden;
        }

        if root.on-plugins && root.data.plugins.length == 0: mods-empty-plugins := Text {
            x: root.page-padding;
            y: root.list-top;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: "No plugins are installed.";
            font-size: 1.4 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-empty, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-empty, 0.8);
            visible: !ClassStyles.mods-empty.hidden;
        }
        if root.on-themes && root.data.themes.length == 0: mods-empty-themes := Text {
            x: root.page-padding;
            y: root.list-top;
            width: root.page-width;
            height: 3 * root.rem-size;
            text: "No themes are installed.";
            font-size: 1.4 * root.rem-size;
            color: ClassStyles.color-or(ClassStyles.mods-empty, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.mods-empty, 0.8);
            visible: !ClassStyles.mods-empty.hidden;
        }

        mods-list := Flickable {
            x: 0px;
            y: root.list-top;
            width: parent.width;
            height: root.list-height;
            content-width: self.width;
            content-height: (root.on-plugins ? root.data.plugins.length : root.on-themes ? root.data.themes.length : 0) * root.card-pitch;

            // One `for` per page, each drawn only while its page is the one on screen -- the same
            // shape the addons list uses. A `for` cannot follow an `if` directly, so the row is
            // written out twice rather than held in a container: a container's own origin is not
            // the list's, and its rows end up drawn above the list instead of inside it.
            for entry[index] in root.data.plugins: ModCardView {
                x: root.page-padding;
                y: index * root.card-pitch;
                width: root.page-width - 8px;
                rem-size: root.rem-size;
                // Every card is the row's height: a card is never shorter than the tallest.
                height: root.card-height;
                visible: root.on-plugins;
                data: entry;
                toggle => {
                    root.toggle-mod(entry.filename, !entry.enabled);
                }
                remove => {
                    root.remove-mod(entry.filename);
                }
                dismiss => {
                    root.dismiss-remove();
                }
                settings => {
                    root.pick-settings-plugin(entry.filename);
                }
            }
            for entry[index] in root.data.themes: ModCardView {
                x: root.page-padding;
                y: index * root.card-pitch;
                width: root.page-width - 8px;
                rem-size: root.rem-size;
                height: root.card-height;
                visible: root.on-themes;
                data: entry;
                toggle => {
                    root.toggle-mod(entry.filename, !entry.enabled);
                }
                remove => {
                    root.remove-mod(entry.filename);
                }
                dismiss => {
                    root.dismiss-remove();
                }
            }
        }

        ScrollBar {
            x: parent.width - 8px;
            y: root.list-top;
            height: root.list-height;
            view-height: root.list-height;
            content-height: mods-list.content-height;
            offset <=> mods-list.content-y;
            visible: root.on-plugins || root.on-themes;
        }

        // ---- Plugin settings ------------------------------------------------------------
        // The installed plugins on the left, the picked one's schema on the right. The page only
        // edits: Save writes the plugin's settings file, the back arrow drops the edits, and
        // nothing here deletes a value or the schema itself.
                if root.on-settings: settings-box := Rectangle {
            x: root.page-padding;
            // The page brings its own header, so it starts where the section's title would have:
            // back arrow and plugin name on one line, at the top of the content area.
            y: 2 * root.rem-size;
            width: root.page-width;
            height: Math.max(root.height - 2 * root.rem-size, 0px);

            // The page uses the whole viewport: the name, then one full-width block per field,
            // then Save at the bottom where the page's actions live. The old split layout sized
            // every row for a 16rem label column beside its control, which left most of this
            // width empty.
            property <length> header-height: 3.2 * root.rem-size;
            property <length> trouble-height: root.data.settings-trouble.length * 1.2 * root.rem-size;
            property <length> fields-y: settings-box.header-height
                + settings-box.trouble-height
                + (settings-box.trouble-height == 0px ? 0.4 * root.rem-size : 0.8 * root.rem-size);
            // Below the fields, and below the note when a plugin has none: the page's one action
            // sits at the bottom, not in the header.
            property <length> save-y: settings-box.fields-y
                + root.data.settings-fields.length * 9.8 * root.rem-size
                + (root.data.settings-empty == "" ? 0px : 3.2 * root.rem-size)
                + 0.8 * root.rem-size;

            settings-fields := Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: settings-box.save-y + 4 * root.rem-size;

                settings-header := Text {
                    x: 3.6 * root.rem-size;
                    y: 0px;
                    width: parent.width - 3.6 * root.rem-size - 8px;
                    height: settings-box.header-height;
                    text: root.data.settings-title;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: 1.6 * root.rem-size;
                    font-weight: 700;
                    color: Theme.text;
                }
                // What is wrong with the page.
                for trouble[index] in root.data.settings-trouble: settings-trouble := Text {
                    x: 0px;
                    y: settings-box.header-height + index * 1.2 * root.rem-size;
                    width: parent.width - 8px;
                    height: 1.2 * root.rem-size;
                    text: trouble;
                    overflow: elide;
                    font-size: 0.9 * root.rem-size;
                    color: Theme.accent-red;
                }
                for field[index] in root.data.settings-fields: SettingsFieldView {
                    x: 0px;
                    y: settings-box.fields-y + index * 9.8 * root.rem-size;
                    width: parent.width - 8px;
                    rem-size: root.rem-size;
                    field: field;
                    toggled(value) => {
                        root.edit-settings-toggle(field.key, value);
                    }
                    typed(text) => {
                        root.edit-settings-text(field.key, text);
                    }
                    picked(option) => {
                        root.edit-settings-text(field.key, option);
                    }
                    slid(value) => {
                        root.edit-settings-number(field.key, value);
                    }
                }
                if root.data.settings-empty != "": settings-said := Text {
                    x: 0px;
                    y: settings-box.fields-y + root.data.settings-fields.length * 9.8 * root.rem-size;
                    width: parent.width - 8px;
                    height: 3 * root.rem-size;
                    text: root.data.settings-empty;
                    wrap: word-wrap;
                    font-size: root.rem-size;
                    color: Theme.text;
                    opacity: 0.7;
                }
                // The page's one action: Save writes what is on screen, and the values the plugin
                // can hold are the page's own business, not its file's.
                settings-save := SettingsButton {
                    x: 0px;
                    y: settings-box.save-y;
                    rem-size: root.rem-size;
                    label-text: "Save";
                    name: "Save " + root.data.settings-plugin;
                    primary: true;
                    enabled: root.data.settings-dirty;
                    clicked => {
                        root.save-settings();
                    }
                }
            }
            ScrollBar {
                x: parent.width - 8px;
                y: 0px;
                height: parent.height;
                view-height: parent.height;
                content-height: settings-fields.content-height;
                offset <=> settings-fields.content-y;
            }
            // The way back to the list, on the header line. Drawn after the list, so it takes the
            // press even though the list runs underneath it.
            settings-back := Rectangle {
                x: 0px;
                y: 0px;
                width: 3 * root.rem-size;
                height: 3 * root.rem-size;
                border-radius: 0.5 * root.rem-size;
                background: settings-back-touch.has-hover ? #ffffff24 : #ffffff14;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.5 * root.rem-size;
                    height: 1.5 * root.rem-size;
                    source: @image-url("icons/chevron-back.svg");
                    colorize: Theme.text;
                    opacity: settings-back-touch.has-hover ? 0.8 : 0.6;
                }
                settings-back-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Back to plugins";
                    clicked => {
                        root.select-page("plugins");
                    }
                }
            }
        }

        // ---- Logs -----------------------------------------------------------------------
        // Every record the app holds, newest first, with the filter above the list. Clear empties
        // the list on its second press and deletes no file.
        if root.on-logs: logs-box := Rectangle {
            x: root.page-padding;
            // Fixed top offset on Logs with breathing room under the "Logs" heading (notice sits
            // inline on the title row) so copying never shifts the toolbar and list downward.
            y: 6.4 * root.rem-size;
            width: root.page-width;
            // Keep bottom breathing room below the detail panel and list so neither sits flush
            // against the bottom edge of the window.
            height: Math.max(root.height - 6.4 * root.rem-size - 2 * root.rem-size, 0px);

            // One row of filter menus + count/reset, then search + Copy + Clear, then the table.
            property <length> filter-height: 7.9 * root.rem-size;
            property <length> row-height: 2.2 * root.rem-size;
            property <int> active-index: root.data.log-active-index;
            property <bool> detail-open: root.data.log-detail.length > 0;
            property <bool> scroll-after-detail: false;
            property <length> watched-rows-height: log-rows.height;
            property <length> watched-content-height: log-rows.content-height;
            property <int> prepend-seq: root.data.log-prepend-seq;
            property <string> external-search: root.data.log-search;
            property <int> watched-source-index: root.data.log-source-index;
            property <int> watched-level-index: root.data.log-level-index;

            function clamp-log-scroll() {
                if (log-rows.content-height <= log-rows.height) {
                    log-rows.content-y = 0px;
                } else {
                    log-rows.content-y = Math.min(
                        0px,
                        Math.max(log-rows.height - log-rows.content-height, log-rows.content-y)
                    );
                }
            }

            function ensure-row-visible(index: int) {
                if (index < 0 || index >= root.data.log-rows.length) {
                    return;
                }
                if (log-rows.height <= 0px || log-rows.content-height <= log-rows.height) {
                    log-rows.content-y = 0px;
                    return;
                }
                if (index * self.row-height < -log-rows.content-y) {
                    log-rows.content-y = -(index * self.row-height);
                } else if ((index + 1) * self.row-height > -log-rows.content-y + log-rows.height) {
                    log-rows.content-y = Math.max(
                        log-rows.height - log-rows.content-height,
                        log-rows.height - (index + 1) * self.row-height
                    );
                }
            }

            init => {
                log-keys.focus();
            }
            changed active-index => {
                if (self.active-index >= 0) {
                    self.ensure-row-visible(self.active-index);
                }
            }
            changed detail-open => {
                if (self.detail-open) {
                    self.scroll-after-detail = true;
                } else {
                    self.scroll-after-detail = false;
                }
            }
            changed watched-rows-height => {
                self.clamp-log-scroll();
                if (self.scroll-after-detail) {
                    self.scroll-after-detail = false;
                    self.ensure-row-visible(root.data.log-active-index);
                }
            }
            changed watched-content-height => {
                self.clamp-log-scroll();
            }
            changed prepend-seq => {
                if (log-rows.content-y < 0px && root.data.log-prepended > 0) {
                    log-rows.content-y = Math.max(
                        log-rows.height - log-rows.content-height,
                        log-rows.content-y - root.data.log-prepended * self.row-height
                    );
                }
            }
            changed external-search => {
                if (log-search.text != root.data.log-search) {
                    log-search.text = root.data.log-search;
                }
                log-rows.content-y = 0px;
            }
            changed watched-source-index => {
                log-rows.content-y = 0px;
            }
            changed watched-level-index => {
                log-rows.content-y = 0px;
            }

            // Keyboard navigation for the log list: Ctrl+C copies selection, Ctrl+A selects all
            // visible rows, Esc clears selection/detail/armed Clear, Up/Down step (with Shift).
            log-keys := FocusScope {
                width: 0px;
                height: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        if (root.data.log-selected-count > 0 || root.data.log-open-id != 0 || root.data.log-clear-armed) {
                            root.close-log();
                            return accept;
                        }
                        return reject;
                    }
                    if (event.text == Key.DownArrow) {
                        if (root.data.log-rows.length > 0) {
                            root.step-log(1, event.modifiers.shift);
                            return accept;
                        }
                        return reject;
                    }
                    if (event.text == Key.UpArrow) {
                        if (root.data.log-rows.length > 0) {
                            root.step-log(-1, event.modifiers.shift);
                            return accept;
                        }
                        return reject;
                    }
                    if ((event.modifiers.control || event.modifiers.meta)
                        && (event.text == "c" || event.text == "C" || event.text == "\u{0003}"))
                    {
                        if (root.data.log-selected-count > 0) {
                            root.copy-log();
                            return accept;
                        }
                        return reject;
                    }
                    if ((event.modifiers.control || event.modifiers.meta)
                        && (event.text == "a" || event.text == "A" || event.text == "\u{0001}"))
                    {
                        if (root.data.log-rows.length > 0) {
                            root.select-all-logs();
                            return accept;
                        }
                        return reject;
                    }
                    return reject;
                }
            }

            // Row 1: responsive source & level dropdowns on the left, compact count & Reset on the right.
            log-filter-row := HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 3 * root.rem-size;
                spacing: 0.8 * root.rem-size;

                log-source-filter := MultiselectMenu {
                    horizontal-stretch: 0;
                    preferred-width: 14 * root.rem-size;
                    min-width: 9 * root.rem-size;
                    max-width: 16 * root.rem-size;
                    rem-size: root.rem-size;
                    title: root.data.log-source-options[root.data.log-source-index].label;
                    options: root.data.log-source-options;
                    selected-index: root.data.log-source-index;
                    select(index) => {
                        root.filter-logs("source", index);
                    }
                }
                log-level-filter := MultiselectMenu {
                    horizontal-stretch: 0;
                    preferred-width: 17 * root.rem-size;
                    min-width: 10 * root.rem-size;
                    max-width: 20 * root.rem-size;
                    rem-size: root.rem-size;
                    title: root.data.log-level-options[root.data.log-level-index].label;
                    options: root.data.log-level-options;
                    selected-index: root.data.log-level-index;
                    select(index) => {
                        root.filter-logs("level", index);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.data.log-count != "": log-count := Text {
                    horizontal-stretch: 0;
                    text: root.data.log-count;
                    vertical-alignment: center;
                    font-size: 0.85 * root.rem-size;
                    color: Theme.placeholder;
                }
                if root.data.log-filtered: log-reset-slot := Rectangle {
                    horizontal-stretch: 0;
                    width: log-reset-pill.width;
                    height: 3 * root.rem-size;

                    log-reset-pill := Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: log-reset-label.width + 1.4 * root.rem-size;
                        height: 2.1 * root.rem-size;
                        border-radius: self.height / 2;
                        border-width: 1px;
                        border-color: log-reset-touch.has-hover ? Theme.text : #ffffff33;
                        background: log-reset-touch.has-hover ? #ffffff1a : transparent;

                        log-reset-label := Text {
                            x: 0.7 * root.rem-size;
                            y: (parent.height - self.height) / 2;
                            width: self.preferred-width;
                            text: "Reset filters";
                            font-size: 0.82 * root.rem-size;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        log-reset-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Reset filters";
                            clicked => {
                                root.reset-logs-filter();
                                log-keys.focus();
                            }
                        }
                    }
                }
            }

            // Row 2: search box stretching on the left, Copy and Clear grouped on the right.
            log-toolbar := HorizontalLayout {
                x: 0px;
                y: 3.9 * root.rem-size;
                width: parent.width;
                height: 3 * root.rem-size;
                spacing: 0.8 * root.rem-size;

                log-search-scope := FocusScope {
                    horizontal-stretch: 1;
                    min-width: 8 * root.rem-size;
                    height: 3 * root.rem-size;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            log-keys.focus();
                            return accept;
                        }
                        return reject;
                    }

                    log-search-bar := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: self.height / 2;
                        border-width: 1px;
                        border-color: log-search.has-focus ? Theme.accent : #ffffff14;
                        background: ClassStyles.background-or(ClassStyles.search-bar-container, Theme.overlay);
                        opacity: ClassStyles.opacity-or(ClassStyles.search-bar-container, 1.0);
                        visible: !ClassStyles.search-bar-container.hidden;

                        // Behind the box, so a press on the pill's own edge puts the cursor in it.
                        search-bar-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: text;
                            clicked => {
                                log-search.focus();
                            }
                        }
                        search-icon := Image {
                            source: @image-url("icons/search.svg");
                            x: 1.0 * root.rem-size;
                            y: (parent.height - self.height) / 2;
                            width: 1.15 * root.rem-size;
                            height: self.width;
                            colorize: ClassStyles.color-or(ClassStyles.icon, Theme.search-icon);
                            opacity: ClassStyles.icon.has-color ? 0.6 : 0.85;
                            visible: !ClassStyles.icon.hidden;
                        }
                        log-search := TextInput {
                            x: 2.8 * root.rem-size;
                            y: 0px;
                            width: Math.max(0px, parent.width - (self.text != "" ? 5.6 * root.rem-size : 3.8 * root.rem-size));
                            height: parent.height;
                            single-line: true;
                            vertical-alignment: center;
                            font-size: 0.95 * root.rem-size;
                            color: ClassStyles.color-or(ClassStyles.search, Theme.text);
                            // The box says what it searches, so a test finds the box it means.
                            accessible-label: "Search the logs";
                            init => {
                                self.text = root.data.log-search;
                            }
                            edited => {
                                root.search-logs(self.text);
                            }
                        }
                        if log-search.text == "": search-placeholder := Text {
                            x: log-search.x;
                            width: log-search.width;
                            height: parent.height;
                            text: "Search logs";
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: 0.95 * root.rem-size;
                            color: Theme.placeholder;
                        }
                        // The way back to every record, in one press.
                        if log-search.text != "": search-clear := Rectangle {
                            x: parent.width - 2.3 * root.rem-size;
                            y: (parent.height - self.height) / 2;
                            width: 1.6 * root.rem-size;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: search-clear-touch.has-hover ? #ffffff24 : transparent;

                            search-clear-icon := Image {
                                source: @image-url("icons/close.svg");
                                x: 0.3 * root.rem-size;
                                y: self.x;
                                width: parent.width - 0.6 * root.rem-size;
                                height: self.width;
                                colorize: Theme.search-icon;
                            }
                            search-clear-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "Clear the search";
                                clicked => {
                                    log-search.text = "";
                                    root.search-logs("");
                                }
                            }
                        }
                    }
                }
                log-copy := SettingsButton {
                    horizontal-stretch: 0;
                    rem-size: root.rem-size;
                    label-text: root.data.log-selected-count > 1 ? "Copy (" + root.data.log-selected-count + ")" : "Copy";
                    name: root.data.log-selected-count > 1 ? "Copy " + root.data.log-selected-count + " selected records" : "Copy the record";
                    primary: false;
                    enabled: root.data.log-selected-count > 0;
                    clicked => {
                        root.copy-log();
                    }
                }
                // The Clear button: first press arms it in danger red; second press empties the list.
                log-clear := SettingsButton {
                    horizontal-stretch: 0;
                    rem-size: root.rem-size;
                    label-text: root.data.log-clear-armed ? "Confirm clear" : "Clear";
                    name: root.data.log-clear-armed ? "Confirm clearing the log records" : "Clear the log records";
                    primary: false;
                    danger: root.data.log-clear-armed;
                    enabled: root.data.log-rows.length > 0 || root.data.log-clear-armed;
                    clicked => {
                        root.clear-logs();
                    }
                }
            }

            // Table + content-fitted detail drawer stacked cleanly in a VerticalLayout.
            logs-body := VerticalLayout {
                x: 0px;
                y: logs-box.filter-height;
                width: parent.width;
                height: Math.max(0px, parent.height - logs-box.filter-height);
                spacing: root.data.log-detail.length > 0 ? 0.8 * root.rem-size : 0px;

                log-table-box := Rectangle {
                    vertical-stretch: 1;
                    min-height: 6 * root.rem-size;
                    border-radius: 0.75 * root.rem-size;
                    border-width: 1px;
                    border-color: #ffffff14;
                    background: #00000022;
                    clip: true;

                    property <length> header-height: 2.1 * root.rem-size;
                    property <bool> has-scroll: root.data.log-rows.length * logs-box.row-height > Math.max(0px, self.height - self.header-height);
                    property <length> rows-width: Math.max(0px, self.width - (self.has-scroll ? 8px : 0px));
                    property <length> source-width: Math.min(15 * root.rem-size, Math.max(9 * root.rem-size, self.rows-width * 0.27));

                    // Column header aligned to the exact geometry of `ModsLogRowView`.
                    log-header := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: log-table-box.header-height;
                        background: #ffffff08;

                        Text {
                            x: 0.75 * root.rem-size;
                            y: 0px;
                            width: 4.8 * root.rem-size;
                            height: parent.height;
                            text: "Time";
                            vertical-alignment: center;
                            font-size: 0.78 * root.rem-size;
                            font-weight: 600;
                            color: Theme.placeholder;
                        }
                        Text {
                            x: 6.15 * root.rem-size;
                            y: 0px;
                            width: log-table-box.source-width;
                            height: parent.height;
                            text: "Source";
                            overflow: elide;
                            vertical-alignment: center;
                            font-size: 0.78 * root.rem-size;
                            font-weight: 600;
                            color: Theme.placeholder;
                        }
                        Text {
                            x: 6.15 * root.rem-size + log-table-box.source-width + 0.6 * root.rem-size;
                            y: 0px;
                            width: 5.4 * root.rem-size;
                            height: parent.height;
                            text: "Level";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 0.78 * root.rem-size;
                            font-weight: 600;
                            color: Theme.placeholder;
                        }
                        Text {
                            x: 6.15 * root.rem-size + log-table-box.source-width + 6.8 * root.rem-size;
                            y: 0px;
                            width: Math.max(0px, log-table-box.rows-width - self.x - 0.75 * root.rem-size);
                            height: parent.height;
                            text: "Message";
                            overflow: elide;
                            vertical-alignment: center;
                            font-size: 0.78 * root.rem-size;
                            font-weight: 600;
                            color: Theme.placeholder;
                        }
                        Rectangle {
                            x: 0px;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: #ffffff14;
                        }
                    }

                    // The records: newest first. Supports click, Shift+click, Ctrl+click, and drag-slide
                    // selection via a persistent TouchArea over the rows (`interactive: false` keeps wheel
                    // scrolling while preventing Flickable from stealing vertical pointer drags).
                    log-rows := Flickable {
                        x: 0px;
                        y: log-table-box.header-height;
                        width: log-table-box.rows-width;
                        height: Math.max(0px, parent.height - log-table-box.header-height);
                        content-width: self.width;
                        content-height: root.data.log-rows.length * logs-box.row-height;
                        interactive: false;

                        for row[index] in root.data.log-rows: ModsLogRowView {
                            x: 0px;
                            y: index * logs-box.row-height;
                            width: log-rows.width;
                            rem-size: root.rem-size;
                            source-width: log-table-box.source-width;
                            record: row;
                            selected: row.selected;
                            active: row.id == root.data.log-open-id && root.data.log-open-id != 0;
                            hovered: log-drag-area.has-hover && index == log-drag-area.hover-index;
                        }

                        log-drag-area := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: log-rows.content-width;
                            height: Math.max(log-rows.height, log-rows.content-height);
                            property <length> row-height: logs-box.row-height;
                            property <int> hover-index: (self.has-hover && root.data.log-rows.length > 0 && self.mouse-y >= 0px && self.mouse-y < root.data.log-rows.length * self.row-height)
                                ? root.log-row-at(self.mouse-y, self.row-height, root.data.log-rows.length) : -1;
                            property <bool> dragging: false;
                            property <int> last-drag-index: -1;
                            property <length> drag-viewport-y: 0px;
                            mouse-cursor: self.hover-index >= 0 ? pointer : default;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    log-keys.focus();
                                    if (root.data.log-rows.length > 0 && self.mouse-y >= 0px && self.mouse-y < root.data.log-rows.length * self.row-height) {
                                        self.dragging = true;
                                        self.drag-viewport-y = self.mouse-y + log-rows.content-y;
                                        self.last-drag-index = root.log-row-at(self.mouse-y, self.row-height, root.data.log-rows.length);
                                        root.press-log(
                                            root.data.log-rows[self.last-drag-index].id,
                                            event.modifiers.shift,
                                            event.modifiers.control,
                                        );
                                    } else if (root.data.log-selected-count > 0 || root.data.log-open-id != 0 || root.data.log-clear-armed) {
                                        // Clicking empty space below the last row clears selection.
                                        root.close-log();
                                    }
                                } else if (event.kind == PointerEventKind.move && self.dragging && root.data.log-rows.length > 0) {
                                    self.drag-viewport-y = self.mouse-y + log-rows.content-y;
                                    if (log-rows.content-height > log-rows.height) {
                                        if (self.drag-viewport-y < 2 * self.row-height) {
                                            log-rows.content-y = Math.min(0px, log-rows.content-y + self.row-height * 0.5);
                                        } else if (self.drag-viewport-y > log-rows.height - 2 * self.row-height) {
                                            log-rows.content-y = Math.max(log-rows.height - log-rows.content-height, log-rows.content-y - self.row-height * 0.5);
                                        }
                                    }
                                    if (root.log-row-at(self.mouse-y, self.row-height, root.data.log-rows.length) != self.last-drag-index) {
                                        self.last-drag-index = root.log-row-at(self.mouse-y, self.row-height, root.data.log-rows.length);
                                        root.drag-log(root.data.log-rows[self.last-drag-index].id);
                                    }
                                } else if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && self.dragging) {
                                    self.dragging = false;
                                    if (self.last-drag-index >= 0 && self.last-drag-index < root.data.log-rows.length) {
                                        root.release-log(root.data.log-rows[self.last-drag-index].id);
                                    } else {
                                        root.release-log(0);
                                    }
                                    self.last-drag-index = -1;
                                }
                            }
                        }

                        // Continuous edge auto-scroll while holding a drag near the top or bottom edge.
                        drag-scroll-timer := Timer {
                            interval: 50ms;
                            running: log-drag-area.dragging && log-rows.content-height > log-rows.height && root.data.log-rows.length > 0;
                            triggered => {
                                if (log-drag-area.drag-viewport-y < 2 * logs-box.row-height && log-rows.content-y < 0px) {
                                    log-rows.content-y = Math.min(0px, log-rows.content-y + logs-box.row-height * 0.6);
                                    if (root.log-row-at(log-drag-area.drag-viewport-y - log-rows.content-y, logs-box.row-height, root.data.log-rows.length) != log-drag-area.last-drag-index) {
                                        log-drag-area.last-drag-index = root.log-row-at(log-drag-area.drag-viewport-y - log-rows.content-y, logs-box.row-height, root.data.log-rows.length);
                                        root.drag-log(root.data.log-rows[log-drag-area.last-drag-index].id);
                                    }
                                } else if (log-drag-area.drag-viewport-y > log-rows.height - 2 * logs-box.row-height
                                    && log-rows.content-y > log-rows.height - log-rows.content-height)
                                {
                                    log-rows.content-y = Math.max(log-rows.height - log-rows.content-height, log-rows.content-y - logs-box.row-height * 0.6);
                                    if (root.log-row-at(log-drag-area.drag-viewport-y - log-rows.content-y, logs-box.row-height, root.data.log-rows.length) != log-drag-area.last-drag-index) {
                                        log-drag-area.last-drag-index = root.log-row-at(log-drag-area.drag-viewport-y - log-rows.content-y, logs-box.row-height, root.data.log-rows.length);
                                        root.drag-log(root.data.log-rows[log-drag-area.last-drag-index].id);
                                    }
                                }
                            }
                        }
                    }

                    if root.data.log-rows.length == 0: log-empty := Text {
                        x: 1.5 * root.rem-size;
                        y: log-table-box.header-height;
                        width: Math.max(0px, parent.width - 3 * root.rem-size);
                        height: Math.max(3 * root.rem-size, parent.height - log-table-box.header-height);
                        text: root.data.log-empty;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 1.0 * root.rem-size;
                        color: ClassStyles.color-or(ClassStyles.mods-empty, Theme.placeholder);
                        opacity: ClassStyles.opacity-or(ClassStyles.mods-empty, 0.9);
                        visible: !ClassStyles.mods-empty.hidden;
                    }

                    ScrollBar {
                        x: parent.width - 8px;
                        y: log-table-box.header-height;
                        height: log-rows.height;
                        view-height: log-rows.height;
                        content-height: log-rows.content-height;
                        offset <=> log-rows.content-y;
                    }
                }

                // Content-fitted detail drawer: stays compact for 1-line records, expands and
                // scrolls up to 48% of the page height for long multi-line stack traces.
                if root.data.log-detail.length > 0: log-detail := Rectangle {
                    vertical-stretch: 0;
                    property <length> pad: 0.9 * root.rem-size;
                    property <length> header-height: 2.0 * root.rem-size;
                    property <length> body-top: self.pad + self.header-height + 0.7 * root.rem-size;
                    property <int> open-id: root.data.log-open-id;

                    height: Math.min(
                        Math.max(0px, logs-body.height * 0.48),
                        Math.min(
                            34 * root.rem-size,
                            Math.max(7.5 * root.rem-size, self.body-top + detail-body.preferred-height + self.pad + 0.5 * root.rem-size)
                        )
                    );
                    border-radius: 0.75 * root.rem-size;
                    border-width: 1px;
                    border-color: #ffffff1a;
                    background: ClassStyles.background-or(ClassStyles.mods-log-detail, Theme.overlay);
                    opacity: ClassStyles.opacity-or(ClassStyles.mods-log-detail, 1.0);
                    visible: !ClassStyles.mods-log-detail.hidden;

                    changed open-id => {
                        detail-scroll.content-y = 0px;
                    }

                    detail-heading := Text {
                        x: log-detail.pad;
                        y: log-detail.pad;
                        width: Math.max(0px, parent.width - 2 * log-detail.pad - 2.6 * root.rem-size);
                        height: log-detail.header-height;
                        text: root.data.log-detail-heading;
                        overflow: elide;
                        vertical-alignment: center;
                        font-size: 0.85 * root.rem-size;
                        font-weight: 600;
                        color: ClassStyles.color-or(ClassStyles.mods-log-detail-text, Theme.text);
                        opacity: ClassStyles.opacity-or(ClassStyles.mods-log-detail-text, 1.0);
                        visible: !ClassStyles.mods-log-detail-text.hidden;
                    }
                    detail-close := Rectangle {
                        x: parent.width - log-detail.pad - self.width;
                        y: log-detail.pad;
                        width: log-detail.header-height;
                        height: log-detail.header-height;
                        border-radius: self.width / 2;
                        background: detail-close-touch.has-hover ? #ffffff24 : #ffffff10;

                        Image {
                            source: @image-url("icons/close.svg");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 1.0 * root.rem-size;
                            height: self.width;
                            colorize: Theme.text;
                            opacity: detail-close-touch.has-hover ? 1.0 : 0.75;
                        }
                        detail-close-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Close the record";
                            clicked => {
                                root.close-log();
                            }
                        }
                    }
                    Rectangle {
                        x: log-detail.pad;
                        y: log-detail.pad + log-detail.header-height + 0.35 * root.rem-size;
                        width: Math.max(0px, parent.width - 2 * log-detail.pad);
                        height: 1px;
                        background: #ffffff14;
                    }

                    // The text, wrapped and scrolling: a message keeps its own line breaks, and a long
                    // one can be read to the end.
                    detail-scroll := Flickable {
                        x: 0px;
                        y: log-detail.body-top;
                        width: parent.width - 8px;
                        height: Math.max(0px, parent.height - log-detail.body-top - log-detail.pad);
                        content-width: self.width;
                        content-height: detail-body.preferred-height + 0.4 * root.rem-size;

                        detail-body := VerticalLayout {
                            x: log-detail.pad;
                            width: Math.max(0px, detail-scroll.width - 2 * log-detail.pad);
                            spacing: 0.25 * root.rem-size;

                            for line[index] in root.data.log-detail: Text {
                                text: line;
                                wrap: word-wrap;
                                font-size: 0.85 * root.rem-size;
                                color: ClassStyles.color-or(ClassStyles.mods-log-detail-text, Theme.text);
                                opacity: ClassStyles.opacity-or(ClassStyles.mods-log-detail-text, 1.0);
                                visible: !ClassStyles.mods-log-detail-text.hidden;
                            }
                        }
                    }
                    ScrollBar {
                        x: parent.width - 8px;
                        y: log-detail.body-top;
                        height: Math.max(0px, parent.height - log-detail.body-top - log-detail.pad);
                        view-height: self.height;
                        content-height: detail-scroll.content-height;
                        offset <=> detail-scroll.content-y;
                    }
                }
            }
        }


        // ---- About ----------------------------------------------------------------------
        // What this build is, where it keeps the two folders, what is installed, and the one
        // button that writes a diagnostics file. Nothing here deletes anything.
        // ---- About ----------------------------------------------------------------------
        // What this build is, where it keeps the two folders, what is installed, and the one
        // button that writes a diagnostics file. Nothing here deletes anything. The sections are
        // laid out by hand rather than by a nested layout: the page scrolls as one, and a layout
        // inside a layout cannot ask its parent how tall it is without a loop.
        if root.on-about: Rectangle {
            x: root.page-padding;
            y: root.list-top;
            width: root.page-width;
            height: Math.max(root.height - root.list-top, 0px);

            property <length> about-row: 2.2 * root.rem-size;
            property <length> about-build-height: root.data.about-build.length * about-row;
            property <length> about-places-height: root.data.about-places.length * about-row
                + (root.data.about-export == "" ? 0px : about-row);
            property <length> about-counts-height: root.data.about-counts.length * about-row;
            property <length> about-enabled-height: root.data.about-enabled.length * about-row;

            about-actions := HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 3 * root.rem-size;
                spacing: 1.2 * root.rem-size;
                alignment: start;

                SettingsButton {
                    rem-size: root.rem-size;
                    label-text: "Refresh";
                    name: "Refresh the About page";
                    primary: false;
                    enabled: true;
                    clicked => {
                        root.refresh-about();
                    }
                }
                SettingsButton {
                    rem-size: root.rem-size;
                    label-text: "Export diagnostics";
                    name: "Export diagnostics";
                    primary: true;
                    enabled: true;
                    clicked => {
                        root.export-diagnostics();
                    }
                }
                SettingsButton {
                    rem-size: root.rem-size;
                    label-text: "Copy version";
                    name: "Copy the version";
                    primary: false;
                    enabled: true;
                    clicked => {
                        root.copy-version();
                    }
                }
            }

            about-body := Flickable {
                x: 0px;
                y: about-actions.y + about-actions.height + 1.2 * root.rem-size;
                width: parent.width - 8px;
                height: Math.max(0px, parent.height - self.y);
                content-width: self.width;
                content-height: (about-counts.y + about-counts-height)
                    + (about-enabled.y - about-counts.y - about-counts-height)
                    + (about-license.y - about-enabled.y - about-enabled-height)
                    + about-license.height;

                for entry[index] in root.data.about-build: ModsAboutRow {
                    x: 0px;
                    y: index * about-row;
                    width: about-body.width;
                    rem-size: root.rem-size;
                    entry: entry;
                }
                about-places := VerticalLayout {
                    x: 0px;
                    y: about-build-height + 1.4 * root.rem-size;
                    width: parent.width;
                    height: about-places-height;

                    for entry[index] in root.data.about-places: ModsAboutRow {
                        entry: entry;
                        rem-size: root.rem-size;
                    }
                    if root.data.about-export != "": ModsAboutRow {
                        entry: { label: "Diagnostics file", value: root.data.about-export };
                        rem-size: root.rem-size;
                    }
                }
                about-counts := VerticalLayout {
                    x: 0px;
                    y: about-places.y + about-places.height + 1.4 * root.rem-size;
                    width: parent.width;
                    height: about-counts-height;

                    for entry[index] in root.data.about-counts: ModsAboutRow {
                        entry: entry;
                        rem-size: root.rem-size;
                    }
                }
                about-enabled := VerticalLayout {
                    x: 0px;
                    y: about-counts.y + about-counts.height + 1.4 * root.rem-size;
                    width: parent.width;
                    height: about-enabled-height;

                    for entry[index] in root.data.about-enabled: ModsAboutRow {
                        entry: entry;
                        rem-size: root.rem-size;
                    }
                }
                about-license := Text {
                    x: 0px;
                    y: about-enabled.y + about-enabled.height + 1.4 * root.rem-size;
                    width: parent.width;
                    height: 2.4 * root.rem-size;
                    text: root.data.about-license;
                    wrap: word-wrap;
                    font-size: 0.9 * root.rem-size;
                    color: ClassStyles.color-or(ClassStyles.mods-about-value, Theme.placeholder);
                    visible: !ClassStyles.mods-about-value.hidden;
                }
            }
            ScrollBar {
                x: parent.width - 8px;
                y: about-body.y;
                height: about-body.height;
                view-height: about-body.height;
                content-height: about-body.content-height;
                offset <=> about-body.content-y;
            }
        }
    }
}
