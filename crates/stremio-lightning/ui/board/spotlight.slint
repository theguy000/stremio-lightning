// Based on stremio-web src/routes/Board/Spotlight (Copyright Smart code 203358507).
import { Theme } from "../theme.slint";
import { CoverImage } from "../settings/spotlight-card.slint";
import { SpotlightPager } from "spotlight-pager.slint";
import { SpotlightSlide, SpotlightSlideContent } from "spotlight-slide.slint";

export { SpotlightSlide }

export component BoardSpotlight inherits Rectangle {
    in property <[SpotlightSlide]> slides;
    in property <[string]> slide-labels;
    in property <length> rem-size: 14px;
    in property <length> nav-width: 6 * 14px;
    in property <length> bar-height: 5.5 * 14px;
    callback open-item(string, string, string);
    callback toggle-library(string, string, bool);
    callback open-trailer(string);

    in-out property <int> active-index: 0;
    in-out property <bool> paused: false;
    property <int> prev-index: -1;
    property <float> prev-scale: 1.0;
    property <int> zoom-ms: 0;
    property <int> cycle-ms: 0;

    property <int> count: root.slides.length;
    property <int> safe-idx: root.count == 0 ? 0 : Math.mod(root.active-index + root.count, root.count);
    property <SpotlightSlide> current: root.slides[root.safe-idx];

    // Ease-out cubic 1.06 -> 1.0 over 14s matching Spotlight.less `transform 14s ease-out`.
    property <float> zoom-t: Math.min(1.0, root.zoom-ms / 14000.0);
    property <float> zoom-inv: 1.0 - root.zoom-t;
    property <float> active-scale: 1.06 - 0.06 * (1.0 - root.zoom-inv * root.zoom-inv * root.zoom-inv);
    // Slide content gentle fade + rise on transitions matching Slide.less (0.18s delay, 0.45s fade).
    property <float> enter-t: root.prev-index < 0 ? 1.0 : Math.min(1.0, Math.max(0.0, (root.zoom-ms - 140) / 420.0));
    property <float> enter-inv: 1.0 - root.enter-t;
    property <float> enter-ease: 1.0 - root.enter-inv * root.enter-inv * root.enter-inv;
    property <float> cycle-progress: Math.min(1.0, root.cycle-ms / 8000.0);
    property <bool> is-hovered: hover-area.has-hover || slide-content.hovered || pager.hovered;
    property <length> content-bottom: 6 * root.rem-size;
    property <length> pager-bottom: 6.6 * root.rem-size;
    property <color> fade-base: Theme.amoled ? #000000 : #121024;
    property <color> scrim-base: Theme.amoled ? #000000 : #0c0b11;

    function go(next: int, manual: bool) {
        if (root.count == 0) {
            return;
        }
        root.prev-index = root.safe-idx;
        root.prev-scale = root.active-scale;
        root.active-index = Math.mod(next + root.count, root.count);
        root.zoom-ms = 0;
        root.cycle-ms = 0;
        if (manual) {
            root.paused = true;
        }
    }

    background: transparent;
    clip: true;

    // 60fps driver for the 14s zoom-out animation and the 8s pager fill timer.
    // Zoom runs continuously on the active slide; cycle fill pauses on hover and manual pause.
    anim-timer := Timer {
        interval: 16ms;
        running: root.count > 0 && (root.zoom-ms < 14000 || (root.count > 1 && !root.paused && !root.is-hovered));
        triggered => {
            if (root.zoom-ms < 14000) {
                root.zoom-ms = Math.min(14000, root.zoom-ms + 16);
            }
            if (root.count > 1 && !root.paused && !root.is-hovered) {
                root.cycle-ms += 16;
                if (root.cycle-ms >= 8000) {
                    root.go(root.safe-idx + 1, false);
                }
            }
        }
    }

    // Crossfading zoom-out backdrop stack (active fades in over 0.9s while zooming 1.06 -> 1.0).
    for slide[i] in root.slides: Rectangle {
        property <bool> is-active: i == root.safe-idx;
        property <float> s: self.is-active ? root.active-scale : (i == root.prev-index ? root.prev-scale : 1.06);
        width: parent.width;
        height: parent.height;
        opacity: self.is-active ? 1.0 : 0.0;
        animate opacity { duration: 900ms; easing: ease; }

        if slide.has-background: CoverImage {
            width: parent.width * s;
            height: parent.height * s;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: slide.background;
            pos-x: 0.72;
            pos-y: 0.22;
        }
    }

    // Left horizontal scrim behind VerticalNavBar + text stack (matches Spotlight.less).
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(
            90deg,
            root.scrim-base.with-alpha(0.88) 0%,
            root.scrim-base.with-alpha(0.70) 22%,
            root.scrim-base.with-alpha(0.38) 42%,
            root.scrim-base.with-alpha(0.10) 60%,
            root.scrim-base.with-alpha(0.0) 74%
        );
    }

    // Top fade under HorizontalNavBar (matches Spotlight.less mask top ramp).
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.bar-height + 2.5 * root.rem-size;
        background: @linear-gradient(
            180deg,
            root.scrim-base.with-alpha(0.82) 0%,
            root.scrim-base.with-alpha(0.32) 55%,
            root.scrim-base.with-alpha(0.0) 100%
        );
    }

    // Bottom fade into Continue Watching and page background (matches Spotlight.less 68% -> 100% ramp).
    Rectangle {
        x: 0px;
        y: parent.height * 0.56;
        width: parent.width;
        height: parent.height * 0.44;
        background: @linear-gradient(
            180deg,
            root.fade-base.with-alpha(0.0) 0%,
            root.fade-base.with-alpha(0.45) 46%,
            root.fade-base.with-alpha(0.86) 78%,
            root.fade-base 100%
        );
    }

    hover-area := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    slide-content := SpotlightSlideContent {
        x: root.nav-width + 2 * root.rem-size;
        y: parent.height - self.height - root.content-bottom + (1.0 - root.enter-ease) * 0.75 * root.rem-size;
        width: Math.max(18 * root.rem-size, Math.min(40 * root.rem-size, parent.width - root.nav-width - 22 * root.rem-size));
        opacity: root.enter-t;
        current: root.current;
        rem-size: root.rem-size;
        open-item(id, kind, title) => { root.open-item(id, kind, title); }
        toggle-library(id, kind, in-lib) => { root.toggle-library(id, kind, in-lib); }
        open-trailer(url) => { root.open-trailer(url); }
    }

    pager := SpotlightPager {
        visible: root.count > 1;
        x: parent.width - self.width - 2 * root.rem-size;
        y: parent.height - self.height - root.pager-bottom;
        labels: root.slide-labels;
        active-index: root.safe-idx;
        stopped: root.paused;
        progress: root.cycle-progress;
        rem-size: root.rem-size;
        select(i) => { root.go(i, true); }
        previous => { root.go(root.safe-idx - 1, true); }
        next => { root.go(root.safe-idx + 1, true); }
        toggle-pause => {
            root.paused = !root.paused;
            if (!root.paused) {
                root.cycle-ms = 0;
            }
        }
    }
}
