// Style overrides keyed by the stremio-web class names.
//
// A theme (`*.theme.css`, see ../src/class_styles.rs) is parsed on startup and written into
// `ClassStyles`, one entry per element. An element that reuses a web class name reads its entry
// and falls back to its own default when the theme says nothing:
//
//     background: ClassStyles.background-or(ClassStyles.header-container, transparent);
//
// `hidden` hides the element but keeps its layout space, like `visibility: hidden` on the web.
// Each element honours only the properties that make sense for it; ../THEMES.md lists which.
// The others are accepted and ignored. An element that carries several web classes still has one
// entry, named after its id; ../src/class_styles.rs lists the classes of each in `elements!` and
// applies the rules in file order.

export struct ClassStyle {
    has-color: bool,
    color: color,
    has-background: bool,
    background: color,
    has-opacity: bool,
    opacity: float,
    hidden: bool,
}

export global ClassStyles {
    in property <ClassStyle> board-row;
    in property <ClassStyle> header-container;
    in property <ClassStyle> title-container;
    in property <ClassStyle> see-all-container;
    in property <ClassStyle> meta-items-container;
    in property <ClassStyle> meta-item-link;
    in property <ClassStyle> poster-container;
    in property <ClassStyle> poster-image;
    in property <ClassStyle> title-bar-container;
    in property <ClassStyle> title-label;
    in property <ClassStyle> horizontal-nav-bar-container;
    in property <ClassStyle> logo-container;
    in property <ClassStyle> logo;
    in property <ClassStyle> search-bar-container;
    in property <ClassStyle> search-input;
    in property <ClassStyle> placeholder-label;
    in property <ClassStyle> submit-button-container;
    in property <ClassStyle> buttons-container;
    in property <ClassStyle> button-container;
    in property <ClassStyle> menu-toggle;
    in property <ClassStyle> avatar;
    in property <ClassStyle> vertical-nav-bar-container;
    in property <ClassStyle> nav-tab-button-container;
    in property <ClassStyle> icon;
    in property <ClassStyle> select-input;
    in property <ClassStyle> dropdown;
    in property <ClassStyle> option;
    in property <ClassStyle> placeholder;
    in property <ClassStyle> title;
    in property <ClassStyle> image-container;
    in property <ClassStyle> image;
    in property <ClassStyle> overview;
    in property <ClassStyle> point;
    in property <ClassStyle> text;
    in property <ClassStyle> button;
    in property <ClassStyle> label;
    in property <ClassStyle> addon;
    in property <ClassStyle> selectable-inputs-container;
    in property <ClassStyle> add-button-container;
    in property <ClassStyle> add-button-label;
    in property <ClassStyle> info-container;
    in property <ClassStyle> name-container;
    in property <ClassStyle> version-container;
    in property <ClassStyle> types-container;
    in property <ClassStyle> description-container;
    in property <ClassStyle> action-buttons-container;
    in property <ClassStyle> uninstall-button-container;
    in property <ClassStyle> install-button-container;
    in property <ClassStyle> share-button-container;
    in property <ClassStyle> search;
    in property <ClassStyle> message-container;
    in property <ClassStyle> menu;
    in property <ClassStyle> version-info-label;
    in property <ClassStyle> sections-container;
    in property <ClassStyle> section;
    in property <ClassStyle> user;
    in property <ClassStyle> avatar-container;
    in property <ClassStyle> email-label;
    in property <ClassStyle> link;

    // Details screen: the Episodes column and one Episode row.
    in property <ClassStyle> videos-list-container;
    in property <ClassStyle> video-container;

    // Intro & authentication overlay
    in property <ClassStyle> intro-container;
    in property <ClassStyle> background-container;
    in property <ClassStyle> close-button-container;
    in property <ClassStyle> heading-container;
    in property <ClassStyle> slogan-container;
    in property <ClassStyle> content-container;
    in property <ClassStyle> form-container;
    in property <ClassStyle> credentials-text-input;
    in property <ClassStyle> forgot-password-link-container;
    in property <ClassStyle> forgot-password-link;
    in property <ClassStyle> error-message;
    in property <ClassStyle> submit-button;
    in property <ClassStyle> checkbox-container;
    in property <ClassStyle> checkbox;
    in property <ClassStyle> options-container;
    in property <ClassStyle> facebook-button;
    in property <ClassStyle> apple-button;
    in property <ClassStyle> login-form-button;
    in property <ClassStyle> signup-form-button;
    in property <ClassStyle> guest-login-button;

    // Mods section: the page menu, one menu button, a page's content, its title and one card.
    // The card's own pieces are the ones the Addons card uses, so a theme that reaches addons
    // reaches plugins and themes too.
    in property <ClassStyle> mods-menu-container;
    in property <ClassStyle> mods-menu-button;
    in property <ClassStyle> mods-content;
    in property <ClassStyle> mods-page-title;
    /// The one sentence above each page's list: what the switch does, or that no theme is on.
    in property <ClassStyle> mods-page-note;
    in property <ClassStyle> mod-card;

    // The building blocks of a mod card, named for the Mods section rather than reused from
    // Addons: an enabled plugin and an installed addon are different things, and a theme should
    // be able to reach one without the other.
    in property <ClassStyle> mod-title;
    in property <ClassStyle> mod-byline;
    in property <ClassStyle> mod-description;
    in property <ClassStyle> mod-warning;
    in property <ClassStyle> mod-notice;
    in property <ClassStyle> mod-toggle-container;
    in property <ClassStyle> mod-toggle;
    in property <ClassStyle> mod-remove-button;
    in property <ClassStyle> mod-remove-button-label;
    /// "No plugins are installed." and the same line on Themes.
    in property <ClassStyle> mods-empty;

    // The Marketplace page and the buttons that update the installed mods.
    /// One card of a registry entry.
    in property <ClassStyle> market-card;
    in property <ClassStyle> market-title;
    in property <ClassStyle> market-byline;
    in property <ClassStyle> market-description;
    /// The "Plugins" and "Themes" headings of the Marketplace list.
    in property <ClassStyle> market-heading;
    /// A card's Update line, and the Update button on a Plugins or Themes card.
    in property <ClassStyle> mod-update;
    /// Install, Uninstall, Update, Update all and Check for updates.
    in property <ClassStyle> market-button;
    in property <ClassStyle> market-button-label;

    // The Logs page: the filter's pills, one record's four columns, and the box the full text of
    // a record opens in.
    in property <ClassStyle> mods-log-filter;
    in property <ClassStyle> mods-log-time;
    in property <ClassStyle> mods-log-source;
    in property <ClassStyle> mods-log-level;
    in property <ClassStyle> mods-log-text;
    in property <ClassStyle> mods-log-detail;
    in property <ClassStyle> mods-log-detail-text;

    // The About page: one row's label and its value.
    in property <ClassStyle> mods-about-label;
    in property <ClassStyle> mods-about-value;

    pure public function color-or(style: ClassStyle, fallback: color) -> color {
        return style.has-color ? style.color : fallback;
    }

    pure public function background-or(style: ClassStyle, fallback: color) -> color {
        return style.has-background ? style.background : fallback;
    }

    pure public function opacity-or(style: ClassStyle, fallback: float) -> float {
        return style.has-opacity ? style.opacity : fallback;
    }
}
