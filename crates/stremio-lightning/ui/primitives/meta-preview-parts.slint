import { Theme } from "../theme.slint";

export struct LinkGroup {
    label: string,
    links: [string],
}

export struct PreviewData {
    title: string,
    runtime: string,
    release-info: string,
    rating: string,
    description: string,
    groups: [LinkGroup],
    has-trailer: bool,
    logo: image,
    has-logo: bool,
    background: image,
    has-background: bool,
    panel-backdrop: image,
    has-panel-backdrop: bool,
    in-library: bool,
    watched: bool,
}

export component CoverRightImage inherits Rectangle {
    in property <image> source;
    in property <float> image-opacity: 0.3;
    in property <bool> align-right: true;
    clip: true;

    property <length> source-width: root.source.width * 1px;
    property <length> source-height: root.source.height * 1px;
    property <float> fill-scale: Math.max(
        root.source-width > 0px ? root.width / root.source-width : 1,
        root.source-height > 0px ? root.height / root.source-height : 1);
    property <length> drawn-width: root.source-width * root.fill-scale;
    property <length> drawn-height: root.source-height * root.fill-scale;

    if root.source-width > 0px && root.source-height > 0px: Image {
        x: root.align-right ? parent.width - root.drawn-width : (parent.width - root.drawn-width) / 2;
        y: (parent.height - root.drawn-height) / 2;
        width: root.drawn-width;
        height: root.drawn-height;
        source: root.source;
        image-fit: fill;
        opacity: root.image-opacity;
    }
}

component PreviewPill inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + 2 * (1.25 * root.rem-size + 2px);
    height: 2.4 * root.rem-size;
    border-radius: 2 * root.rem-size;
    background: Theme.overlay;

    label := Text {
        x: 1.25 * root.rem-size + 2px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        overflow: elide;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
    }
}

export component PreviewLinks inherits VerticalLayout {
    in property <LinkGroup> group;
    in property <length> rem-size;
    spacing: 0px;
    padding-top: 1.5 * root.rem-size;

    label-container := Rectangle {
        height: 2 * root.rem-size;
        Text {
            x: 0px;
            y: 0px;
            height: 1.25 * root.rem-size;
            text: root.group.label;
            vertical-alignment: center;
            font-size: 0.95 * root.rem-size;
            font-weight: 700;
            color: Theme.text;
            opacity: 0.3;
        }
    }
    links-container := FlexboxLayout {
        spacing-horizontal: 0.75 * root.rem-size;
        spacing-vertical: 0.75 * root.rem-size;
        alignment: start;

        for link in root.group.links: link-container := PreviewPill {
            text: link;
            rem-size: root.rem-size;
        }
    }
    Rectangle { height: 0.75 * root.rem-size; }
}

export component InfoLabel inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width;

    label := Text {
        x: 0px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 1.25 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
    }
}

export component ImdbButton inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + root.rem-size + 3 * root.rem-size + 2 * (0.5 * root.rem-size + 2px);

    label := Text {
        x: 0.5 * root.rem-size + 2px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 1.25 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
    }
    icon := Image {
        source: @image-url("../icons/imdb.svg");
        colorize: Theme.imdb;
        x: label.x + label.preferred-width + root.rem-size;
        y: (parent.height - self.height) / 2;
        width: 3 * root.rem-size;
        height: 3 * root.rem-size;
    }
}

export component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> tooltip: false;
    in property <bool> accent-hover: false;
    in property <length> rem-size;
    callback clicked;

    height: 4 * root.rem-size;
    width: root.label == "" || root.tooltip ? 4 * root.rem-size
        : 4 * root.rem-size + 1.75 * root.rem-size + root.rem-size + text.preferred-width + 0.4 * root.rem-size;
    border-radius: 4 * root.rem-size;
    background: !action-touch.has-hover ? Theme.overlay
        : root.accent-hover ? Theme.accent-green : transparent;
    border-width: action-touch.has-hover ? 2px : 0px;
    border-color: Theme.text;

    icon-container := Image {
        source: root.icon;
        colorize: Theme.text;
        opacity: 0.9;
        width: 1.75 * root.rem-size;
        height: 1.75 * root.rem-size;
        x: root.label == "" || root.tooltip ? (parent.width - self.width) / 2 : 2 * root.rem-size;
        y: (parent.height - self.height) / 2;
    }
    text := Text {
        visible: root.label != "" && !root.tooltip;
        x: 2 * root.rem-size + 1.75 * root.rem-size + root.rem-size + 0.2 * root.rem-size;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
        opacity: 0.9;
    }

    if root.tooltip && action-touch.has-hover: tooltip-bubble := Rectangle {
        x: (parent.width - self.width) / 2;
        y: -3.5 * root.rem-size;
        width: tooltip-label.preferred-width + 3 * root.rem-size;
        height: 2.5 * root.rem-size;
        border-radius: 0.75 * root.rem-size;
        background: Theme.modal-background;
        drop-shadow-color: Theme.outer-glow;
        drop-shadow-blur: 15px;

        tooltip-label := Text {
            x: 1.5 * root.rem-size;
            height: parent.height;
            vertical-alignment: center;
            text: root.label;
            font-size: root.rem-size;
            color: Theme.text;
        }
    }

    action-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DualIconPill inherits Rectangle {
    in property <image> left-icon;
    in property <image> right-icon;
    in property <bool> enabled: true;
    in property <bool> hover-dim: false;
    in property <length> rem-size;
    callback left-clicked;
    callback right-clicked;

    width: 8 * root.rem-size;
    height: 4 * root.rem-size;
    border-radius: 2 * root.rem-size;
    background: Theme.overlay;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4 * root.rem-size;
        height: 4 * root.rem-size;
        border-radius: 2 * root.rem-size;
        background: left-touch.has-hover && root.enabled ? Theme.surface-medium : transparent;

        Image {
            x: (4 * root.rem-size - self.width) / 2;
            y: (4 * root.rem-size - self.height) / 2;
            width: 1.75 * root.rem-size;
            height: 1.75 * root.rem-size;
            source: root.left-icon;
            colorize: Theme.text;
            opacity: root.hover-dim ? (left-touch.has-hover ? 1.0 : 0.7) : (root.enabled ? 0.9 : 0.4);
        }
        left-touch := TouchArea {
            width: 4 * root.rem-size;
            height: 4 * root.rem-size;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.left-clicked(); }
        }
    }
    Rectangle {
        x: 4 * root.rem-size;
        y: 0px;
        width: 4 * root.rem-size;
        height: 4 * root.rem-size;
        border-radius: 2 * root.rem-size;
        background: right-touch.has-hover && root.enabled ? Theme.surface-medium : transparent;

        Image {
            x: (4 * root.rem-size - self.width) / 2;
            y: (4 * root.rem-size - self.height) / 2;
            width: 1.75 * root.rem-size;
            height: 1.75 * root.rem-size;
            source: root.right-icon;
            colorize: Theme.text;
            opacity: root.hover-dim ? (right-touch.has-hover ? 1.0 : 0.7) : (root.enabled ? 0.9 : 0.4);
        }
        right-touch := TouchArea {
            width: 4 * root.rem-size;
            height: 4 * root.rem-size;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.right-clicked(); }
        }
    }
}
