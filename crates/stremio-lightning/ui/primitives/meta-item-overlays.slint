import { Theme } from "../theme.slint";

export component CardMenuOption inherits Rectangle {
    in property <string> label;
    in property <string> action;
    in property <length> rem-size;
    callback picked(string);

    height: label-text.preferred-height + 2 * root.rem-size;
    background: touch.has-hover ? Theme.option-hover : transparent;

    label-text := Text {
        x: 1.5 * root.rem-size;
        width: parent.width - 3 * root.rem-size;
        y: 1 * root.rem-size;
        height: parent.height - 2 * root.rem-size;
        text: root.label;
        vertical-alignment: center;
        wrap: word-wrap;
        font-size: 1 * root.rem-size;
        color: Theme.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(root.action); }
    }
}

export component PosterProgressBar inherits Rectangle {
    in property <float> progress;
    in property <length> rem-size;

    height: 0.45 * root.rem-size;
    border-radius: self.height / 2;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.text;
        opacity: 0.3;
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * Math.min(Math.max(root.progress, 0), 100) / 100;
        height: parent.height;
        background: Theme.text;
    }
}

export component WatchedBadge inherits Rectangle {
    in property <length> rem-size;

    width: 1.5 * root.rem-size;
    height: self.width;
    border-radius: self.width / 2;
    background: Theme.accent;

    Path {
        x: 0.35 * root.rem-size;
        y: 0.35 * root.rem-size;
        width: parent.width - 0.7 * root.rem-size;
        height: parent.height - 0.7 * root.rem-size;
        viewbox-width: 512;
        viewbox-height: 512;
        commands: "M421 128 L197 384 L101 288";
        fill: transparent;
        stroke: Theme.text;
        stroke-width: 0.12 * root.rem-size;
    }
}

export component NewVideosBadge inherits Rectangle {
    in property <int> count;
    in property <length> rem-size;

    Rectangle {
        x: parent.width - 2.25 * root.rem-size - 0.5 * root.rem-size;
        y: 0.5 * root.rem-size;
        width: 2.25 * root.rem-size;
        height: 1.25 * root.rem-size;
        border-radius: 0.25 * root.rem-size;
        background: Theme.text;
        opacity: 0.4;
    }
    Rectangle {
        x: parent.width - 2.25 * root.rem-size - 0.75 * root.rem-size;
        y: 0.75 * root.rem-size;
        width: 2.25 * root.rem-size;
        height: 1.25 * root.rem-size;
        border-radius: 0.25 * root.rem-size;
        background: Theme.text;
        opacity: 0.6;
    }
    Rectangle {
        x: parent.width - 2.25 * root.rem-size - 1 * root.rem-size;
        y: 1 * root.rem-size;
        width: 2.25 * root.rem-size;
        height: 1.25 * root.rem-size;
        border-radius: 0.25 * root.rem-size;
        background: Theme.text;

        Path {
            x: 0.35 * root.rem-size;
            y: (parent.height - self.height) / 2;
            width: 0.8 * root.rem-size;
            height: self.width;
            viewbox-width: 512;
            viewbox-height: 512;
            commands: "M256 112 L256 400 M112 256 L400 256";
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 0.08 * root.rem-size;
        }
        Text {
            x: 1.15 * root.rem-size;
            width: parent.width - 1.3 * root.rem-size;
            height: parent.height;
            text: "+\{root.count}";
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 0.8 * root.rem-size;
            font-weight: 600;
            color: Theme.accent;
        }
    }
}

export component PlayOverlayButton inherits Rectangle {
    in property <length> rem-size;
    in property <bool> card-hovered;
    out property <bool> has-hover: play-touch.has-hover;
    callback clicked();

    width: 4 * root.rem-size;
    height: self.width;
    border-radius: self.width / 2;
    background: root.card-hovered ? Theme.accent-green : Theme.background;
    opacity: root.card-hovered ? 1.0 : 0.4;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        border-width: 0.15 * root.rem-size;
        border-color: root.card-hovered ? transparent : Theme.text;
    }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 2.25 * root.rem-size;
        height: self.width;
        source: @image-url("../icons/play.svg");
        colorize: Theme.text;
    }
    play-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DismissOverlayButton inherits Rectangle {
    in property <length> rem-size;
    in property <bool> card-hovered;
    out property <bool> has-hover: dismiss-touch.has-hover;
    callback clicked();

    width: 1.5 * root.rem-size;
    height: self.width;
    opacity: root.card-hovered ? 1.0 : 0.0;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        background: Theme.background;
        opacity: dismiss-touch.has-hover ? 0.85 : 0.6;
    }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1.25 * root.rem-size;
        height: self.width;
        source: @image-url("../icons/close.svg");
        colorize: Theme.text;
        opacity: dismiss-touch.has-hover ? 1.0 : 0.8;
    }
    dismiss-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MenuOverlayButton inherits Rectangle {
    in property <length> rem-size;
    in property <bool> show-dots;
    out property <bool> has-hover: menu-touch.has-hover;
    callback clicked();

    width: 1.5 * root.rem-size;
    height: 4 * root.rem-size;

    Image {
        x: 0px;
        y: 1.25 * root.rem-size;
        width: 1.5 * root.rem-size;
        height: 1.5 * root.rem-size;
        source: @image-url("../icons/more-vertical.svg");
        colorize: Theme.text;
        opacity: root.show-dots ? 0.6 : 0.0;
    }
    menu-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
