// Based on stremio-web Settings Streaming page (URLsManager + Server options + Offline notice).
import { Theme } from "../theme.slint";
import { SettingsGroup, SettingsPageHeader, SettingsRow, SettingsRowButton } from "primitives.slint";
import { SettingsSelectControl } from "scale.slint";
import { ServerUrlsCard } from "streaming-urls.slint";
import { SettingsUi } from "types.slint";

export component StreamingPage inherits VerticalLayout {
    in property <length> rem-size;
    alignment: start;

    SettingsPageHeader { title: "Streaming"; rem-size: root.rem-size; }

    ServerUrlsCard { rem-size: root.rem-size; }

    if SettingsUi.data.remote-url != "": SettingsGroup {
        rem-size: root.rem-size;
        SettingsRow {
            rem-size: root.rem-size;
            label: "Remote URL";
            description: SettingsUi.data.remote-url;
            first: true;
            last: true;
            highlighted: SettingsUi.hit-row == "remoteUrl";
            SettingsRowButton {
                rem-size: root.rem-size;
                label: "Copy";
                clicked => { SettingsUi.copy-remote-url(); }
            }
        }
    }

    if SettingsUi.data.server-online: SettingsGroup {
        title: "Server options";
        description: SettingsUi.data.remote-url != "" ? "Devices that use the Remote URL get these options too." : "";
        rem-size: root.rem-size;

        if SettingsUi.data.has-https-endpoint: SettingsRow {
            rem-size: root.rem-size; label: "Streaming HTTPS endpoint"; first: true; highlighted: SettingsUi.hit-row == "https";
            SettingsSelectControl {
                rem-size: root.rem-size; input: SettingsUi.data.https-endpoint; fallback-title: "Disabled";
                opacity: SettingsUi.data.cache-root-updating ? 0.5 : 1.0;
                select(o) => { if (!SettingsUi.data.cache-root-updating) { SettingsUi.select-option("remoteHttps", o); } }
            }
        }
        SettingsRow {
            rem-size: root.rem-size; label: "Cache size"; first: !SettingsUi.data.has-https-endpoint; highlighted: SettingsUi.hit-row == "cache";
            SettingsSelectControl {
                rem-size: root.rem-size; input: SettingsUi.data.caching; fallback-title: "2 GiB";
                opacity: SettingsUi.data.cache-root-updating ? 0.5 : 1.0;
                select(o) => { if (!SettingsUi.data.cache-root-updating) { SettingsUi.select-option("caching", o); } }
            }
        }
        if SettingsUi.data.has-cache-root: SettingsRow {
            rem-size: root.rem-size;
            label: "Caching drive";
            description: SettingsUi.data.cache-root-error != "" ? SettingsUi.data.cache-root-error : SettingsUi.data.cache-root-path;
            highlighted: SettingsUi.hit-row == "drive";
            SettingsSelectControl {
                rem-size: root.rem-size;
                input: SettingsUi.data.cache-root;
                fallback-title: "Default";
                opacity: SettingsUi.data.cache-root-updating ? 0.5 : 1.0;
                select(o) => { if (!SettingsUi.data.cache-root-updating) { SettingsUi.select-cache-root(o); } }
            }
        }
        SettingsRow {
            rem-size: root.rem-size; label: "Torrent profile"; highlighted: SettingsUi.hit-row == "torrent";
            SettingsSelectControl {
                rem-size: root.rem-size; input: SettingsUi.data.torrent-profile; fallback-title: "Default";
                opacity: SettingsUi.data.cache-root-updating ? 0.5 : 1.0;
                select(o) => { if (!SettingsUi.data.cache-root-updating) { SettingsUi.select-option("torrentProfile", o); } }
            }
        }
        if SettingsUi.data.has-transcoding-profile: SettingsRow {
            rem-size: root.rem-size; label: "Transcode profile"; last: true; highlighted: SettingsUi.hit-row == "transcode";
            SettingsSelectControl {
                rem-size: root.rem-size; input: SettingsUi.data.transcoding-profile; fallback-title: "Disabled";
                opacity: SettingsUi.data.cache-root-updating ? 0.5 : 1.0;
                select(o) => { if (!SettingsUi.data.cache-root-updating) { SettingsUi.select-option("transcodingProfile", o); } }
            }
        }
    }

    if !SettingsUi.data.server-online && !SettingsUi.data.server-loading: SettingsGroup {
        rem-size: root.rem-size;
        padded: true;

        HorizontalLayout {
            spacing: 0.9 * root.rem-size;
            alignment: start;

            Rectangle {
                width: 1.5 * root.rem-size;
                Image {
                    y: 0.1 * root.rem-size;
                    width: 1.5 * root.rem-size;
                    height: 1.5 * root.rem-size;
                    source: @image-url("../icons/warning.svg");
                    colorize: Theme.text;
                    opacity: 0.6;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0.25 * root.rem-size;
                Text {
                    text: "Can't reach this streaming server";
                    font-size: root.rem-size;
                    font-weight: 500;
                    color: Theme.text;
                }
                Text {
                    text: "Its cache, torrent and transcoding options appear when it is online. Start it, or select another URL above.";
                    wrap: word-wrap;
                    font-size: 0.875 * root.rem-size;
                    color: Theme.text;
                    opacity: 0.6;
                }
            }
        }
    }
}
