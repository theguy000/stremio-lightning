// Based on stremio-web Shortcuts.tsx & shortcuts.json (Copyright Smart code 203358507).
import { ClassStyles } from "../class-styles.slint";
import { Theme } from "../theme.slint";
import { SettingsGroup, SettingsPageHeader, SettingsRow } from "primitives.slint";

component ShortcutKbd inherits Rectangle {
    in property <string> key-text;
    in property <length> rem-size;

    width: Math.max(2.4 * root.rem-size, key-lbl.preferred-width + 1.4 * root.rem-size);
    height: 2.2 * root.rem-size;
    border-radius: 0.5 * root.rem-size;
    background: Theme.overlay;
    border-width: 1px;
    border-color: Theme.surface-medium;

    key-lbl := Text {
        width: parent.width;
        height: parent.height;
        text: root.key-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 0.875 * root.rem-size;
        font-family: "Plus Jakarta Sans SemiBold";
        font-weight: 600;
        color: ClassStyles.color-or(ClassStyles.text, Theme.text);
    }
}

component ShortcutRow inherits SettingsRow {
    in property <string> first-key;
    in property <string> joiner;
    in property <string> second-key;

    HorizontalLayout {
        spacing: 0.5 * root.rem-size;
        alignment: end;

        ShortcutKbd { key-text: root.first-key; rem-size: root.rem-size; }
        if root.joiner != "": Text {
            text: root.joiner;
            vertical-alignment: center;
            font-size: 0.875 * root.rem-size;
            color: Theme.text;
            opacity: 0.5;
        }
        if root.second-key != "": ShortcutKbd { key-text: root.second-key; rem-size: root.rem-size; }
    }
}

export component ShortcutsPage inherits VerticalLayout {
    in property <length> rem-size;

    SettingsPageHeader { title: "Shortcuts"; rem-size: root.rem-size; }

    SettingsGroup {
        title: "Player";
        rem-size: root.rem-size;

        ShortcutRow { rem-size: root.rem-size; label: "Play / Pause"; first-key: "Space"; first: true; }
        ShortcutRow { rem-size: root.rem-size; label: "Seek Forward"; first-key: "→"; joiner: "or"; second-key: "Shift + →"; }
        ShortcutRow { rem-size: root.rem-size; label: "Seek Backward"; first-key: "←"; joiner: "or"; second-key: "Shift + ←"; }
        ShortcutRow { rem-size: root.rem-size; label: "Adjust Volume"; first-key: "↑"; joiner: "/"; second-key: "↓"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Mute"; first-key: "M"; }
        ShortcutRow { rem-size: root.rem-size; label: "Adjust Subtitles Size"; first-key: "-"; joiner: "/"; second-key: "="; }
        ShortcutRow { rem-size: root.rem-size; label: "Adjust Subtitles Delay"; first-key: "G"; joiner: "/"; second-key: "H"; }
        ShortcutRow { rem-size: root.rem-size; label: "Adjust Playback Speed"; first-key: "["; joiner: "/"; second-key: "]"; }
        ShortcutRow { rem-size: root.rem-size; label: "Cycle Video Scale"; first-key: "V"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Subtitles"; first-key: "C"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Subtitles Menu"; first-key: "S"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Audio Menu"; first-key: "A"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Info / Episodes Menu"; first-key: "I"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Playback Speed Menu"; first-key: "R"; }
        ShortcutRow { rem-size: root.rem-size; label: "Play Next"; first-key: "Shift + N"; }
        ShortcutRow { rem-size: root.rem-size; label: "Toggle Fullscreen"; first-key: "F"; joiner: "or"; second-key: "F11"; }
        ShortcutRow { rem-size: root.rem-size; label: "Exit Fullscreen / Go Back"; first-key: "Esc"; }
    }
}
