import { SelectInputData } from "../multiselect-menu.slint";

export struct ServerUrlRow {
    url: string,
    selected: bool,
    removable: bool,
}

export struct SpotlightCatalogRow {
    name: string,
    addon-name: string,
    selected-rank: int,
    is-default: bool,
    bg: image,
    has-bg: bool,
    item-count: int,
}

export struct SettingsSearchHit {
    label: string,
    crumb: string,
    page: string,
    row: string,
}

export struct SettingsViewData {
    user-email: string,
    logged-in: bool,
    trakt-authenticated: bool,
    streaming-server-url: string,
    ui-language: SelectInputData,
    interface-scale: int,
    quit-on-close: bool,
    esc-exit-fullscreen: bool,
    hide-spoilers: bool,
    gamepad-support: bool,
    subtitles-language: SelectInputData,
    subtitles-size: SelectInputData,
    subtitles-size-val: int,
    subtitles-offset: SelectInputData,
    subtitles-offset-val: int,
    subtitles-text-color: SelectInputData,
    subtitles-text-color-hex: color,
    subtitles-bg-color: SelectInputData,
    subtitles-bg-color-hex: color,
    subtitles-outline-color: SelectInputData,
    subtitles-outline-color-hex: color,
    subtitles-bold: bool,
    ass-subtitles-styling: bool,
    audio-language: SelectInputData,
    surround-sound: bool,
    audio-passthrough: bool,
    seek-time: SelectInputData,
    seek-short-time: SelectInputData,
    play-in-background: bool,
    pause-on-minimize: bool,
    binge-watching: bool,
    next-video-duration: SelectInputData,
    external-player: SelectInputData,
    hardware-decoding: bool,
    caching: SelectInputData,
    torrent-profile: SelectInputData,
    transcoding-profile: SelectInputData,
    has-https-endpoint: bool,
    https-endpoint: SelectInputData,
    has-transcoding-profile: bool,
    server-online: bool,
    server-loading: bool,
    server-version: string,
    remote-url: string,
    server-urls: [ServerUrlRow],
    data-export-loading: bool,
    has-cache-root: bool,
    cache-root: SelectInputData,
    cache-root-path: string,
    cache-root-updating: bool,
    cache-root-error: string,
    mpv-config: SelectInputData,
    mpv-config-path: string,
    discord-rpc-enabled: bool,
    spotlight-enabled: bool,
    spotlight-show-rows: bool,
    spotlight-is-default: bool,
    spotlight-picks-count: int,
    spotlight-picks-summary: string,
    spotlight-preview-bg: image,
    spotlight-has-preview-bg: bool,
    spotlight-preview-title: string,
    spotlight-preview-count: string,
    spotlight-preview-sub: string,
}

export global SettingsUi {
    in-out property <SettingsViewData> data;
    in-out property <string> app-version;
    in-out property <string> build-version;
    in-out property <string> server-status: "Stream server: starting...";
    in-out property <string> active-page: "interface";
    in-out property <string> search-query: "";
    in-out property <[SettingsSearchHit]> search-results;
    in-out property <[SpotlightCatalogRow]> spotlight-catalogs;
    in-out property <string> hit-row: "";

    callback log-out();
    callback open-external-link(string);
    callback select-option(string, int);
    callback toggle-option(string, bool);
    callback set-interface-scale(int);
    callback reload-streaming-server();
    callback add-server-url(string);
    callback select-server-url(string);
    callback delete-server-url(string);
    callback copy-remote-url();
    callback toggle-trakt();
    callback subscribe-calendar();
    callback change-password();
    callback export-user-data();
    callback copy-version-details();
    callback search-changed(string);
    callback select-cache-root(int);
    callback select-mpv-config(int);
    callback set-spotlight-enabled(bool);
    callback set-spotlight-show-rows(bool);
    callback open-spotlight-picker();
    callback toggle-spotlight-catalog(int);
    callback reset-spotlight-catalogs();
}
