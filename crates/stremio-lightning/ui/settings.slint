// Numbers translated from src/routes/Settings/Settings.less & Settings.tsx.
import { ScrollBar } from "scroll-bar.slint";
import { Theme } from "theme.slint";
import { SettingsMenu } from "settings/menu.slint";
import { AccountPage, HelpPage, SearchResultsPage } from "settings/pages-account.slint";
import { IntegrationsPage, InterfacePage, PlayerPage } from "settings/pages-core.slint";
import { StreamingPage } from "settings/page-streaming.slint";
import { DevicePage } from "settings/pages-device.slint";
import { ShortcutsPage } from "settings/shortcuts.slint";
import { ServerUrlRow, SettingsSearchHit, SettingsUi, SettingsViewData } from "settings/types.slint";

export { ServerUrlRow, SettingsSearchHit, SettingsUi, SettingsViewData }

export component SettingsContent inherits Rectangle {
    in property <length> viewport-width;
    in-out property <length> scroll-offset <=> pane.content-y;
    callback log-in();
    callback scroll-bounds(length, length, length, length, length);

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <length> menu-width: 19 * root.rem-size;
    property <bool> searching: SettingsUi.search-query != "";

    property <length> watched-width: pane.width;
    property <length> watched-height: pane.height;
    property <length> watched-content: pane.content-height;
    changed watched-width => { root.report-bounds(); }
    changed watched-height => { root.report-bounds(); }
    changed watched-content => { root.report-bounds(); }
    init => { root.report-bounds(); }

    function report-bounds() {
        root.scroll-bounds(
            pane.absolute-position.x,
            pane.absolute-position.y,
            pane.width,
            pane.height,
            pane.content-height,
        );
    }

    function open-page(id: string) {
        SettingsUi.active-page = id;
        SettingsUi.search-query = "";
        SettingsUi.search-changed("");
        pane.content-y = 0px;
    }

    hit-timer := Timer {
        interval: 1900ms;
        running: SettingsUi.hit-row != "";
        triggered => { SettingsUi.hit-row = ""; }
    }

    SettingsMenu {
        x: 0px;
        y: 0px;
        width: root.menu-width;
        height: root.height;
        rem-size: root.rem-size;
        selected: root.searching ? "" : SettingsUi.active-page;
        query <=> SettingsUi.search-query;
        navigate(id) => {
            SettingsUi.hit-row = "";
            root.open-page(id);
        }
        open-account => {
            if (SettingsUi.data.logged-in) {
                SettingsUi.hit-row = "";
                root.open-page("account");
            } else {
                root.log-in();
            }
        }
        query-edited(q) => {
            SettingsUi.search-changed(q);
            pane.content-y = 0px;
        }
    }

    pane := Flickable {
        x: root.menu-width;
        y: 0px;
        width: root.width - root.menu-width;
        height: root.height;
        content-width: self.width;
        content-height: Math.max(self.height, page-wrap.preferred-height);

        page-wrap := VerticalLayout {
            x: 3 * root.rem-size;
            y: 0px;
            width: Math.min(46 * root.rem-size, Math.max(20 * root.rem-size, pane.width - 6 * root.rem-size));
            padding-top: 1 * root.rem-size;
            padding-bottom: 5 * root.rem-size;

            if root.searching: SearchResultsPage {
                rem-size: root.rem-size;
                pick-hit(page, row) => {
                    SettingsUi.hit-row = row;
                    root.open-page(page);
                }
            }
            if !root.searching && SettingsUi.active-page == "interface": InterfacePage { rem-size: root.rem-size; }
            if !root.searching && SettingsUi.active-page == "player": PlayerPage { rem-size: root.rem-size; }
            if !root.searching && SettingsUi.active-page == "integrations": IntegrationsPage { rem-size: root.rem-size; }
            if !root.searching && SettingsUi.active-page == "device": DevicePage { rem-size: root.rem-size; }
            if !root.searching && SettingsUi.active-page == "streaming": StreamingPage { rem-size: root.rem-size; }
            if !root.searching && SettingsUi.active-page == "account": AccountPage {
                rem-size: root.rem-size;
                log-in => { root.log-in(); }
            }
            if !root.searching && SettingsUi.active-page == "shortcuts": ShortcutsPage { rem-size: root.rem-size; }
            if !root.searching && SettingsUi.active-page == "help": HelpPage { rem-size: root.rem-size; }
        }
    }

    ScrollBar {
        x: root.width - 8px;
        y: 0px;
        height: root.height;
        view-height: root.height;
        content-height: pane.content-height;
        offset <=> pane.content-y;
    }
}
