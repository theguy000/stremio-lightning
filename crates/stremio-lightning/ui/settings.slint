// Numbers translated by hand from src/routes/Settings/Settings.less.
// Licence basis: ../THIRD_PARTY_NOTICES.md.
import { ClassStyles } from "class-styles.slint";
import { ScrollBar } from "scroll-bar.slint";
import { SettingsButton, SettingsCategoryHeader, SettingsLink, SettingsMenuButton, SettingsOption, SettingsSection, SettingsValuePill, SettingsVersionLabel, SettingsViewData } from "settings/controls.slint";
import { SettingsSelectRow, SettingsShortcutsSection, SettingsToggleRow } from "settings/shortcuts.slint";
import { Theme } from "theme.slint";

export { SettingsViewData }

export component SettingsContent inherits Rectangle {
    in property <length> viewport-width;
    in property <string> app-version;
    in property <string> build-version;
    in property <string> server-status;
    in property <SettingsViewData> data;
    in-out property <length> scroll-offset <=> sections-container.content-y;

    callback log-in();
    callback log-out();
    callback open-external-link(string);
    callback select-setting-option(string, int);
    callback toggle-setting-option(string, bool);
    callback reload-streaming-server();
    callback scroll-bounds(length, length, length, length, length);

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <length> watched-width: sections-container.width;
    property <length> watched-height: sections-container.height;
    property <length> watched-content: sections-container.content-height;
    changed watched-width => { root.report-bounds(); }
    changed watched-height => { root.report-bounds(); }
    changed watched-content => { root.report-bounds(); }
    init => { root.report-bounds(); }

    function report-bounds() {
        root.scroll-bounds(
            sections-container.absolute-position.x,
            sections-container.absolute-position.y,
            sections-container.width,
            sections-container.height,
            sections-container.content-height,
        );
    }

    property <length> menu-width: 18 * root.rem-size;
    property <length> sections-padding: 3 * root.rem-size;
    property <length> section-width: Math.min(35 * root.rem-size, root.width - root.menu-width - 2 * root.sections-padding);
    property <length> user-height: 11 * root.rem-size + 1px;
    property <length> links-height: 22 * root.rem-size + 1px;
    property <length> interface-height: 27 * root.rem-size + 1px;
    property <length> player-height: 88 * root.rem-size + 1px;
    property <length> streaming-height: 36 * root.rem-size + 1px;
    property <length> shortcuts-height: 76 * root.rem-size;
    property <length> interface-top: root.user-height + root.links-height;
    property <length> player-top: root.interface-top + root.interface-height;
    property <length> streaming-top: root.player-top + root.player-height;
    property <length> shortcuts-top: root.streaming-top + root.streaming-height;
    property <length> total-height: root.shortcuts-top + root.shortcuts-height;
    property <length> scroll-marker: -sections-container.content-y + 50px;
    property <bool> at-bottom: -sections-container.content-y + sections-container.height >= root.total-height - 10px;
    property <int> active-menu: root.at-bottom || root.scroll-marker >= root.shortcuts-top ? 4
        : root.scroll-marker >= root.streaming-top ? 3
        : root.scroll-marker >= root.player-top ? 2
        : root.scroll-marker >= root.interface-top ? 1 : 0;

    function scroll-to(target: length) {
        sections-container.content-y = Math.min(Math.max(-target, sections-container.height - root.total-height), 0px);
    }

    sections-container := Flickable {
        x: root.menu-width;
        y: 0px;
        width: root.width - root.menu-width;
        height: root.height;
        content-width: self.width;
        content-height: root.total-height;

        SettingsSection {
            x: root.sections-padding;
            y: 0px;
            width: root.section-width;
            height: root.user-height;
            rem-size: root.rem-size;

            user := Rectangle {
                x: 0px;
                y: 3 * root.rem-size;
                width: parent.width;
                height: 5 * root.rem-size;

                avatar-container := Rectangle {
                    width: 5 * root.rem-size;
                    height: 5 * root.rem-size;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: ClassStyles.color-or(ClassStyles.avatar-container, Theme.accent);
                    background: ClassStyles.background-or(ClassStyles.avatar-container, Theme.text);
                    opacity: ClassStyles.opacity-or(ClassStyles.avatar-container, 0.9);
                    visible: !ClassStyles.avatar-container.hidden;
                    clip: true;

                    Image {
                        source: @image-url("images/anonymous.png");
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        image-fit: cover;
                    }
                }
                email-label := Text {
                    x: 6 * root.rem-size;
                    y: (parent.height - self.preferred-height - 2 * root.rem-size) / 2;
                    width: parent.width - 6 * root.rem-size;
                    text: root.data.user-email != "" ? root.data.user-email : "Anonymous user";
                    overflow: elide;
                    font-size: 1.1 * root.rem-size;
                    color: ClassStyles.color-or(ClassStyles.email-label, Theme.text);
                    opacity: ClassStyles.opacity-or(ClassStyles.email-label, 0.7);
                    visible: !ClassStyles.email-label.hidden;
                }
                SettingsLink {
                    x: 6 * root.rem-size;
                    y: email-label.y + email-label.preferred-height;
                    rem-size: root.rem-size;
                    label-text: root.data.logged-in ? "Log out" : "Log in / Sign up";
                    clicked => {
                        if (root.data.logged-in) { root.log-out(); } else { root.log-in(); }
                    }
                }
            }
        }

        SettingsSection {
            x: root.sections-padding;
            y: root.user-height;
            width: root.section-width;
            height: root.links-height;
            rem-size: root.rem-size;

            SettingsLink { x: 0px; y: 3 * root.rem-size; rem-size: root.rem-size; label-text: "Contact support"; clicked => { root.open-external-link("support"); } }
            SettingsLink { x: 0px; y: 5 * root.rem-size; rem-size: root.rem-size; label-text: "Source code"; clicked => { root.open-external-link("source"); } }
            SettingsLink { x: 0px; y: 7 * root.rem-size; rem-size: root.rem-size; label-text: "Terms of Service"; clicked => { root.open-external-link("tos"); } }
            SettingsLink { x: 0px; y: 9 * root.rem-size; rem-size: root.rem-size; label-text: "Privacy Policy"; clicked => { root.open-external-link("privacy"); } }
            trakt-container := SettingsOption {
                x: 0px;
                y: 13 * root.rem-size;
                width: parent.width;
                height: 4 * root.rem-size;
                rem-size: root.rem-size;
                label-text: "Trakt Scrobbling";
                icon: @image-url("icons/trakt.svg");
                has-icon: true;

                SettingsButton {
                    y: (parent.height - self.height) / 2;
                    width: trakt-container.content-width;
                    rem-size: root.rem-size;
                    label-text: root.data.trakt-authenticated ? "Logout" : "Authenticate";
                    disabled: !root.data.logged-in;
                }
            }
        }

        SettingsSection {
            x: root.sections-padding;
            y: root.interface-top;
            width: root.section-width;
            height: root.interface-height;
            rem-size: root.rem-size;
            label-text: "Interface";

            SettingsSelectRow { x: 0px; y: 8.4 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "UI Language"; input: root.data.ui-language; fallback-title: "English"; select(opt) => { root.select-setting-option("interfaceLanguage", opt); } }
            SettingsToggleRow { x: 0px; y: 13 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Quit on close"; checked: root.data.quit-on-close; toggled(val) => { root.toggle-setting-option("quitOnClose", val); } }
            SettingsToggleRow { x: 0px; y: 17.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "ESC to exit full screen"; checked: root.data.esc-exit-fullscreen; toggled(val) => { root.toggle-setting-option("escExitFullscreen", val); } }
            SettingsToggleRow { x: 0px; y: 22 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Blur unwatched episodes image"; checked: root.data.hide-spoilers; toggled(val) => { root.toggle-setting-option("hideSpoilers", val); } }
        }

        SettingsSection {
            x: root.sections-padding;
            y: root.player-top;
            width: root.section-width;
            height: root.player-height;
            rem-size: root.rem-size;
            label-text: "Player";

            SettingsCategoryHeader { x: 0px; y: 7.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Subtitles"; }
            SettingsSelectRow { x: 0px; y: 10.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Default Subtitles Language"; input: root.data.subtitles-language; fallback-title: "English"; select(opt) => { root.select-setting-option("subtitlesLanguage", opt); } }
            SettingsSelectRow { x: 0px; y: 15 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Default Subtitles Size"; input: root.data.subtitles-size; fallback-title: "100%"; select(opt) => { root.select-setting-option("subtitlesSize", opt); } }
            SettingsSelectRow { x: 0px; y: 19.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Subtitles Text Color"; input: root.data.subtitles-text-color; fallback-title: "White"; select(opt) => { root.select-setting-option("subtitlesTextColor", opt); } }
            SettingsSelectRow { x: 0px; y: 24 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Subtitles Background Color"; input: root.data.subtitles-bg-color; fallback-title: "None"; select(opt) => { root.select-setting-option("subtitlesBackgroundColor", opt); } }
            SettingsSelectRow { x: 0px; y: 28.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Subtitles Outline Color"; input: root.data.subtitles-outline-color; fallback-title: "Black"; select(opt) => { root.select-setting-option("subtitlesOutlineColor", opt); } }

            SettingsCategoryHeader { x: 0px; y: 33.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Audio"; }
            SettingsSelectRow { x: 0px; y: 36.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Default Audio Track"; input: root.data.audio-language; fallback-title: "English"; select(opt) => { root.select-setting-option("audioLanguage", opt); } }
            SettingsToggleRow { x: 0px; y: 41 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Surround sound"; checked: root.data.surround-sound; toggled(val) => { root.toggle-setting-option("surroundSound", val); } }

            SettingsCategoryHeader { x: 0px; y: 46 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Controls"; }
            SettingsSelectRow { x: 0px; y: 49 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Seek Time Duration"; input: root.data.seek-time; fallback-title: "10 seconds"; select(opt) => { root.select-setting-option("seekTimeDuration", opt); } }
            SettingsSelectRow { x: 0px; y: 53.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Seek Time Duration (Shift)"; input: root.data.seek-short-time; fallback-title: "3 seconds"; select(opt) => { root.select-setting-option("seekShortTimeDuration", opt); } }
            SettingsToggleRow { x: 0px; y: 58 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Play in background"; checked: root.data.play-in-background; toggled(val) => { root.toggle-setting-option("playInBackground", val); } }

            SettingsCategoryHeader { x: 0px; y: 63 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Auto-Play"; }
            SettingsToggleRow { x: 0px; y: 66 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Auto-Play Next Episode"; checked: root.data.binge-watching; toggled(val) => { root.toggle-setting-option("bingeWatching", val); } }
            SettingsSelectRow { x: 0px; y: 70.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Next Video Popup Duration"; input: root.data.next-video-duration; fallback-title: "35 seconds"; select(opt) => { root.select-setting-option("nextVideoNotificationDuration", opt); } }

            SettingsCategoryHeader { x: 0px; y: 75.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Advanced"; }
            SettingsSelectRow { x: 0px; y: 78.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Play in External Player"; input: root.data.external-player; fallback-title: "Disabled"; select(opt) => { root.select-setting-option("playerType", opt); } }
            SettingsToggleRow { x: 0px; y: 83 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Hardware-accelerated decoding"; checked: root.data.hardware-decoding; toggled(val) => { root.toggle-setting-option("hardwareDecoding", val); } }
        }

        SettingsSection {
            x: root.sections-padding;
            y: root.streaming-top;
            width: root.section-width;
            height: root.streaming-height;
            rem-size: root.rem-size;
            label-text: "Streaming";

            server-status-opt := SettingsOption {
                x: 0px; y: 8.4 * root.rem-size; width: parent.width; height: 3.5 * root.rem-size; rem-size: root.rem-size;
                label-text: root.server-status != "" ? root.server-status : "Streaming Server";
                SettingsButton {
                    width: server-status-opt.content-width;
                    rem-size: root.rem-size; label-text: "Reload"; disabled: false;
                    clicked => { root.reload-streaming-server(); }
                }
            }
            server-url-opt := SettingsOption {
                x: 0px; y: 13.5 * root.rem-size; width: parent.width; height: 3 * root.rem-size; rem-size: root.rem-size;
                label-text: "Streaming Server URL";
                SettingsValuePill {
                    width: server-url-opt.content-width;
                    value-text: root.data.streaming-server-url != "" ? root.data.streaming-server-url : "http://127.0.0.1:11470/";
                    rem-size: root.rem-size;
                }
            }
            SettingsSelectRow { x: 0px; y: 18 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Caching"; input: root.data.caching; fallback-title: "2 GB"; select(opt) => { root.select-setting-option("caching", opt); } }
            SettingsSelectRow { x: 0px; y: 22.5 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Torrent Profile"; input: root.data.torrent-profile; fallback-title: "Default"; select(opt) => { root.select-setting-option("torrentProfile", opt); } }
            SettingsSelectRow { x: 0px; y: 27 * root.rem-size; width: parent.width; rem-size: root.rem-size; label-text: "Transcoding Profile"; input: root.data.transcoding-profile; fallback-title: "Disabled"; select(opt) => { root.select-setting-option("transcodingProfile", opt); } }
        }

        SettingsShortcutsSection {
            x: root.sections-padding;
            y: root.shortcuts-top;
            width: root.section-width;
            height: root.shortcuts-height;
            rem-size: root.rem-size;
        }
    }

    menu := Rectangle {
        x: 0px;
        y: 0px;
        width: root.menu-width;
        height: root.height;
        background: ClassStyles.background-or(ClassStyles.menu, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.menu, 1.0);
        visible: !ClassStyles.menu.hidden;

        SettingsMenuButton { x: 1.5 * root.rem-size; y: 3 * root.rem-size; width: 15 * root.rem-size; rem-size: root.rem-size; label-text: "General"; selected: root.active-menu == 0; clicked => { sections-container.content-y = 0px; } }
        SettingsMenuButton { x: 1.5 * root.rem-size; y: 7.5 * root.rem-size; width: 15 * root.rem-size; rem-size: root.rem-size; label-text: "Interface"; selected: root.active-menu == 1; clicked => { root.scroll-to(root.interface-top); } }
        SettingsMenuButton { x: 1.5 * root.rem-size; y: 12 * root.rem-size; width: 15 * root.rem-size; rem-size: root.rem-size; label-text: "Player"; selected: root.active-menu == 2; clicked => { root.scroll-to(root.player-top); } }
        SettingsMenuButton { x: 1.5 * root.rem-size; y: 16.5 * root.rem-size; width: 15 * root.rem-size; rem-size: root.rem-size; label-text: "Streaming"; selected: root.active-menu == 3; clicked => { root.scroll-to(root.streaming-top); } }
        SettingsMenuButton { x: 1.5 * root.rem-size; y: 21 * root.rem-size; width: 15 * root.rem-size; rem-size: root.rem-size; label-text: "Shortcuts"; selected: root.active-menu == 4; clicked => { root.scroll-to(root.shortcuts-top); } }

        SettingsVersionLabel {
            x: 1.5 * root.rem-size;
            y: root.height - 99 * root.rem-size / 14;
            width: 15 * root.rem-size;
            rem-size: root.rem-size;
            label-text: "App Version: " + root.app-version;
        }
        SettingsVersionLabel {
            x: 1.5 * root.rem-size;
            y: root.height - 67 * root.rem-size / 14;
            width: 15 * root.rem-size;
            rem-size: root.rem-size;
            label-text: "Build Version: " + root.build-version;
        }
    }

    ScrollBar {
        x: root.width - 8px;
        y: 0px;
        height: root.height;
        view-height: root.height;
        content-height: sections-container.content-height;
        offset <=> sections-container.content-y;
    }
}
