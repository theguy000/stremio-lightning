import { DetailsHero } from "details/hero.slint";
import { DetailsPanel } from "details/panel.slint";
import { StreamContextMenu } from "details/stream-menu.slint";
import { StreamData } from "details/streams-parts.slint";
import { CoverRightImage, MetaPreview, PreviewData } from "meta-preview.slint";
import { SelectOption } from "multiselect-menu.slint";
import { Theme } from "theme.slint";
import { VideoRow } from "videos-list.slint";

export { StreamData }

export global DetailsUi {
    in-out property <PreviewData> preview;
    in-out property <bool> has-preview: false;
    in-out property <[VideoRow]> episodes: [];
    in-out property <string> video-query;
    in-out property <[SelectOption]> seasons: [];
    in-out property <int> season-index: 0;
    in-out property <string> season-title;
    in-out property <bool> season-watched: false;
    in-out property <bool> show-picker: false;
    in-out property <string> picked-label;
    in-out property <bool> has-picked-episode: false;
    in-out property <string> picked-title;
    in-out property <string> picked-overview;
    in-out property <string> picked-released;
    in-out property <bool> picked-has-still: false;
    in-out property <image> picked-still;
    in-out property <string> resume-label;
    in-out property <string> resume-sublabel;
    in-out property <string> resume-video-id;
    in-out property <[StreamData]> streams: [];
    in-out property <int> streams-loading: 0;
    in-out property <bool> waits-for-streams: false;
    in-out property <bool> streams-filtered-out: false;
    in-out property <bool> expect-streams: false;
    in-out property <bool> rate-visible: false;
    in-out property <bool> rate-enabled: false;
    in-out property <bool> rated-liked: false;
    in-out property <bool> rated-loved: false;
    in-out property <string> play-message;
    in-out property <bool> has-steps: false;
    in-out property <int> season-number: 0;
    in-out property <int> episode-number: 0;
    in-out property <bool> can-show-streams: false;
    in-out property <bool> wrap-streams: false;

    callback select-season(int);
    callback pick-video(string);
    callback search-videos(string);
    callback watch-episode(string);
    callback toggle-episode-watched(string);
    callback toggle-season-watched();
    callback back-to-episodes();
    callback play-stream(int);
    callback copy-stream-link(string);
    callback step-season(int);
    callback step-episode(int);
    callback show-streams();
    callback open-content-settings();
    callback toggle-stream-wrap();
    callback share();
    callback rate-like();
    callback rate-love();
    callback toggle-library();
    callback toggle-watched();
}

export component DetailsScreen inherits Rectangle {
    in property <length> rem-size: 14px;
    in property <length> bar-height: 0px;

    background: Theme.page-background;

    property <length> panel-width: 27.5 * root.rem-size;
    property <length> panel-gap: 2 * root.rem-size;
    property <length> panel-x: root.width - root.panel-width - root.panel-gap;
    property <length> panel-y: root.bar-height + 1 * root.rem-size;
    property <length> panel-height: Math.max(0px, root.height - root.panel-y - root.panel-gap);
    property <length> hero-gutter: 3.5 * root.rem-size;
    property <int> stream-menu-index: -1;
    property <string> stream-menu-link;
    property <bool> stream-menu-magnet: false;
    property <length> stream-menu-x: 0px;
    property <length> stream-menu-y: 0px;

    if DetailsUi.has-preview && DetailsUi.preview.has-background: CoverRightImage {
        width: 100%;
        height: 100%;
        source: DetailsUi.preview.background;
        image-opacity: 0.62;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(90deg, rgba(12, 11, 17, 0.94) 0%, rgba(12, 11, 17, 0.86) 22%, rgba(12, 11, 17, 0.60) 40%, rgba(12, 11, 17, 0.20) 58%, rgba(12, 11, 17, 0.0) 70%);
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(0deg, rgba(12, 11, 17, 0.90) 0%, rgba(12, 11, 17, 0.40) 26%, rgba(12, 11, 17, 0.0) 46%);
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, rgba(12, 11, 17, 0.55) 0%, rgba(12, 11, 17, 0.0) 18%);
    }

    Rectangle {
        x: root.hero-gutter;
        y: root.bar-height + 1.5 * root.rem-size;
        width: Math.max(0px, Math.min(50 * root.rem-size, root.panel-x - root.hero-gutter - root.panel-gap));
        height: Math.max(0px, root.height - self.y - 3.5 * root.rem-size);

        DetailsHero {
            width: parent.width;
            height: parent.height;
            preview: DetailsUi.preview;
            has-preview: DetailsUi.has-preview;
            rem-size: root.rem-size;
            rate-visible: DetailsUi.rate-visible;
            rate-enabled: DetailsUi.rate-enabled;
            rated-liked: DetailsUi.rated-liked;
            rated-loved: DetailsUi.rated-loved;
            has-picked-episode: DetailsUi.has-picked-episode;
            picked-title: DetailsUi.picked-title;
            picked-overview: DetailsUi.picked-overview;
            picked-released: DetailsUi.picked-released;
            picked-has-still: DetailsUi.picked-has-still;
            picked-still: DetailsUi.picked-still;
            can-play: DetailsUi.resume-label != "";
            play-label: DetailsUi.resume-label;
            play-sublabel: DetailsUi.resume-sublabel;
            play-primary => {
                if (DetailsUi.streams.length > 0) {
                    DetailsUi.play-stream(0);
                } else if (DetailsUi.resume-video-id != "") {
                    DetailsUi.pick-video(DetailsUi.resume-video-id);
                } else if (DetailsUi.episodes.length > 0) {
                    DetailsUi.pick-video(DetailsUi.episodes[0].id);
                }
            }
            share => { DetailsUi.share(); }
            rate-like => { DetailsUi.rate-like(); }
            rate-love => { DetailsUi.rate-love(); }
            toggle-library => { DetailsUi.toggle-library(); }
            toggle-watched => { DetailsUi.toggle-watched(); }
        }
    }

    panel-backdrop := Rectangle {
        x: root.panel-x;
        y: root.panel-y;
        width: root.panel-width;
        height: root.panel-height;
        background: Theme.page-background;
        border-radius: 1.5 * root.rem-size;
        clip: true;

        if DetailsUi.has-preview && DetailsUi.preview.has-panel-backdrop: panel-backdrop-image := CoverRightImage {
            x: -root.panel-x;
            y: -root.panel-y;
            width: root.width;
            height: root.height;
            source: DetailsUi.preview.panel-backdrop;
            image-opacity: 0.62;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: rgba(12, 11, 17, 0.62);
        }

        DetailsPanel {
            width: parent.width;
            height: parent.height;
            rem-size: root.rem-size;
            seasons: DetailsUi.seasons;
            season-index: DetailsUi.season-index;
            season-title: DetailsUi.season-title;
            season-watched: DetailsUi.season-watched;
            episodes: DetailsUi.episodes;
            viewport-width: root.width;
            viewport-height: root.height;
            query: DetailsUi.video-query;
            show-picker: DetailsUi.show-picker;
            picked-label: DetailsUi.picked-label;
            streams: DetailsUi.streams;
            streams-loading: DetailsUi.streams-loading;
            waits-for-streams: DetailsUi.waits-for-streams;
            streams-filtered-out: DetailsUi.streams-filtered-out;
            expect-streams: DetailsUi.expect-streams;
            has-title: DetailsUi.has-preview;
            play-message: DetailsUi.play-message;
            has-steps: DetailsUi.has-steps;
            season-number: DetailsUi.season-number;
            episode-number: DetailsUi.episode-number;
            can-show-streams: DetailsUi.can-show-streams;
            wrap-streams: DetailsUi.wrap-streams;
            select-season(index) => { DetailsUi.select-season(index); }
            pick-video(id) => { DetailsUi.pick-video(id); }
            search-videos(text) => { DetailsUi.search-videos(text); }
            watch-episode(id) => { DetailsUi.watch-episode(id); }
            toggle-episode-watched(id) => { DetailsUi.toggle-episode-watched(id); }
            toggle-season-watched => { DetailsUi.toggle-season-watched(); }
            back-to-episodes => { DetailsUi.back-to-episodes(); }
            play-stream(index) => { DetailsUi.play-stream(index); }
            open-stream-menu(index, link, magnet, mx, my) => {
                root.stream-menu-index = index;
                root.stream-menu-link = link;
                root.stream-menu-magnet = magnet;
                root.stream-menu-x = mx - root.absolute-position.x;
                root.stream-menu-y = my - root.absolute-position.y;
            }
            stepped-season(delta) => { DetailsUi.step-season(delta); }
            stepped-episode(delta) => { DetailsUi.step-episode(delta); }
            show-streams => { DetailsUi.show-streams(); }
            open-content-settings => { DetailsUi.open-content-settings(); }
        }
    }

    if root.stream-menu-index >= 0: StreamContextMenu {
        width: root.width;
        height: root.height;
        rem-size: root.rem-size;
        stream-index: root.stream-menu-index;
        stream-link: root.stream-menu-link;
        is-magnet: root.stream-menu-magnet;
        anchor-x: root.stream-menu-x;
        anchor-y: root.stream-menu-y;
        close => { root.stream-menu-index = -1; }
        play(index) => { DetailsUi.play-stream(index); }
        copy-link(link) => { DetailsUi.copy-stream-link(link); }
    }
}
