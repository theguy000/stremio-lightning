import { Theme } from "theme.slint";
import { PlayerControlBar } from "player/control-bar.slint";
import { PlayerKeyHandler } from "player/keys.slint";
import { PlayerMenusPopup } from "player/menus.slint";
import { PlayerNextVideoPopup } from "player/next-video-popup.slint";
import {
    PlayerBufferingOverlay,
    PlayerDrawerTab,
    PlayerErrorOverlay,
    PlayerNavBar,
    PlayerSkipDisc,
    PlayerToastIndicator,
    PlayerVolumeIndicator,
} from "player/overlays.slint";
import { PlayerSideDrawer } from "player/side-drawer.slint";
import { PlayerUi } from "player/state.slint";
import {
    LanguageOption,
    PlayerEpisode,
    PlayerOption,
    PlayerText,
    PlayerTrack,
    SkipMark,
    SkipRow,
} from "player/types.slint";

export { PlayerUi, SkipRow, PlayerTrack, LanguageOption, PlayerEpisode, PlayerOption, SkipMark, PlayerText }

export component PlayerScreen inherits Rectangle {
    in property <length> rem-size: Theme.rem-size(root.width);
    in-out property <bool> drawer-open;
    in-out property <bool> next-dismissed;

    // Mirror PlayerUi values whose changes drive HUD indicators so Slint's `changed` hooks fire.
    property <bool> loaded-state: PlayerUi.loaded;
    property <float> volume-state: PlayerUi.volume;
    property <bool> muted-state: PlayerUi.muted;
    property <float> speed-state: PlayerUi.speed;
    property <string> scale-state: PlayerUi.scale;
    property <float> subtitles-size-state: PlayerUi.subtitles-size;
    property <float> subtitles-offset-state: PlayerUi.subtitles-offset;

    property <bool> volume-shown: false;
    property <float> volume-shown-value: 100;
    property <string> indicator;
    property <int> idle: 0;
    property <bool> pulse: false;
    property <bool> remaining-mode: false;
    property <float> drag-time: -1;
    property <bool> pressed-here: false;
    property <float> shown-time: root.drag-time >= 0 ? root.drag-time : PlayerUi.time;
    property <image> volume-glyph: root.muted-state || root.volume-state <= 0 ? @image-url("icons/volume-mute.svg") : (root.volume-state < 30 ? @image-url("icons/volume-low.svg") : (root.volume-state < 70 ? @image-url("icons/volume-medium.svg") : @image-url("icons/volume-high.svg")));
    property <image> scale-glyph: root.scale-state == "cover" ? @image-url("icons/video-scale-crop.svg") : (root.scale-state == "fill" ? @image-url("icons/video-scale-stretch.svg") : @image-url("icons/video-scale-fit.svg"));
    property <string> scale-words: root.scale-state == "cover" ? "Crop" : (root.scale-state == "fill" ? "Stretch" : "Fit");
    property <float> remaining: PlayerUi.duration - root.shown-time;
    property <bool> can-seek: PlayerUi.seekable && PlayerUi.duration > 0 && root.loaded-state;
    property <bool> next-open: PlayerUi.has-next && !root.next-dismissed && root.remaining > 0 && root.remaining <= PlayerUi.next-notice;
    property <bool> controls-visible: root.idle < 6 || PlayerUi.menu != "" || root.drawer-open || !root.loaded-state || PlayerUi.error != "";

    function close-menus() {
        PlayerUi.menu = "";
        root.drawer-open = false;
        root.next-dismissed = true;
    }

    function show-indicator(text: string) {
        root.indicator = text;
        indicator-clock.running = false;
        indicator-clock.running = true;
    }

    public function focus-player() {
        key-handler.focus-keys();
    }

    background: transparent;

    idle-clock := Timer {
        interval: 500ms;
        running: root.idle < 6;
        triggered => { root.idle = root.idle + 1; }
    }
    pulse-clock := Timer {
        interval: 1s;
        running: !PlayerUi.loaded && PlayerUi.error == "";
        triggered => { root.pulse = !root.pulse; }
    }
    volume-clock := Timer {
        interval: 1500ms;
        running: false;
        triggered => { root.volume-shown = false; }
    }
    indicator-clock := Timer {
        interval: 1s;
        running: false;
        triggered => { root.indicator = ""; }
    }
    drag-clock := Timer {
        interval: 1s;
        running: false;
        triggered => { root.drag-time = -1; }
    }

    changed volume-state => {
        root.idle = 0;
        root.volume-shown = true;
        root.volume-shown-value = root.volume-state;
        volume-clock.running = false;
        volume-clock.running = true;
    }
    changed muted-state => {
        root.idle = 0;
        root.volume-shown = true;
        volume-clock.running = false;
        volume-clock.running = true;
    }
    changed speed-state => { root.show-indicator("Playback speed " + (Math.round(root.speed-state * 100) / 100) + "x"); }
    changed scale-state => { root.show-indicator(root.scale-words); }
    changed subtitles-size-state => { root.show-indicator("Subtitles size " + Math.round(root.subtitles-size-state) + "%"); }
    changed subtitles-offset-state => { root.show-indicator("Subtitles delay " + (Math.round(root.subtitles-offset-state) / 1000).to-fixed(2) + "s"); }
    changed loaded-state => {
        root.next-dismissed = false;
        root.drag-time = -1;
        root.idle = 0;
    }

    screen := TouchArea {
        mouse-cursor: root.controls-visible ? default : none;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.down) { root.idle = 0; }
            if (event.kind == PointerEventKind.down) { root.pressed-here = true; }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.pressed-here = false; }
        }
        double-clicked => { PlayerUi.toggle-fullscreen(); }
        clicked => {
            if (PlayerUi.menu != "" || root.drawer-open || root.next-open) { root.close-menus(); }
            else if (PlayerUi.loaded && root.pressed-here) { PlayerUi.play-pause(); }
            root.pressed-here = false;
        }
        scroll-event(event) => {
            if (event.delta-y > 0) { PlayerUi.set-volume(Math.min(PlayerUi.volume + 5, 200)); }
            else if (event.delta-y < 0) { PlayerUi.set-volume(Math.max(PlayerUi.volume - 5, 0)); }
            EventResult.accept
        }
    }

    if !PlayerUi.loaded && PlayerUi.error == "": PlayerBufferingOverlay {
        x: 0; y: 0; width: root.width; height: root.height; rem-size: root.rem-size;
        backdrop: PlayerUi.backdrop; has-backdrop: PlayerUi.has-backdrop;
        logo: PlayerUi.logo; has-logo: PlayerUi.has-logo; expects-logo: PlayerUi.expects-logo;
        title: PlayerUi.title; buffering: PlayerUi.buffering; pulse: root.pulse;
    }
    if PlayerUi.error != "" && !PlayerUi.loaded: PlayerErrorOverlay {
        x: 0; y: 0; width: root.width; height: root.height; rem-size: root.rem-size; error: PlayerUi.error;
    }
    if root.volume-shown && root.controls-visible: PlayerVolumeIndicator {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        rem-size: root.rem-size; volume-glyph: root.volume-glyph; volume-value: root.volume-shown-value;
    }
    if root.indicator != "" && root.controls-visible: PlayerToastIndicator {
        x: (root.width - self.width) / 2; y: root.height - 14 * root.rem-size;
        rem-size: root.rem-size; text: root.indicator;
    }
    if root.controls-visible: PlayerNavBar {
        x: 0; y: 0; width: root.width; rem-size: root.rem-size;
        title: PlayerUi.title; fullscreen: PlayerUi.fullscreen;
        back => { PlayerUi.back(); }
        toggle-fullscreen => { PlayerUi.toggle-fullscreen(); }
    }
    if PlayerUi.has-episodes && root.controls-visible && !root.drawer-open: PlayerDrawerTab {
        x: root.width - 3.5 * root.rem-size; y: (root.height - self.height) / 2; rem-size: root.rem-size;
        clicked => { root.drawer-open = true; PlayerUi.menu = ""; }
    }
    if PlayerUi.skip-visible: PlayerSkipDisc {
        x: root.width - self.width - 1.7 * root.rem-size; y: root.height - self.height - 9 * root.rem-size;
        rem-size: root.rem-size;
        clicked => { PlayerUi.skip(); }
    }
    if root.controls-visible: PlayerControlBar {
        x: 0; y: root.height - self.height; width: root.width; rem-size: root.rem-size;
        loaded: PlayerUi.loaded; paused: PlayerUi.paused; can-seek: root.can-seek;
        shown-time: root.shown-time; duration: PlayerUi.duration; remaining: root.remaining;
        buffered: PlayerUi.buffered; speed: root.speed-state; volume: root.volume-state; muted: root.muted-state;
        volume-glyph: root.volume-glyph; scale-glyph: root.scale-glyph; scale-words: root.scale-words;
        has-next: PlayerUi.has-next; has-episodes: PlayerUi.has-episodes;
        has-subtitles: PlayerUi.subtitle-languages.length > 0; has-audio: PlayerUi.audio-tracks.length > 0;
        has-options: PlayerUi.options.length > 0; skip-submit: PlayerUi.skip-submit; skip-marks: PlayerUi.skip-marks;
        remaining-mode <=> root.remaining-mode; menu <=> PlayerUi.menu; drawer-open <=> root.drawer-open;
        seek-preview(v) => { root.drag-time = v; }
        seek-commit(v) => { root.drag-time = v; PlayerUi.seek(v); drag-clock.running = false; drag-clock.running = true; }
        play-pause => { PlayerUi.play-pause(); }
        play-next => { PlayerUi.play-next(); }
        toggle-muted => { PlayerUi.toggle-muted(); }
        set-volume(v) => { PlayerUi.set-volume(v); }
        open-skip => { PlayerUi.open-skip(); }
        cycle-scale => { PlayerUi.cycle-scale(); }
    }
    if PlayerUi.menu != "": Rectangle {
        x: 0; y: 0; width: root.width; height: root.height - 7 * root.rem-size; background: transparent;
        TouchArea { clicked => { PlayerUi.menu = ""; } }
    }
    if PlayerUi.menu != "" && root.controls-visible: PlayerMenusPopup {
        x: root.width - self.width - 4 * root.rem-size; y: root.height - self.height - 7.5 * root.rem-size;
        rem-size: root.rem-size; menu: PlayerUi.menu; time: PlayerUi.time; speed: PlayerUi.speed;
        audio-tracks: PlayerUi.audio-tracks; subtitle-languages: PlayerUi.subtitle-languages;
        subtitle-language: PlayerUi.subtitle-language; subtitle-variants: PlayerUi.subtitle-variants;
        subtitles-enabled: PlayerUi.subtitles-enabled; subtitles-offset: root.subtitles-offset-state;
        subtitles-size: root.subtitles-size-state; subtitles-position: PlayerUi.subtitles-position;
        options: PlayerUi.options; skip-kind: PlayerUi.skip-kind; skip-rows: PlayerUi.skip-rows;
        skip-start <=> PlayerUi.skip-start; skip-end <=> PlayerUi.skip-end; skip-notice: PlayerUi.skip-notice;
        set-speed(v) => { PlayerUi.set-speed(v); }
        select-audio(id) => { PlayerUi.select-audio(id); }
        choose-language(l) => { PlayerUi.choose-language(l); }
        choose-subtitles(id) => { PlayerUi.choose-subtitles(id); }
        step-subtitles-offset(d) => { PlayerUi.step-subtitles-offset(d); }
        step-subtitles-size(d) => { PlayerUi.step-subtitles-size(d); }
        step-subtitles-position(d) => { PlayerUi.step-subtitles-position(d); }
        choose-option(a) => { PlayerUi.choose-option(a); }
        pick-skip-kind(k) => { PlayerUi.pick-skip-kind(k); }
        submit-skip(k, s, e) => { PlayerUi.submit-skip(k, s, e); }
        vote-skip(id, up) => { PlayerUi.vote-skip(id, up); }
    }
    if root.drawer-open: PlayerSideDrawer {
        x: root.width - self.width; y: 0; height: root.height; rem-size: root.rem-size;
        logo: PlayerUi.logo; has-logo: PlayerUi.has-logo; preview: PlayerUi.preview;
        has-episodes: PlayerUi.has-episodes; seasons: PlayerUi.seasons; season-index: PlayerUi.season-index;
        season-title: PlayerUi.season-title; episodes: PlayerUi.episodes;
        close => { root.drawer-open = false; }
        select-season(i) => { PlayerUi.select-season(i); }
        select-episode(id) => { root.drawer-open = false; PlayerUi.select-episode(id); }
    }
    if root.next-open: PlayerNextVideoPopup {
        x: root.width - self.width - 4 * root.rem-size; y: root.height - self.height - 7.5 * root.rem-size;
        rem-size: root.rem-size; remaining: root.remaining; next-label: PlayerUi.next-label;
        dismiss => { root.next-dismissed = true; }
        play-next => { PlayerUi.play-next(); }
    }
    key-handler := PlayerKeyHandler {
        live: PlayerUi.menu == "" && !root.drawer-open && !root.next-open;
        has-episodes: PlayerUi.has-episodes; next-open: root.next-open;
        volume: PlayerUi.volume; speed: PlayerUi.speed;
        seek-step: PlayerUi.seek-step; seek-short-step: PlayerUi.seek-short-step;
        fullscreen: PlayerUi.fullscreen; esc-exit-fullscreen: PlayerUi.esc-exit-fullscreen;
        menu <=> PlayerUi.menu; drawer-open <=> root.drawer-open;
        play-pause => { PlayerUi.play-pause(); }
        seek-by(o) => { PlayerUi.seek-by(o); }
        set-volume(v) => { PlayerUi.set-volume(v); }
        toggle-muted => { PlayerUi.toggle-muted(); }
        toggle-subtitles => { PlayerUi.toggle-subtitles(); }
        cycle-scale => { PlayerUi.cycle-scale(); }
        play-next => { PlayerUi.play-next(); }
        toggle-fullscreen => { PlayerUi.toggle-fullscreen(); }
        set-speed(v) => { PlayerUi.set-speed(v); }
        step-subtitles-size(d) => { PlayerUi.step-subtitles-size(d); }
        step-subtitles-offset(d) => { PlayerUi.step-subtitles-offset(d); }
        close-menus => { root.close-menus(); }
        back => { PlayerUi.back(); }
    }
}
