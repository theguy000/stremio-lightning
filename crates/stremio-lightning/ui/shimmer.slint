// A placeholder bar with a highlight that sweeps across it, the way a skeleton screen does.
//
// The web's placeholders (`.stream-placeholder-container` and the shimmer it animates) are grey
// bars over a moving gradient. Slint has no keyframes, so the highlight is one band whose `x`
// animates from just off the left edge to just off the right edge, and `iteration-count` keeps it
// going: an `animate` block replays for as long as it holds, which is what makes the sweep endless.
export component SmoothShimmer inherits Rectangle {
    in property <color> bar: #ffffff1a;
    in property <color> shine: #ffffff33;
    /// How much of the bar the highlight covers, as a fraction of it.
    in property <float> shine-fraction: 0.6;
    // Starts the sweep. Without a change there is nothing for `animate` to animate.
    property <bool> running: false;

    background: root.bar;
    clip: true;

    band := Rectangle {
        x: root.running ? root.width : -self.width;
        width: root.shine-fraction * root.width;
        height: root.height;
        background: @linear-gradient(90deg, #ffffff00 0%, root.shine 50%, #ffffff00 100%);

        animate x {
            duration: 1400ms;
            iteration-count: -1;
            easing: linear;
        }
    }

    init => {
        root.running = true;
    }
}
