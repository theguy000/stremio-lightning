// Based on stremio-web (https://github.com/Stremio/stremio-web),
// Copyright (C) 2017-2023 Smart code 203358507.
// Layout numbers translated by hand from src/components/MetaPreview/styles.less and its
// ActionButton and MetaLinks styles. Licence basis: ../THIRD_PARTY_NOTICES.md.
// Element ids reuse the web class names where one exists.
//
// On the details route the numbers were re-measured off web.stremio.com over the DevTools
// protocol at 1100x720: a 9rem logo box capped at 30rem, a 1.5714rem runtime row, GENRES/CAST/
// DIRECTORS over 1.5rem gaps, then the description under its SUMMARY label, and a 8.5rem action
// row pinned to the panel's bottom. A floating preview keeps the older, inset numbers.
import { ScrollBar } from "scroll-bar.slint";
import { Theme } from "theme.slint";

export struct LinkGroup {
    label: string,
    links: [string],
}

// Web: `.background-image` — `object-fit: cover` with `object-position: right`. Slint's own
// `cover` crops evenly around the centre, which slides a wide artwork sideways by half the
// overflow, so the scaled image is placed by hand with its right edge on the box's right edge.
export component CoverRightImage inherits Rectangle {
    in property <image> source;
    in property <float> image-opacity: 0.3;
    clip: true;

    property <length> source-width: root.source.width * 1px;
    property <length> source-height: root.source.height * 1px;
    property <float> fill-scale: Math.max(
        root.source-width > 0px ? root.width / root.source-width : 1,
        root.source-height > 0px ? root.height / root.source-height : 1);
    property <length> drawn-width: root.source-width * root.fill-scale;
    property <length> drawn-height: root.source-height * root.fill-scale;

    if root.source-width > 0px && root.source-height > 0px: Image {
        x: parent.width - root.drawn-width;
        y: (parent.height - root.drawn-height) / 2;
        width: root.drawn-width;
        height: root.drawn-height;
        source: root.source;
        image-fit: fill;
        opacity: root.image-opacity;
    }
}

export struct PreviewData {
    title: string,
    runtime: string,
    release-info: string,
    rating: string,
    description: string,
    groups: [LinkGroup],
    has-trailer: bool,
    logo: image,
    has-logo: bool,
    background: image,
    has-background: bool,
}

// Web: .link-container inside MetaLinks.
component PreviewPill inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + 2 * (1.25 * root.rem-size + 2px);
    height: 2.4 * root.rem-size;
    border-radius: 2 * root.rem-size;
    background: Theme.overlay;

    label := Text {
        x: 1.25 * root.rem-size + 2px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        overflow: elide;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
    }
}

// Web: MetaLinks. The label, then pills that wrap onto further lines (flex-wrap: wrap).
component PreviewLinks inherits VerticalLayout {
    in property <LinkGroup> group;
    in property <length> rem-size;
    spacing: 0px;
    padding-top: 1.5 * root.rem-size;

    label-container := Rectangle {
        height: 2 * root.rem-size;
        Text {
            x: 0px;
            y: 0px;
            height: 1.25 * root.rem-size;
            text: root.group.label;
            vertical-alignment: center;
            font-size: 0.95 * root.rem-size;
            font-weight: 700;
            color: Theme.text;
            opacity: 0.3;
        }
    }
    links-container := FlexboxLayout {
        spacing-horizontal: 0.75 * root.rem-size;
        spacing-vertical: 0.75 * root.rem-size;
        alignment: start;

        for link in root.group.links: link-container := PreviewPill {
            text: link;
            rem-size: root.rem-size;
        }
    }
    Rectangle {
        height: 0.75 * root.rem-size;
    }
}

// Web: .runtime-label and .release-info-label — 1.25rem bold text with a 3rem gap after it.
// The web's boxes are the text's own width, flush with the content's left edge.
component InfoLabel inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width;

    label := Text {
        x: 0px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 1.25 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
    }
}

// Web: .imdb-button-container.
component ImdbButton inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + root.rem-size + 3 * root.rem-size + 2 * (0.5 * root.rem-size + 2px);

    label := Text {
        x: 0.5 * root.rem-size + 2px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 1.25 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
    }
    icon := Image {
        source: @image-url("icons/imdb.svg");
        colorize: Theme.imdb;
        
        x: label.x + label.preferred-width + root.rem-size;
        y: (parent.height - self.height) / 2;
        width: 3 * root.rem-size;
        height: 3 * root.rem-size;
    }
}

// Web: .action-button-container, round (4rem) or wide with a label.
component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> rem-size;
    height: 4 * root.rem-size;
    width: root.label == "" ? 4 * root.rem-size
        : 4 * root.rem-size + 1.75 * root.rem-size + root.rem-size + text.preferred-width + 0.4 * root.rem-size;
    border-radius: 4 * root.rem-size;
    background: Theme.overlay;

    icon-container := Image {
        source: root.icon;
        colorize: Theme.text;
        opacity: 0.9;
        width: 1.75 * root.rem-size;
        height: 1.75 * root.rem-size;
        x: root.label == "" ? (parent.width - self.width) / 2 : 2 * root.rem-size;
        y: (parent.height - self.height) / 2;
    }
    text := Text {
        visible: root.label != "";
        x: 2 * root.rem-size + 1.75 * root.rem-size + root.rem-size + 0.2 * root.rem-size;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
        opacity: 0.9;
    }
}

// Web: <MetaPreview compact>. Shows `preview` when `has-preview`, otherwise just the empty panel.
export component MetaPreview inherits Rectangle {
    in property <PreviewData> preview;
    in property <bool> has-preview;
    in property <length> rem-size;
    // On the details route the preview is not a panel: web paints the title's background across
    // the whole screen (`.background-image-layer`) and lays this info straight onto it.
    in property <bool> on-page: false;
    // Web: the rating buttons stay dim until the core has answered about this title.
    in property <bool> rate-visible: false;
    in property <bool> rate-enabled: false;
    in property <bool> rated-liked: false;
    in property <bool> rated-loved: false;
    callback share;
    callback rate-like;
    callback rate-love;

    meta-preview-container := Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.on-page ? transparent : Theme.modal-background;
        border-top-left-radius: root.on-page ? 0px : 0.75 * root.rem-size;
        border-bottom-left-radius: root.on-page ? 0px : 0.75 * root.rem-size;
        clip: true;

        // Web: blurred at 10px. Slint has no blur, so the image is fetched tiny and scaled up smoothly.
        if root.has-preview && root.preview.has-background && !root.on-page: background-image-layer := Rectangle {
            x: -10px;
            y: -10px;
            width: parent.width + 20px;
            height: parent.height + 20px;

            background-image := CoverRightImage {
                width: parent.width;
                height: parent.height;
                source: root.preview.background;
            }
        }

        // Web: on the details route `.meta-preview` already carries the page's `0 4rem 2rem`, so
        // the info box is the whole panel -- it was inset 2.5rem further by the padding that
        // belongs to a floating preview. Its height is what is left above the action buttons,
        // which web reserves 8.5rem for (3.5rem of padding, 4rem buttons, 1rem under them).
        if root.has-preview: meta-info-container := Rectangle {
            x: root.on-page ? 0px : 2.5 * root.rem-size;
            y: root.on-page ? 0px : 2 * root.rem-size;
            width: root.on-page ? parent.width : parent.width - 5 * root.rem-size;
            height: root.on-page ? parent.height - 8.5 * root.rem-size : parent.height - 12.5 * root.rem-size;

            // Behind the Flickable: hovering anywhere over the panel shows the scroll bar (web: meta-info-container:hover).
            info-hover := TouchArea { }
            info-flickable := Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                content-width: self.width;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    // Web: `.logo` — 9rem tall on the details route (8rem in a floating preview),
                    // at most 30rem wide, drawn from the left edge and centred in its box.
                    if root.preview.has-logo: logo-box := Rectangle {
                        height: root.on-page ? 9 * root.rem-size : 8 * root.rem-size;
                        logo := Image {
                            // Pinned to the box's left: a layout would centre the 30rem box instead.
                            x: 0px;
                            width: Math.min(root.on-page ? 30 * root.rem-size : parent.width, parent.width);
                            height: root.on-page ? parent.height : 6 * root.rem-size;
                            source: root.preview.logo;
                            image-fit: contain;
                            // Web's logo sits at the content's left edge; `contain` alone centres it.
                            horizontal-alignment: left;
                            vertical-alignment: root.on-page ? center : top;
                        }
                    }
                    // Web: `.logo-placeholder` — the title itself, at 1.7rem, when there is no logo.
                    if !root.preview.has-logo: Text {
                        horizontal-stretch: 1;
                        text: root.preview.title;
                        font-size: 1.7 * root.rem-size;
                        color: Theme.text;
                        opacity: 0.9;
                        wrap: word-wrap;
                    }
                    // Web: `.logo { margin-bottom: 2rem }`.
                    Rectangle {
                        height: 2 * root.rem-size;
                    }

                    runtime-release-info-container := HorizontalLayout {
                        // Web: 1.25rem text in a 1.5714rem row on the details route. The older
                        // 3.5714rem row pushed everything under it 2rem too far down.
                        height: (root.on-page ? 1.5714 : 3.5714) * root.rem-size;
                        // Web groups runtime, release and rating at the start of the row.
                        alignment: start;
                        spacing: 3 * root.rem-size;

                        if root.preview.runtime != "": runtime-label := InfoLabel {
                            text: root.preview.runtime;
                            rem-size: root.rem-size;
                        }
                        if root.preview.release-info != "": release-info-label := InfoLabel {
                            text: root.preview.release-info;
                            rem-size: root.rem-size;
                        }
                        if root.preview.rating != "": imdb-button-container := ImdbButton {
                            text: root.preview.rating;
                            rem-size: root.rem-size;
                        }
                    }

                    // Web: the title's links come first and the description last, over its own
                    // 1rem margin and with the SUMMARY label the web puts above it.
                    for group in root.preview.groups: meta-links-container := PreviewLinks {
                        group: group;
                        rem-size: root.rem-size;
                    }

                    if root.preview.description != "": Rectangle {
                        height: root.rem-size;
                    }
                    // Web: `.description-container .label-container` — 0.95rem, bold, 0.3 opaque.
                    if root.preview.description != "": summary-label-container := Rectangle {
                        height: 2 * root.rem-size;
                        Text {
                            x: 0px;
                            y: 0px;
                            height: 1.25 * root.rem-size;
                            text: "SUMMARY";
                            vertical-alignment: center;
                            font-size: 0.95 * root.rem-size;
                            font-weight: 700;
                            color: Theme.text;
                            opacity: 0.3;
                        }
                    }

                    // Web: line-height 2em. Slint's `line-height-factor` is relative to the font's natural line
                    // height, so the factor is two ems over the natural height, measured on a one-line text.
                    if root.preview.description != "": description-container := Rectangle {
                        height: Math.round(description-text.preferred-height / (2 * root.rem-size)) * 2 * root.rem-size;
                        horizontal-stretch: 1;

                        description-line := Text {
                            text: "A";
                            font-size: root.rem-size;
                            visible: false;
                        }
                        description-text := Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            text: root.preview.description;
                            wrap: word-wrap;
                            font-size: root.rem-size;
                            line-height-factor: 2 * root.rem-size / description-line.preferred-height;
                            color: Theme.text;
                        }
                    }
                }
            }

            info-scroll-bar := ScrollBar {
                x: parent.width - self.width;
                y: 0px;
                height: parent.height;
                view-height: info-flickable.height;
                content-height: info-flickable.content-height;
                offset <=> info-flickable.content-y;
                // Web: the bar is transparent unless the panel is hovered.
                active: info-hover.has-hover || info-scroll-bar.engaged;
            }
        }

        // Web: `.action-buttons-container` — 3.5rem of padding over the 4rem buttons, and 1rem
        // under them. The row is pinned to the panel's bottom on the details route and to the
        // 2.5rem/2rem box in a floating preview.
        if root.has-preview: action-buttons-container := HorizontalLayout {
            x: root.on-page ? 0px : 2.5 * root.rem-size;
            y: root.on-page ? parent.height - 8.5 * root.rem-size : parent.height - 7 * root.rem-size;
            width: root.on-page ? parent.width : parent.width - 5 * root.rem-size;
            height: root.on-page ? 8.5 * root.rem-size : 4 * root.rem-size;
            padding-top: root.on-page ? 3.5 * root.rem-size : 0px;
            // Web groups these at the start of the row with a fixed gap; spreading them across
            // the width is what made them read as three loose buttons.
            alignment: start;
            spacing: 1 * root.rem-size;

            if root.preview.has-trailer: action-button-container := ActionButton {
                icon: @image-url("icons/trailer.svg");
                // Web labels this one; the rest of the row is icon-only.
                label: "Trailer";
                rem-size: root.rem-size;
            }
            group-container := Rectangle {
                width: 8 * root.rem-size;
                height: 4 * root.rem-size;
                border-radius: 4 * root.rem-size;
                background: Theme.overlay;

                Image {
                    source: @image-url("icons/add-to-library.svg");
                    colorize: Theme.text;
                    opacity: 0.9;
                    x: (4 * root.rem-size - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.75 * root.rem-size;
                    height: 1.75 * root.rem-size;
                }
                Image {
                    source: @image-url("icons/eye.svg");
                    colorize: Theme.text;
                    opacity: 0.9;
                    x: 4 * root.rem-size + (4 * root.rem-size - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.75 * root.rem-size;
                    height: 1.75 * root.rem-size;
                }
            }
            // Web: `Ratings` — a like and a love in one pill, each filled while it is set and dim
            // until the core has said which (if either) the title carries.
            //
            // Two 4rem cells, at 0 and at 4rem: the hover circle, the glyph and the target of a
            // half all measure from their own cell, never from the pill. Measuring from the pill
            // is what put the like's circle in the middle of it, under the gap between the two.
            if root.rate-visible: rate-container := Rectangle {
                width: 8 * root.rem-size;
                height: 4 * root.rem-size;
                // A stadium: the radius is half the height, so the ends are true semicircles.
                border-radius: 2 * root.rem-size;
                background: Theme.overlay;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 4 * root.rem-size;
                    height: 4 * root.rem-size;
                    border-radius: 2 * root.rem-size;
                    background: like-touch.has-hover && root.rate-enabled ? #ffffff1a : transparent;

                    Image {
                        x: (4 * root.rem-size - self.width) / 2;
                        y: (4 * root.rem-size - self.height) / 2;
                        width: 1.75 * root.rem-size;
                        height: 1.75 * root.rem-size;
                        source: root.rated-liked ? @image-url("icons/thumbs-up.svg") : @image-url("icons/thumbs-up-outline.svg");
                        colorize: Theme.text;
                        opacity: root.rate-enabled ? 0.9 : 0.4;
                    }
                    like-touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: 4 * root.rem-size;
                        height: 4 * root.rem-size;
                        enabled: root.rate-enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            root.rate-like();
                        }
                    }
                }

                Rectangle {
                    x: 4 * root.rem-size;
                    y: 0px;
                    width: 4 * root.rem-size;
                    height: 4 * root.rem-size;
                    border-radius: 2 * root.rem-size;
                    background: love-touch.has-hover && root.rate-enabled ? #ffffff1a : transparent;

                    Image {
                        x: (4 * root.rem-size - self.width) / 2;
                        y: (4 * root.rem-size - self.height) / 2;
                        width: 1.75 * root.rem-size;
                        height: 1.75 * root.rem-size;
                        source: root.rated-loved ? @image-url("icons/heart.svg") : @image-url("icons/heart-outline.svg");
                        colorize: Theme.text;
                        opacity: root.rate-enabled ? 0.9 : 0.4;
                    }
                    love-touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: 4 * root.rem-size;
                        height: 4 * root.rem-size;
                        enabled: root.rate-enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            root.rate-love();
                        }
                    }
                }
            }
            share-button := Rectangle {
                width: 4 * root.rem-size;
                height: 4 * root.rem-size;
                border-radius: 2 * root.rem-size;
                background: share-touch.has-hover ? #ffffff1a : Theme.overlay;

                Image {
                    source: @image-url("icons/share.svg");
                    colorize: Theme.text;
                    opacity: 0.9;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.75 * root.rem-size;
                    height: 1.75 * root.rem-size;
                }
                share-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.share();
                    }
                }
            }

            // The Show button belongs to the hover panel. On the details route web has no such
            // button: the rows below are what you pick from.
            if !root.on-page: show-button := ActionButton {
                icon: @image-url("icons/play.svg");
                label: "Show";
                rem-size: root.rem-size;
            }
        }
    }
}
