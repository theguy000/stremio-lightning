import { Theme } from "theme.slint";
import { CalendarContent, CalendarData, CalendarUi } from "calendar.slint";
import { HorizontalNavBar, ModsNavItem, Section, VerticalNavBar } from "shell.slint";
import { BoardContent, BoardUi, CatalogRow, PosterData } from "board.slint";
import { AddonData, AddonPendingData, AddonsContent, AddonsUi } from "addons.slint";
import { DiscoverContent, DiscoverUi, SelectInputData } from "discover.slint";
import { LoggedOutPlaceholder } from "logged-out-placeholder.slint";
import { LibraryCard, LibraryContent, LibrarySort, LibraryUi } from "library.slint";
import { ModCardData, ModsContent, ModsUi, ModsViewData } from "mods.slint";
import { SettingsContent, SettingsUi, SettingsViewData } from "settings.slint";
import { SelectOption } from "multiselect-menu.slint";
import { LinkGroup, PreviewData } from "meta-preview.slint";
import { DetailsScreen, DetailsUi, StreamData } from "details-screen.slint";
import { LanguageOption, PlayerScreen, PlayerUi, PlayerEpisode, PlayerOption, PlayerTrack, SkipMark, SkipRow } from "player.slint";
import { VideoRow } from "videos-list.slint";
import { ClassStyle, ClassStyles } from "class-styles.slint";
import { AuthUi, IntroContent } from "intro.slint";
import { ShareModal } from "share-modal.slint";

export {
    AddonData,
    AddonPendingData,
    AddonsUi,
    AuthUi,
    BoardUi,
    CalendarData,
    CalendarUi,
    CatalogRow,
    ClassStyle,
    ClassStyles,
    DetailsUi,
    DiscoverUi,
    LanguageOption,
    LibraryCard,
    LibrarySort,
    LibraryUi,
    LinkGroup,
    ModCardData,
    ModsNavItem,
    ModsUi,
    ModsViewData,
    PlayerEpisode,
    PlayerOption,
    PlayerTrack,
    PlayerUi,
    PosterData,
    PreviewData,
    Section,
    SelectInputData,
    SelectOption,
    SettingsUi,
    SettingsViewData,
    SkipMark,
    SkipRow,
    StreamData,
    Theme,
    VideoRow,
}

export component MainWindow inherits Window {
    title: "Stremio Lightning";
    default-font-family: Theme.font-family;
    preferred-width: 1100px;
    preferred-height: 720px;
    // The player draws mpv's frames under this window's items, so while playing the
    // window background must stay transparent.
    background: root.playing ? transparent : Theme.page-background;

    in-out property <Section> section: Section.board;
    in-out property <bool> details-open: false;
    in-out property <bool> playing: false;
    in property <string> toast;
    in-out property <bool> share-open: false;
    in property <string> share-link;

    /// Scroll offsets owned by `winit_host.rs` for 1-frame wheel scrolling (0 at top, negative down).
    in-out property <length> board-scroll: 0px;
    in-out property <length> discover-scroll: 0px;
    in-out property <length> library-scroll: 0px;
    in-out property <length> addons-scroll: 0px;
    in-out property <length> settings-scroll: 0px;

    callback open-item(string, string, string);
    callback section-changed();
    callback scroll-bounds(string, length, length, length, length, length);
    callback share-close();
    callback share-copy();
    callback share-to(string);

    property <length> rem-size: Theme.rem-size(root.width);
    property <length> nav-width: root.playing || root.details-open ? 0px : 6 * root.rem-size;
    property <length> bar-height: root.playing ? 0px : 5.5 * root.rem-size;

    if root.section == Section.board && !root.details-open && !root.playing: BoardContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        scroll-offset <=> root.board-scroll;
        scroll-bounds(x, y, width, viewport, content) => { root.scroll-bounds("board", x, y, width, viewport, content); }
        open-item(id, kind, title) => { root.details-open = true; root.open-item(id, kind, title); }
        item-action(id, action) => {
            if (action == "details") { root.details-open = true; }
            BoardUi.item-action(id, action);
        }
    }

    if root.section == Section.discover && !root.details-open && !root.playing: DiscoverContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        scroll-offset <=> root.discover-scroll;
        grid-bounds(x, y, width, viewport, content) => { root.scroll-bounds("discover", x, y, width, viewport, content); }
        open-item(id, kind, title) => { root.details-open = true; root.open-item(id, kind, title); }
    }

    if root.details-open && !root.playing: DetailsScreen {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        rem-size: root.rem-size;
        bar-height: root.bar-height;
    }

    if !root.playing && !root.details-open: VerticalNavBar {
        rem-size: root.rem-size;
        x: 0px;
        y: root.bar-height;
        height: parent.height - root.bar-height;
        section: root.section;
        select(target) => {
            root.details-open = false;
            root.section = target;
            root.section-changed();
            if (target == Section.calendar) { CalendarUi.shown(); }
        }
    }

    if root.playing: PlayerScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        rem-size: root.rem-size;
        init => { self.focus-player(); }
    }

    if !root.playing: HorizontalNavBar {
        rem-size: root.rem-size;
        x: 0px;
        y: 0px;
        width: parent.width;
        show-search: root.section != Section.addons && !root.details-open;
        show-back: root.details-open;
        show-wrap: root.details-open;
        wrap-active: DetailsUi.wrap-streams;
        toggle-wrap => { DetailsUi.toggle-stream-wrap(); }
        bare: root.details-open;
        back-clicked => { root.details-open = false; root.section-changed(); }
        toggle-fullscreen => { root.full-screen = !root.full-screen; }
        user-avatar-clicked => {
            if (!SettingsUi.data.logged-in) { AuthUi.open = true; }
        }
    }

    if root.section == Section.library && !SettingsUi.data.logged-in && !root.details-open && !root.playing: LoggedOutPlaceholder {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        title-text: "Library is only available for logged in users";
        picture: @image-url("images/library-placeholder.png");
        first-glyph: @image-url("icons/cloud-library.svg");
        first-label: "Access your favorite movies and TV shows anytime, anywhere";
        second-glyph: @image-url("icons/actors.svg");
        second-label: "Recommendations tailored to your viewing history";
        log-in => { AuthUi.open = true; }
    }

    if root.section == Section.library && SettingsUi.data.logged-in && !root.details-open && !root.playing: LibraryContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        scroll-offset <=> root.library-scroll;
        scroll-bounds(x, y, width, viewport, content) => { root.scroll-bounds("library", x, y, width, viewport, content); }
        open-item(id, kind, title) => { root.details-open = true; root.open-item(id, kind, title); }
        item-action(id, action) => {
            if (action == "details") { root.details-open = true; }
            LibraryUi.item-action(id, action);
        }
    }

    if root.section == Section.calendar && CalendarUi.data.signed-in && !root.details-open && !root.playing: CalendarContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        rem-size: root.rem-size;
        open-slot(meta-id, kind, video-id) => {
            root.details-open = true;
            CalendarUi.open-slot(meta-id, kind, video-id);
        }
    }

    if root.section == Section.calendar && !CalendarUi.data.signed-in && !root.details-open && !root.playing: LoggedOutPlaceholder {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        title-text: "Calendar is only available for logged in users";
        picture: @image-url("images/calendar-placeholder.png");
        first-glyph: @image-url("icons/megaphone.svg");
        first-label: "Never miss an episode again";
        second-glyph: @image-url("icons/calendar-thin.svg");
        second-label: "Schedule your personal watching calendar";
        log-in => { AuthUi.open = true; }
    }

    if root.section == Section.addons && !root.details-open && !root.playing: AddonsContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        scroll-offset <=> root.addons-scroll;
        scroll-bounds(x, y, width, viewport, content) => { root.scroll-bounds("addons", x, y, width, viewport, content); }
    }

    if root.section == Section.mods && !root.details-open && !root.playing: ModsContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
    }

    if root.section == Section.settings && !root.details-open && !root.playing: SettingsContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        viewport-width: root.width;
        scroll-offset <=> root.settings-scroll;
        scroll-bounds(x, y, width, viewport, content) => { root.scroll-bounds("settings", x, y, width, viewport, content); }
        log-in => { AuthUi.open = true; }
    }

    if AuthUi.open: IntroContent {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        rem-size: root.rem-size;
    }

    // Overlays declared last so they paint above every screen and take presses first.
    if root.toast != "": HorizontalLayout {
        y: parent.height - 4 * root.rem-size;
        height: 3 * root.rem-size;
        alignment: center;
        Rectangle {
            height: 3 * root.rem-size;
            border-radius: 0.75 * root.rem-size;
            background: Theme.modal-background;
            HorizontalLayout {
                alignment: center;
                padding-left: 1.5 * root.rem-size;
                padding-right: 1.5 * root.rem-size;
                Text {
                    text: root.toast;
                    color: Theme.text;
                    font-size: 1 * root.rem-size;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.share-open: ShareModal {
        width: 100%;
        height: 100%;
        link: root.share-link;
        rem-size: root.rem-size;
        closed => { root.share-close(); }
        copied => { root.share-copy(); }
        opened(network) => { root.share-to(network); }
    }
}
