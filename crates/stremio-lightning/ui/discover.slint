// Based on stremio-web (https://github.com/Stremio/stremio-web),
// Copyright (C) 2017-2024 Smart code 203358507 (upstream's header; the end year varies per file).
// Layout numbers translated by hand from src/routes/Discover/styles.less, src/common/screen-sizes.less
// and src/components/MetaItem/styles.less.
// Licence basis: ../THIRD_PARTY_NOTICES.md. Element ids reuse the web class names where one exists.
import { MetaItem, PosterData } from "board.slint";
import { MetaPreview, PreviewData } from "meta-preview.slint";
import { MultiselectMenu, SelectOption } from "multiselect-menu.slint";
import { ScrollBar } from "scroll-bar.slint";
import { Theme } from "theme.slint";

// One filter in the bar: the closed label, its options and which one is selected.
export struct SelectInputData {
    title: string,
    selected-index: int,
    options: [SelectOption],
}

export component DiscoverContent inherits Rectangle {
    in property <[PosterData]> cards;
    in property <string> shape;
    in property <[SelectInputData]> inputs;
    in property <[PreviewData]> previews;
    in property <length> viewport-width;
    in-out property <int> selected-index: 0;
    callback open-item(string, string, string);
    callback load-next-page();
    callback select-item(int);
    /// The pointer came to rest on a card: its pictures can be fetched before it is opened.
    callback hover-card(int);
    // How much of the grid is on screen: the scrolled distance, the viewport's height, the height
    // of one row of cards and how many cards are in a row. The shell works out which cards that is
    // and asks for those pictures only, the way a browser's `loading="lazy"` does.
    callback visible-range(length, length, length, int);
    /// Where the grid is on the window, how big its viewport is and how tall its contents are. The
    /// shell scrolls it (`wheel.rs`), so it needs all three to clamp one wheel notch.
    callback grid-bounds(length, length, length, length, length);
    // (input index, option index): the user picked an option in the filter bar.
    callback select-option(int, int);

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <bool> has-preview: root.previews.length > root.selected-index;
    property <PreviewData> preview: root.previews[root.selected-index];
    // Web: the preview panel is `display: none` from @xsmall (1000px) down.
    property <bool> preview-visible: root.viewport-width > 1000px;
    property <length> preview-width: root.preview-visible ? 29 * root.rem-size : 0px;
    property <length> catalog-width: root.width - root.preview-width;
    property <length> grid-right-margin: root.preview-visible ? 1.5 * root.rem-size : 0px;
    property <length> grid-width: root.catalog-width - root.grid-right-margin - 3 * root.rem-size;
    // The last matching rule in styles.less wins: 10 above 2800px, then 9, 8, 7, 6, 5, 4 (1300px),
    // and 5 again from 1000px down.
    property <int> columns: root.viewport-width > 2800px ? 10
        : root.viewport-width > 2500px ? 9
        : root.viewport-width > 2200px ? 8
        : root.viewport-width > 1900px ? 7
        : root.viewport-width > 1600px ? 6
        : root.viewport-width > 1300px ? 5
        : root.viewport-width > 1000px ? 4 : 5;
    property <length> gap: 0.5 * root.rem-size;
    property <length> cell-width: (root.grid-width - (root.columns - 1) * root.gap) / root.columns;
    property <float> poster-shape-ratio: root.shape == "square" ? 1.0
        : root.shape == "landscape" ? 0.5625 : 1.464;
    property <length> cell-height: 2 * root.rem-size
        + (root.cell-width - 2 * root.rem-size) * root.poster-shape-ratio
        + 4 * root.rem-size;
    property <int> row-count: Math.ceil(root.cards.length / root.columns);
    /// How far the grid is scrolled: zero at the top, negative further down. Nothing but the shell
    /// and the scrollbar touch it -- this grid is not a `Flickable`, because a `Flickable` animates
    /// every wheel notch over 180ms and redraws the whole window for each frame of that animation:
    /// measured at ~200ms of a core per notch.
    in-out property <length> scroll-offset: 0px;
    /// How tall the whole grid is: what `scroll-offset` runs from zero down to.
    property <length> grid-height-total: root.row-count * root.cell-height
        + Math.max(root.row-count - 1, 0) * root.gap;
    /// The height a page was last asked for at, so the end of a catalog does not ask on every notch.
    property <length> page-asked-at: -1px;
    /// The scrolled distance into the grid and how much of it is on screen. Both are read by the
    /// `visible-range` report below.
    property <length> grid-scroll: -root.scroll-offset;
    property <length> grid-height: meta-items-container.height;
    property <length> row-pitch: root.cell-height + root.gap;
    /// The rows of cards that are on screen, plus one either side. Everything else is left out of
    /// the drawing entirely.
    property <float> first-shown-row: Math.max(0,
        Math.floor(-root.scroll-offset / root.row-pitch) - 1);
    property <float> last-shown-row: Math.floor(
        (-root.scroll-offset + meta-items-container.height) / root.row-pitch) + 1;
    changed grid-scroll => {
        root.report-visible();
    }
    /// Counts how many times the shell has said the grid stopped moving. A count rather than a
    /// flag, so two settles in a row are two changes: the next page is asked for once the scrolling
    /// has stopped, not on every notch of a flick that would fly straight past it.
    in property <int> settle-count: 0;
    changed settle-count => {
        root.check-end();
    }
    changed grid-height => {
        root.report-visible();
        root.report-bounds();
    }
    changed row-count => {
        root.report-visible();
        root.report-bounds();
        root.check-end();
    }
    init => {
        root.report-visible();
        root.report-bounds();
    }
    // Web: up to three inputs of 15rem that shrink together beside a 5rem filter button slot.
    property <int> input-count: Math.max(1, Math.min(root.inputs.length, 3));
    property <length> input-width: Math.min(15 * root.rem-size,
        (root.catalog-width - 3 * root.rem-size - 5 * root.rem-size
            - (root.input-count - 1) * 1.5 * root.rem-size) / root.input-count);

    function check-end() {
        // Once per page: at the end of a catalog every notch asks again, and a page that has not
        // arrived yet cannot be asked for twice. When one does arrive the grid grows, and the next
        // call is allowed.
        if (-root.scroll-offset + meta-items-container.height > root.grid-height-total - 400px
            && root.grid-height-total != root.page-asked-at) {
            root.page-asked-at = root.grid-height-total;
            root.load-next-page();
        }
    }

    /// Where the grid is and how tall its contents are, so the shell can clamp a wheel notch itself:
    /// it owns `scroll-offset`, this only draws it. Nothing here moves when the grid scrolls, so it
    /// is reported when the layout changes and not on every notch.
    function report-bounds() {
        root.grid-bounds(meta-items-container.absolute-position.x,
            meta-items-container.absolute-position.y,
            meta-items-container.width, meta-items-container.height,
            root.grid-height-total);
    }

    function report-visible() {
        root.visible-range(root.grid-scroll, root.grid-height, root.row-pitch, root.columns);
    }

    discover-content := Rectangle {
        width: parent.width;
        height: parent.height;

        catalog-container := Rectangle {
            x: 0px;
            width: root.catalog-width;
            height: parent.height;

            selectable-inputs-container := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 6 * root.rem-size;

                for input[index] in root.inputs: select-input := MultiselectMenu {
                    x: 1.5 * root.rem-size + index * (root.input-width + 1.5 * root.rem-size);
                    y: 1.5 * root.rem-size;
                    width: root.input-width;
                    title: input.title;
                    options: input.options;
                    selected-index: input.selected-index;
                    rem-size: root.rem-size;
                    select(option) => {
                        // A new catalog starts at the top with its first card selected.
                        root.selected-index = 0;
                        root.scroll-offset = 0px;
                        root.select-option(index, option);
                    }
                }
            }

            // The grid's viewport, clipped. Plain rectangles rather than a `Flickable`: the shell
            // moves `scroll-offset`, this only draws it, so a wheel notch is one frame.
            meta-items-container := Rectangle {
                x: 0px;
                y: 6 * root.rem-size;
                width: root.catalog-width - root.grid-right-margin;
                height: parent.height - 6 * root.rem-size;
                // Needed even though the rows below are culled to what is on screen: the edge rows
                // are drawn whole and would otherwise show above the filter bar and below the grid.
                clip: true;

                grid := Rectangle {
                    x: 0px;
                    y: root.scroll-offset;
                    width: parent.width;
                    height: root.grid-height-total;

                    // Only the rows on screen are drawn, and the viewport does not clip: a clip is a
                    // stencil pass for the whole frame, and forty-nine cards of which sixteen are
                    // visible cost more to draw than sixteen.
                    for card[index] in root.cards: MetaItem {
                        visible: Math.floor(index / root.columns) >= root.first-shown-row
                            && Math.floor(index / root.columns) <= root.last-shown-row;
                        x: 1.5 * root.rem-size + Math.mod(index, root.columns) * (root.cell-width + root.gap);
                        y: Math.floor(index / root.columns) * (root.cell-height + root.gap);
                        width: root.cell-width;
                        height: root.cell-height;
                        card: card;
                        selected: index == root.selected-index;
                        rem-size: root.rem-size;
                        poster-shape-ratio: root.poster-shape-ratio;
                        hovered => {
                            root.hover-card(index);
                        }
                        // Web: a click on a card that is not selected selects it, a second click opens it.
                        clicked => {
                            if (index == root.selected-index || !root.preview-visible) {
                                root.open-item(card.item-id, card.kind, card.title);
                            } else {
                                root.selected-index = index;
                                root.select-item(index);
                            }
                        }
                    }
                }

                // Drawn from the same offset and nothing else. It shows where the grid is; it does
                // not own the position, so it cannot fight the shell over it.
                ScrollBar {
                    x: parent.width - self.width;
                    y: 0px;
                    height: parent.height;
                    view-height: parent.height;
                    content-height: root.grid-height-total;
                    offset: -root.scroll-offset;
                }
            }
        }

        // Web: MetaPreview (compact). Selecting a card fills it.
        meta-preview := MetaPreview {
            x: root.catalog-width;
            width: root.preview-width;
            height: parent.height;
            visible: root.preview-visible;
            has-preview: root.has-preview;
            preview: root.preview;
            rem-size: root.rem-size;
            // Web: the Show pill is a link to the title's details route, like a second click.
            show => {
                if (root.cards.length > root.selected-index) {
                    root.open-item(root.cards[root.selected-index].item-id, root.cards[root.selected-index].kind, root.cards[root.selected-index].title);
                }
            }
        }
    }
}
