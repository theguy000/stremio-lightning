// Based on stremio-web (https://github.com/Stremio/stremio-web),
// Copyright (C) 2017-2024 Smart code 203358507 (upstream's header; the end year varies per file).
// Layout numbers translated by hand from src/components/MetaRow/styles.less,
// src/components/MetaItem/styles.less, src/routes/Board/styles.less and src/App/styles.less.
// Licence basis: ../THIRD_PARTY_NOTICES.md. Element ids reuse the web class names where one exists.
import { ClassStyles } from "class-styles.slint";
import { Theme } from "theme.slint";

export struct PosterData {
    item-id: string,
    kind: string,
    title: string,
    poster: image,
    has-poster: bool,
    /// How far into the title the viewer is, as a percentage. Zero draws no bar, which is every
    /// card but the Continue Watching row's.
    progress: float,
    /// Whether the account has watched this title: the web's MetaItem draws a check mark in the
    /// poster's top-left corner for one, whichever row the card is in.
    watched: bool,
    /// Whether a Stream for the title's current Video is at hand. The web draws the round play
    /// button on the poster and the "Play" row in the list only when one is.
    playable: bool,
}

export struct CatalogRow {
    title: string,
    shape: string,
    cards: [PosterData],
    /// Whether the row's cards carry the action list. The web offers it in the Continue Watching
    /// row, whose cards are library items; an addon catalog's cards do not.
    menu: bool,
}

// Web: one option row of the MetaItem's Multiselect menu. `padding: 1rem 1.5rem` around a 1rem
// line box, which lands at 46px in a 14px rem -- and, at the menu's 9rem width, wraps the longer
// "Mark as ..." label onto a second line, so the row height comes from the text, not a constant.
component CardMenuOption inherits Rectangle {
    in property <string> label;
    in property <string> action;
    in property <length> rem-size;
    callback picked(string);

    height: label-text.preferred-height + 2 * root.rem-size;
    background: touch.has-hover ? #ffffff26 : transparent;

    label-text := Text {
        x: 21 * root.rem-size / 14;
        width: parent.width - 42 * root.rem-size / 14;
        y: 1 * root.rem-size;
        height: parent.height - 2 * root.rem-size;
        text: root.label;
        vertical-alignment: center;
        wrap: word-wrap;
        font-size: 1 * root.rem-size;
        color: Theme.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked(root.action);
        }
    }
}

export component MetaItem inherits Rectangle {
    in property <PosterData> card;
    in property <bool> selected;
    /// Library only: new Videos the addons reported, drawn as the layered "+N" badge.
    in property <int> new-videos: 0;
    in property <float> poster-shape-ratio;
    in property <length> rem-size;
    /// Set by a card that draws its link larger than this one, such as the Library tile.
    in property <bool> hovered-by-owner: false;
    /// Whether the pointer is on the card, for the action-menu button and the ring.
    /// The web keeps one `hovered` class on the whole `.meta-item-container`, set from a pointer
    /// listener on that container, so the card stays hovered while the pointer is on any of its own
    /// controls. Here the controls are separate touch areas drawn over the card -- each one takes
    /// the hover from the card's own -- so each is named too, or the poster's outline and the ✕
    /// would flicker off the moment the pointer reached them.
    out property <bool> is-hovered: root.hovered-by-owner || card-touch.has-hover
        || play-touch.has-hover || dismiss-touch.has-hover || menu-touch.has-hover;
    callback clicked();
    /// The pointer came to rest on this card. The Discover panel asks for the card's pictures
    /// then, so opening it does not have to wait for a download.
    callback hovered();

    // Web: the action list is part of `<MetaItem>`, so the Library grid and the Board's Continue
    // Watching row draw the same one. The window's box is passed in for the list's own sake: a
    // popup is drawn inside the window, so a list past its edge would be clipped.
    in property <bool> menu-enabled: false;
    in property <length> viewport-width;
    in property <length> viewport-height;
    out property <bool> menu-open: menu.is-open;
    /// True while the button is up: the pointer is on it, or the list is open.
    out property <bool> menu-active: menu-touch.has-hover || root.menu-open;
    /// One option of the list: "details", "dismiss", "watched" or "remove".
    callback item-action(string);
    /// Web: `LibItem` builds the list and then filters it, and the two entries below are only
    /// there when the caller asks for them -- the Library does, the Board's Continue Watching row
    /// does not, so that card's list is Details and Dismiss only.
    in property <bool> menu-offers-watched: false;
    in property <bool> menu-offers-remove: false;
    /// Web: `onDismissClick` is what draws the ✕ on the poster, and only the Continue Watching
    /// item wrapper passes one -- a Library card has the same list but no ✕.
    in property <bool> dismissable: false;
    /// Web: 9rem wide. A right-click opens the list at the pointer, so the two ways to open it are
    /// kept apart by this flag.
    property <length> menu-width: 126 * root.rem-size / 14;
    property <bool> menu-at-pointer: false;
    property <length> pointer-x: 0px;
    property <length> pointer-y: 0px;

    /// Escape closes the list, the way the web's menus do. Slint's popup close policies only
    /// cover clicks, so the card holds the keyboard itself -- but only while the list is open, or
    /// one of these would swallow the key on every card in the row.
    menu-keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                menu.close();
                return accept;
            }
            return reject;
        }
    }

    public function open-menu-at(x: length, y: length) {
        if (!root.menu-enabled) {
            return;
        }
        root.pointer-x = x;
        root.pointer-y = y;
        root.menu-at-pointer = true;
        menu.show();
        menu-keys.focus();
    }

    // The button opens the same list; both ways take the keyboard, and Escape gives it back.
    changed menu-open => {
        if (root.menu-open) {
            menu-keys.focus();
        }
    }

    meta-item-link := Rectangle {
        x: root.rem-size;
        y: root.rem-size;
        width: root.width - 2 * root.rem-size;
        height: root.height - 2 * root.rem-size;
        background: ClassStyles.background-or(ClassStyles.meta-item-link, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.meta-item-link, 1.0);
        visible: !ClassStyles.meta-item-link.hidden;

        // Web: box-shadow 0 0 0 0.2rem on the poster of a selected or hovered card.
        selection-ring := Rectangle {
            x: -0.2 * root.rem-size;
            y: -0.2 * root.rem-size;
            width: parent.width + 0.4 * root.rem-size;
            height: poster-container.height + 0.4 * root.rem-size;
            border-radius: 0.95 * root.rem-size;
            border-width: 0.2 * root.rem-size;
            border-color: white;
            visible: root.selected || root.is-hovered;
        }

        poster-container := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: self.width * root.poster-shape-ratio;
            background: ClassStyles.background-or(ClassStyles.poster-container, Theme.overlay);
            border-radius: 0.75 * root.rem-size;
            opacity: ClassStyles.opacity-or(ClassStyles.poster-container, 1.0);
            visible: !ClassStyles.poster-container.hidden;
            clip: true;

            if root.card.has-poster: poster-image := Image {
                source: root.card.poster;
                width: 100%;
                height: 100%;
                image-fit: cover;
                opacity: ClassStyles.opacity-or(ClassStyles.poster-image, 0.9);
                // Web: .poster-image-layer scales to 1.05 while the card is selected or hovered.
                transform-scale: (root.selected || root.is-hovered) ? 1.05 : 1.0;
                visible: !ClassStyles.poster-image.hidden;
            }

            // Web: `.progress-bar-layer` -- 1rem in from the poster's left, right and bottom,
            // 0.45rem tall with half its height as the radius. The played part is the foreground
            // colour and the rest is the same colour at 30%, which is what `.progress-bar` over
            // `.progress-bar-background` composites to.
            if root.card.progress > 0: progress-bar-layer := Rectangle {
                x: 1 * root.rem-size;
                y: parent.height - self.height - 1 * root.rem-size;
                width: parent.width - 2 * root.rem-size;
                height: 0.45 * root.rem-size;
                border-radius: self.height / 2;
                clip: true;

                Rectangle {
                    width: parent.width * Math.min(Math.max(root.card.progress, 0), 100) / 100;
                    height: parent.height;
                    background: Theme.text;
                }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.text;
                    opacity: 0.3;
                }
            }

            // Web: `.watched-icon-layer` -- a 1.5rem accent circle 0.5rem in from the top-left,
            // with a white checkmark at half its size.
            if root.card.watched: Rectangle {
                x: 0.5 * root.rem-size;
                y: 0.5 * root.rem-size;
                width: 1.5 * root.rem-size;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.accent;

                Path {
                    x: 0.35 * root.rem-size;
                    y: 0.35 * root.rem-size;
                    width: parent.width - 0.7 * root.rem-size;
                    height: parent.height - 0.7 * root.rem-size;
                    viewbox-width: 512;
                    viewbox-height: 512;
                    commands: "M421 128 L197 384 L101 288";
                    fill: transparent;
                    stroke: Theme.text;
                    stroke-width: 0.12 * root.rem-size;
                }
            }

            // Web: `.new-videos` -- three stacked 2.25x1.25rem labels stepping in from the top
            // right; the front one carries the add icon and the count in the accent colour.
            if root.new-videos > 0: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                Rectangle {
                    x: parent.width - 2.25 * root.rem-size - 0.5 * root.rem-size;
                    y: 0.5 * root.rem-size;
                    width: 2.25 * root.rem-size;
                    height: 1.25 * root.rem-size;
                    border-radius: 0.25 * root.rem-size;
                    background: Theme.text;
                    opacity: 0.4;
                }
                Rectangle {
                    x: parent.width - 2.25 * root.rem-size - 0.75 * root.rem-size;
                    y: 0.75 * root.rem-size;
                    width: 2.25 * root.rem-size;
                    height: 1.25 * root.rem-size;
                    border-radius: 0.25 * root.rem-size;
                    background: Theme.text;
                    opacity: 0.6;
                }
                Rectangle {
                    x: parent.width - 2.25 * root.rem-size - 1 * root.rem-size;
                    y: 1 * root.rem-size;
                    width: 2.25 * root.rem-size;
                    height: 1.25 * root.rem-size;
                    border-radius: 0.25 * root.rem-size;
                    background: Theme.text;

                    Path {
                        x: 0.35 * root.rem-size;
                        y: (parent.height - self.height) / 2;
                        width: 0.8 * root.rem-size;
                        height: self.width;
                        viewbox-width: 512;
                        viewbox-height: 512;
                        commands: "M256 112 L256 400 M112 256 L400 256";
                        fill: transparent;
                        stroke: Theme.accent;
                        stroke-width: 0.08 * root.rem-size;
                    }
                    Text {
                        x: 1.15 * root.rem-size;
                        width: parent.width - 1.3 * root.rem-size;
                        height: parent.height;
                        text: "+\\{root.new-videos}";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        font-size: 0.8 * root.rem-size;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }
            }
        }

        title-bar-container := Rectangle {
            x: 0px;
            y: poster-container.height;
            width: parent.width;
            height: 4 * root.rem-size;
            background: ClassStyles.background-or(ClassStyles.title-bar-container, transparent);
            opacity: ClassStyles.opacity-or(ClassStyles.title-bar-container, 1.0);
            visible: !ClassStyles.title-bar-container.hidden;

            // Web: -webkit-line-clamp 2. Two lines of height, centred in the 4rem bar; Slint elides the last line that fits.
            title-measure := Text {
                width: parent.width - root.rem-size;
                text: root.card.title;
                wrap: word-wrap;
                font-size: root.rem-size;
                font-weight: 600;
                visible: false;
            }

            title-label := Text {
                x: 0.5 * root.rem-size;
                width: parent.width - root.rem-size;
                height: Math.min(title-measure.preferred-height, 2.6 * root.rem-size);
                y: (parent.height - self.height) / 2;
                text: root.card.title;
                horizontal-alignment: center;
                vertical-alignment: top;
                wrap: word-wrap;
                overflow: elide;
                font-size: root.rem-size;
                font-weight: 600;
                color: ClassStyles.color-or(ClassStyles.title-label, Theme.text);
                opacity: ClassStyles.opacity-or(ClassStyles.title-label, 1.0);
                visible: !ClassStyles.title-label.hidden;
            }
        }

        card-touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) {
                    root.hovered();
                }
            }
            // The right button never reaches `clicked`; it arrives here as a press and a release,
            // and the list opens from the release. Opening on the press instead left the next
            // right-click closing the list without reopening it, because a press outside a popup
            // is also what dismisses it.
            pointer-event(event) => {
                if (root.menu-enabled && event.button == PointerEventButton.right
                        && event.kind == PointerEventKind.up) {
                    // This area sits 1rem inside the card, and the popup's coordinates start at
                    // the card's edge, so the gutter goes back on here.
                    root.open-menu-at(self.mouse-x + root.rem-size, self.mouse-y + root.rem-size);
                }
            }
            clicked => {
                root.clicked();
            }
        }
    }

    // Drawn on every card and switched on where the web offers the list, rather than put
    // behind an `if`: an id inside a conditional is out of reach from the rest of the card,
    // and the list has to be opened from a public function.
    // Web: `<MetaItem>`'s `.play-icon-layer` -- a 4rem circle centred on the poster, drawn
    // whenever the title has a Stream at hand. Its ring is the foreground colour inset by 0.15rem;
    // under the pointer the ring turns transparent and the circle fills with the accent colour,
    // and the poster behind it scales to 1.05 (which it already does for any hovered card).
    play-button := Rectangle {
        visible: root.card.playable;
        x: root.rem-size + (root.width - 2 * root.rem-size) / 2 - 2 * root.rem-size;
        y: root.rem-size + (root.width - 2 * root.rem-size) * root.poster-shape-ratio / 2
            - 2 * root.rem-size;
        width: 4 * root.rem-size;
        height: self.width;
        border-radius: self.width / 2;
        // Web: `.play-icon-background` -- `--primary-background-color` at 0.4 until the card is
        // under the pointer, then `--secondary-accent-color` (the green) at full strength. It was
        // the purple primary accent here, which the web never uses for this button.
        background: root.is-hovered ? Theme.accent-green : Theme.background;
        opacity: root.is-hovered ? 1.0 : 0.4;

        // `.play-icon-outer`: a 0.15rem ring just inside the circle's edge.
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: self.width / 2;
            border-width: 0.15 * root.rem-size;
            border-color: root.is-hovered ? transparent : Theme.text;
        }

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 2.25 * root.rem-size;
            height: self.width;
            source: @image-url("icons/play.svg");
            colorize: Theme.text;
        }

        play-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.item-action("play");
            }
        }
    }

    // Web: `<MetaItem>`'s `.dismiss-icon-layer` -- a 1.5rem circle 0.5rem in from the poster's
    // top-left, `opacity: 0` and out of reach until the card is hovered. Only the Continue
    // Watching item passes `onDismissClick`, so only its cards draw one.
    dismiss-button := Rectangle {
        visible: root.dismissable;
        x: root.rem-size + 0.5 * root.rem-size;
        y: root.rem-size + 0.5 * root.rem-size;
        width: 1.5 * root.rem-size;
        height: self.width;
        opacity: root.is-hovered ? 1.0 : 0.0;

        // `.dismiss-icon-backdrop`: the page colour at 0.6 behind a white glyph at 0.8. Under the
        // pointer the disc goes more solid and the glyph to full white -- the web never brightens
        // either, but the ✕ is one control among a poster's worth of them and it should read as
        // one, and as the one that is about to be pressed.
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: self.width / 2;
            background: Theme.background;
            opacity: dismiss-touch.has-hover ? 0.85 : 0.6;
        }

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 1.25 * root.rem-size;
            height: self.width;
            source: @image-url("icons/close.svg");
            colorize: Theme.text;
            opacity: dismiss-touch.has-hover ? 1.0 : 0.8;
        }

        dismiss-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.item-action("dismiss");
            }
        }
    }

    menu-button := Rectangle {
        out property <bool> is-hovered: menu-touch.has-hover;
        visible: root.menu-enabled;
        // Web: `.menu-label-container` -- 1rem in from the right and bottom, a 1.5rem glyph at 0.6
        // opacity, and `opacity: 0` until the card is hovered. The web dims the button rather than
        // hiding it, so the corner is still pressed while the glyph is invisible; Slint skips
        // hit-testing below `opacity: 0`, so the glyph carries the fade and the button stays
        // pressable.
        //
        // `right: 1rem` is measured from the card's outer edge, which puts the button a
        // gutter-width outside the title column rather than inside it.
        x: parent.width - 1.5 * root.rem-size;
        y: parent.height - 5 * root.rem-size;
        width: 1.5 * root.rem-size;
        height: 4 * root.rem-size;

        Image {
            x: 0px;
            // Web: `padding: 1rem 0` on a 4rem box leaves a 1.5rem square slot in the middle, and
            // the square is what keeps the dots round: a 1.5rem x 2rem box stretches them into
            // little ovals.
            y: 1.25 * root.rem-size;
            width: 1.5 * root.rem-size;
            height: 1.5 * root.rem-size;
            // Web: `more-vertical`. Turning `more-horizontal` a quarter turn at run time did
            // nothing here -- the same three dots came out horizontal, stretched to the box -- so
            // the dots are turned in the asset instead.
            source: @image-url("icons/more-vertical.svg");
            colorize: Theme.text;
            opacity: (root.is-hovered || root.menu-active) ? 0.6 : 0.0;
        }
        menu-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.menu-open) {
                    menu.close();
                } else {
                    // The button always opens from its own corner, even after a right-click moved
                    // the list somewhere else.
                    root.menu-at-pointer = false;
                    menu.show();
                }
            }
        }
    }

    menu := PopupWindow {
        // Web: 9rem wide, opening from the button's left edge and from its bottom, so the list
        // hangs off the card's bottom-right corner instead of sitting inside the card.
        //
        // A right-click opens the same list at the pointer instead: pulled back when it would run
        // off the window's right edge, and flipped above the pointer when it would run past the
        // bottom one. The popup is drawn inside the window, so a list past either edge is clipped.
        // Its coordinates start at the card's own box, so the window's edges are the card's
        // position taken back off again.
        x: root.menu-at-pointer
            ? Math.max(-root.absolute-position.x, Math.min(root.pointer-x,
                root.viewport-width - root.absolute-position.x - root.menu-width))
            : Math.max(0px, root.width - 21 * root.rem-size / 14);
        y: root.menu-at-pointer
            ? (root.pointer-y + options-layout.preferred-height
                    > root.viewport-height - root.absolute-position.y
                ? Math.max(-root.absolute-position.y, root.pointer-y - options-layout.preferred-height)
                : root.pointer-y)
            : root.height - 1 * root.rem-size;
        width: root.menu-width;
        height: options-layout.preferred-height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 0.75 * root.rem-size;
            background: Theme.modal-background;
            drop-shadow-blur: 15px;
            drop-shadow-color: #7b5bf55e;
            clip: true;

            options-layout := VerticalLayout {
                // Web: `LibItem`'s list leads with Play, and drops it when there is no player link.
                if root.card.playable: CardMenuOption {
                    label: "Play";
                    action: "play";
                    rem-size: root.rem-size;
                    picked(action) => {
                        menu.close();
                        root.item-action(action);
                    }
                }
                CardMenuOption {
                    label: "Details";
                    action: "details";
                    rem-size: root.rem-size;
                    picked(action) => {
                        menu.close();
                        root.item-action(action);
                    }
                }
                if root.card.progress > 0: CardMenuOption {
                    label: "Dismiss";
                    action: "dismiss";
                    rem-size: root.rem-size;
                    picked(action) => {
                        menu.close();
                        root.item-action(action);
                    }
                }
                if root.menu-offers-watched: CardMenuOption {
                    label: root.card.watched ? "Mark as unwatched" : "Mark as watched";
                    action: "watched";
                    rem-size: root.rem-size;
                    picked(action) => {
                        menu.close();
                        root.item-action(action);
                    }
                }
                if root.menu-offers-remove: CardMenuOption {
                    label: "Remove";
                    action: "remove";
                    rem-size: root.rem-size;
                    picked(action) => {
                        menu.close();
                        root.item-action(action);
                    }
                }
            }
        }
    }
}

component MetaRow inherits Rectangle {
    in property <CatalogRow> catalog;
    in property <length> rem-size;
    in property <int> visible-items;
    /// The window's box, for a card's action list.
    in property <length> viewport-width;
    in property <length> viewport-height;
    callback open-item(string, string, string);
    callback item-action(string, string);

    property <float> poster-shape-ratio: root.catalog.shape == "square" ? 1.0
        : root.catalog.shape == "landscape" ? 0.5625 : 1.464;
    property <length> item-width: root.width / root.visible-items;
    property <length> item-height: 2 * root.rem-size
        + (root.item-width - 2 * root.rem-size) * root.poster-shape-ratio
        + 4 * root.rem-size;
    height: 2.75 * root.rem-size + root.item-height;

    header-container := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 2.5 * root.rem-size;
        background: ClassStyles.background-or(ClassStyles.header-container, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.header-container, 1.0);
        visible: !ClassStyles.header-container.hidden;

        title-container := Text {
            x: root.rem-size;
            y: 0px;
            width: see-all-container.x - 2 * root.rem-size;
            height: parent.height;
            text: root.catalog.title;
            vertical-alignment: center;
            overflow: elide;
            font-size: 1.6 * root.rem-size;
            font-weight: 500;
            color: ClassStyles.color-or(ClassStyles.title-container, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.title-container, 1.0);
            visible: !ClassStyles.title-container.hidden;
        }

        see-all-container := Rectangle {
            width: see-all-layout.preferred-width;
            height: 2.5 * root.rem-size;
            x: parent.width - self.width - root.rem-size;
            y: 0px;
            border-radius: 2.5 * root.rem-size;
            background: ClassStyles.background-or(ClassStyles.see-all-container, transparent);
            opacity: ClassStyles.opacity-or(ClassStyles.see-all-container, 0.6);
            visible: !ClassStyles.see-all-container.hidden;

            see-all-layout := HorizontalLayout {
                padding-left: root.rem-size;
                padding-right: 0.5 * root.rem-size;
                spacing: 0.5 * root.rem-size;

                label := Text {
                    text: "See All";
                    vertical-alignment: center;
                    font-size: root.rem-size;
                    font-weight: 500;
                    color: ClassStyles.color-or(ClassStyles.see-all-container, Theme.text);
                }
                icon := Image {
                    source: @image-url("icons/chevron-forward.svg");
                    width: 1.5 * root.rem-size;
                    colorize: ClassStyles.color-or(ClassStyles.see-all-container, Theme.text);
                }
            }
        }
    }

    meta-items-container := Rectangle {
        x: 0px;
        y: 2.75 * root.rem-size;
        width: parent.width;
        height: root.item-height;
        background: ClassStyles.background-or(ClassStyles.meta-items-container, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.meta-items-container, 1.0);
        visible: !ClassStyles.meta-items-container.hidden;

        for card[index] in root.catalog.cards: MetaItem {
            x: index * root.item-width;
            y: 0px;
            width: root.item-width;
            height: root.item-height;
            visible: index < root.visible-items;
            card: card;
            rem-size: root.rem-size;
            poster-shape-ratio: root.poster-shape-ratio;
            menu-enabled: root.catalog.menu;
            // Web: `ContinueWatchingItem` is the one caller that passes `onDismissClick`, and it
            // passes `actionMenu` with it, so a row that offers the list is a row that offers the ✕.
            dismissable: root.catalog.menu;
            viewport-width: root.viewport-width;
            viewport-height: root.viewport-height;
            clicked => {
                root.open-item(card.item-id, card.kind, card.title);
            }
            item-action(action) => {
                root.item-action(card.item-id, action);
            }
        }
    }
}

export component BoardContent inherits Rectangle {
    in property <[CatalogRow]> rows;
    in property <length> viewport-width;
    callback open-item(string, string, string);
    callback item-action(string, string);

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    /// The window's height, as the Library content derives it: this box reaches the window's bottom
    /// edge, so its own corner plus its height is the window's.
    property <length> viewport-height: root.absolute-position.y + root.height;
    property <int> poster-items: root.viewport-width <= 800px ? 4
        : root.viewport-width <= 1000px ? 5
        : root.viewport-width <= 1300px ? 6
        : root.viewport-width <= 1600px ? 7
        : root.viewport-width <= 1900px ? 8
        : root.viewport-width <= 2200px ? 9 : 10;

    board-content := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            alignment: start;
            padding-left: root.rem-size;
            padding-right: root.rem-size;
            padding-top: root.rem-size;
            padding-bottom: 2 * root.rem-size;
            spacing: 2 * root.rem-size;

            for entry in root.rows: board-row := MetaRow {
                catalog: entry;
                background: ClassStyles.background-or(ClassStyles.board-row, transparent);
                opacity: ClassStyles.opacity-or(ClassStyles.board-row, 1.0);
                visible: !ClassStyles.board-row.hidden;
                rem-size: root.rem-size;
                visible-items: entry.shape == "landscape" && root.poster-items < 10
                    ? root.poster-items - 1 : root.poster-items;
                viewport-width: root.viewport-width;
                viewport-height: root.viewport-height;
                open-item(id, kind, title) => {
                    root.open-item(id, kind, title);
                }
                item-action(id, action) => {
                    root.item-action(id, action);
                }
            }
        }
    }
}
