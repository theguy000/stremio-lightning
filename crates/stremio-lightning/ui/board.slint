import { ClassStyles } from "class-styles.slint";
import { MetaItem, PosterData } from "primitives/meta-item.slint";
import { BoardSpotlight, SpotlightSlide } from "board/spotlight.slint";
import { BoardSpotlightPlaceholder } from "board/spotlight-placeholder.slint";
import { Theme } from "theme.slint";

export { MetaItem, PosterData, SpotlightSlide }

export struct CatalogRow {
    title: string,
    shape: string,
    menu: bool,
    cards: [PosterData],
}

export global BoardUi {
    in-out property <[CatalogRow]> rows: [];
    in-out property <[SpotlightSlide]> spotlight: [];
    in-out property <[string]> spotlight-labels: [];
    in-out property <string> spotlight-key;
    in-out property <bool> spotlight-loading: false;
    in-out property <bool> scrolled-past-spotlight: false;
    callback board-visible(length, length, length, length);
    callback item-action(string, string);
    callback spotlight-library(string, string, bool);
    callback spotlight-trailer(string);
}

component MetaRow inherits Rectangle {
    in property <CatalogRow> catalog;
    in property <length> rem-size;
    in property <int> visible-items;
    /// Whether this row is within the viewport (plus slack) so off-screen rows unmount their
    /// cards and release FemtoVG's per-card rounded-clip FBO and poster texture caches.
    in property <bool> row-visible: true;
    in property <length> viewport-width;
    in property <length> viewport-height;
    callback open-item(string, string, string);
    callback item-action(string, string);

    property <float> poster-shape-ratio: Theme.poster-ratio(root.catalog.shape);
    property <length> item-width: root.width / root.visible-items;
    property <length> item-height: 2 * root.rem-size
        + (root.item-width - 2 * root.rem-size) * root.poster-shape-ratio
        + 4 * root.rem-size;
    height: 2.75 * root.rem-size + root.item-height;

    header-container := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 2.5 * root.rem-size;
        background: ClassStyles.background-or(ClassStyles.header-container, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.header-container, 1.0);
        visible: !ClassStyles.header-container.hidden;

        title-container := Text {
            x: root.rem-size;
            y: 0px;
            width: see-all-container.x - 2 * root.rem-size;
            height: parent.height;
            text: root.catalog.title;
            vertical-alignment: center;
            overflow: elide;
            font-size: 1.6 * root.rem-size;
            font-weight: 500;
            color: ClassStyles.color-or(ClassStyles.title-container, Theme.text);
            opacity: ClassStyles.opacity-or(ClassStyles.title-container, 1.0);
            visible: !ClassStyles.title-container.hidden;
        }

        see-all-container := Rectangle {
            width: see-all-layout.preferred-width;
            height: 2.5 * root.rem-size;
            x: parent.width - self.width - root.rem-size;
            y: 0px;
            border-radius: 2.5 * root.rem-size;
            background: ClassStyles.background-or(ClassStyles.see-all-container, transparent);
            opacity: ClassStyles.opacity-or(ClassStyles.see-all-container, 0.6);
            visible: !ClassStyles.see-all-container.hidden;

            see-all-layout := HorizontalLayout {
                padding-left: root.rem-size;
                padding-right: 0.5 * root.rem-size;
                spacing: 0.5 * root.rem-size;

                label := Text {
                    text: "See All";
                    vertical-alignment: center;
                    font-size: root.rem-size;
                    font-weight: 500;
                    color: ClassStyles.color-or(ClassStyles.see-all-container, Theme.text);
                }
                icon := Image {
                    source: @image-url("icons/chevron-forward.svg");
                    width: 1.5 * root.rem-size;
                    colorize: ClassStyles.color-or(ClassStyles.see-all-container, Theme.text);
                }
            }
        }
    }

    meta-items-container := Rectangle {
        x: 0px;
        y: 2.75 * root.rem-size;
        width: parent.width;
        height: root.item-height;
        background: ClassStyles.background-or(ClassStyles.meta-items-container, transparent);
        opacity: ClassStyles.opacity-or(ClassStyles.meta-items-container, 1.0);
        visible: !ClassStyles.meta-items-container.hidden;

        for card[index] in root.catalog.cards: Rectangle {
            x: index * root.item-width;
            y: 0px;
            width: root.item-width;
            height: root.item-height;

            if root.row-visible && index < root.visible-items: MetaItem {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                card: card;
                rem-size: root.rem-size;
                poster-shape-ratio: root.poster-shape-ratio;
                menu-enabled: root.catalog.menu;
                dismissable: root.catalog.menu;
                viewport-width: root.viewport-width;
                viewport-height: root.viewport-height;
                clicked => {
                    root.open-item(card.item-id, card.kind, card.title);
                }
                item-action(action) => {
                    root.item-action(card.item-id, action);
                }
            }
        }
    }
}

export component BoardContent inherits Rectangle {
    in property <length> viewport-width;
    in property <length> nav-width: 0px;
    in property <length> bar-height: 0px;
    in-out property <length> scroll-offset <=> board-content.content-y;
    callback scroll-bounds(length, length, length, length, length);
    callback open-item(string, string, string);
    callback item-action(string, string);

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <bool> has-spotlight: BoardUi.spotlight.length > 0 || BoardUi.spotlight-loading;
    property <length> hero-height: root.height <= 520px
        ? Math.max(24 * root.rem-size, root.height - 0.5 * root.rem-size)
        : Math.max(38 * root.rem-size, Math.min(56 * root.rem-size, Math.min(root.height * 0.62, root.viewport-width * 0.56)));
    property <length> rows-top: root.has-spotlight ? Math.max(0px, root.hero-height - 3.5 * root.rem-size) : 0px;
    property <color> fade-base: Theme.amoled ? #000000 : #121024;
    property <length> watched-width: board-content.width;
    property <length> watched-height: board-content.height;
    property <length> watched-content: board-content.content-height;
    property <length> watched-y: board-content.content-y;
    changed watched-width => { root.report-bounds(); root.report-visible(); root.update-scrolled(); }
    changed watched-height => { root.clamp-scroll(); root.report-bounds(); root.report-visible(); root.update-scrolled(); }
    changed watched-content => { root.clamp-scroll(); root.report-bounds(); }
    changed watched-y => { root.report-visible(); root.update-scrolled(); }
    changed has-spotlight => { root.clamp-scroll(); root.report-bounds(); root.report-visible(); root.update-scrolled(); }
    changed hero-height => { root.update-scrolled(); }
    changed bar-height => { root.update-scrolled(); }
    init => { root.clamp-scroll(); root.report-bounds(); root.report-visible(); root.update-scrolled(); }

    function clamp-scroll() {
        board-content.content-y = Math.max(
            Math.min(0px, board-content.height - board-content.content-height),
            Math.min(0px, board-content.content-y),
        );
    }

    function update-scrolled() {
        BoardUi.scrolled-past-spotlight = root.has-spotlight
            && (-board-content.content-y >= root.hero-height - root.bar-height);
    }

    function report-bounds() {
        root.scroll-bounds(
            board-content.absolute-position.x,
            board-content.absolute-position.y,
            board-content.width,
            board-content.height,
            board-content.content-height,
        );
    }

    function report-visible() {
        BoardUi.board-visible(
            -board-content.content-y,
            board-content.height,
            board-content.width - (root.has-spotlight ? root.nav-width : 0px),
            root.viewport-width,
        );
    }
    property <length> viewport-height: root.absolute-position.y + root.height;
    property <int> poster-items: root.viewport-width <= 800px ? 4
        : root.viewport-width <= 1000px ? 5
        : root.viewport-width <= 1300px ? 6
        : root.viewport-width <= 1600px ? 7
        : root.viewport-width <= 1900px ? 8
        : root.viewport-width <= 2200px ? 9 : 10;

    board-content := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: Math.max(root.has-spotlight ? root.hero-height : 0px, root.rows-top + board-rows.preferred-height);

        if BoardUi.spotlight.length > 0: BoardSpotlight {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.hero-height;
            slides: BoardUi.spotlight;
            slide-labels: BoardUi.spotlight-labels;
            slide-key: BoardUi.spotlight-key;
            offscreen: BoardUi.scrolled-past-spotlight;
            rem-size: root.rem-size;
            nav-width: root.nav-width;
            bar-height: root.bar-height;
            open-item(id, kind, title) => { root.open-item(id, kind, title); }
            toggle-library(id, kind, in-lib) => { BoardUi.spotlight-library(id, kind, in-lib); }
            open-trailer(url) => { BoardUi.spotlight-trailer(url); }
        }

        if BoardUi.spotlight.length == 0 && BoardUi.spotlight-loading: BoardSpotlightPlaceholder {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.hero-height;
            rem-size: root.rem-size;
            nav-width: root.nav-width;
        }

        // Seamless dissolve below hero-height behind Continue Watching into Theme.page-background.
        if BoardUi.spotlight.length > 0: Rectangle {
            x: 0px;
            y: root.hero-height;
            width: parent.width;
            height: 3.5 * root.rem-size;
            background: @linear-gradient(180deg, root.fade-base 0%, root.fade-base.with-alpha(0.0) 100%);
        }

        board-rows := VerticalLayout {
            x: root.has-spotlight ? root.nav-width : 0px;
            y: root.rows-top;
            width: parent.width - self.x;
            height: self.preferred-height;
            alignment: start;
            padding-left: root.rem-size;
            padding-right: root.rem-size;
            padding-top: root.has-spotlight ? 0px : root.rem-size;
            padding-bottom: 2 * root.rem-size;
            spacing: 2 * root.rem-size;

            for entry in BoardUi.rows: board-row := MetaRow {
                catalog: entry;
                background: ClassStyles.background-or(ClassStyles.board-row, transparent);
                opacity: ClassStyles.opacity-or(ClassStyles.board-row, 1.0);
                visible: !ClassStyles.board-row.hidden;
                rem-size: root.rem-size;
                row-visible: board-content.height <= 0px
                    || (root.rows-top + self.y + self.height >= -board-content.content-y - self.height
                        && root.rows-top + self.y <= -board-content.content-y + board-content.height + self.height);
                visible-items: entry.shape == "landscape" && root.poster-items < 10
                    ? root.poster-items - 1 : root.poster-items;
                viewport-width: root.viewport-width;
                viewport-height: root.viewport-height;
                open-item(id, kind, title) => {
                    root.open-item(id, kind, title);
                }
                item-action(id, action) => {
                    root.item-action(id, action);
                }
            }
        }
    }
}
