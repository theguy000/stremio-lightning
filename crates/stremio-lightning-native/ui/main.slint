import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HorizontalNavBar, Section, VerticalNavBar } from "shell.slint";
import { BoardContent, CatalogRow, PosterData } from "board.slint";
import { DiscoverContent, SelectInputData } from "discover.slint";
import { SelectOption } from "multiselect-menu.slint";
import { LinkGroup, PreviewData } from "meta-preview.slint";
export { LinkGroup, PreviewData, SelectInputData, SelectOption }
import { ClassStyle, ClassStyles } from "class-styles.slint";

export { CatalogRow, ClassStyle, ClassStyles, PosterData }

export struct StreamData {
    name: string,
    description: string,
}

export component MainWindow inherits Window {
    title: "Stremio Lightning";
    default-font-family: Theme.font-family;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Theme.page-background;

    in property <string> status: "Loading...";
    in property <string> server-status: "Stream server: starting...";
    in property <[CatalogRow]> rows: [];
    in property <[PosterData]> discover-cards: [];
    in property <string> discover-shape: "poster";
    in property <[SelectInputData]> discover-inputs: [];
    in property <[PreviewData]> discover-previews: [];

    in-out property <bool> details-open: false;
    in property <string> details-title;
    in property <string> details-description;
    in property <image> details-poster;
    in property <bool> details-has-poster: false;
    in property <string> details-status;
    in property <[StreamData]> streams: [];
    in-out property <bool> playing: false;
    in-out property <Section> section: Section.board;
    property <length> rem-size: Theme.rem-size(root.width);
    property <length> nav-width: root.playing ? 0px : 6 * root.rem-size;
    property <length> bar-height: root.playing ? 0px : 5.5 * root.rem-size;
    property <string> section-title: root.section == Section.discover ? "Discover"
        : root.section == Section.library ? "Library"
        : root.section == Section.calendar ? "Calendar"
        : root.section == Section.addons ? "Addons" : "Settings";
    in property <string> play-message;

    callback open-item(string, string, string);
    callback load-next-page();
    callback select-preview(int);
    callback select-input-option(int, int);
    callback play-stream(int);
    callback stop-playback();

    if root.section == Section.board && !root.details-open && !root.playing: BoardContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        rows: root.rows;
        viewport-width: root.width;
        open-item(id, kind, title) => {
            root.details-open = true;
            root.open-item(id, kind, title);
        }
    }

    if root.section == Section.discover && !root.details-open && !root.playing: DiscoverContent {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        cards: root.discover-cards;
        shape: root.discover-shape;
        inputs: root.discover-inputs;
        select-option(input, option) => {
            root.select-input-option(input, option);
        }
        previews: root.discover-previews;
        viewport-width: root.width;
        select-item(index) => {
            root.select-preview(index);
        }
        open-item(id, kind, title) => {
            root.details-open = true;
            root.open-item(id, kind, title);
        }
        load-next-page => {
            root.load-next-page();
        }
    }

    if root.details-open && !root.playing: VerticalLayout {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        padding: 24px;
        spacing: 14px;

        HorizontalLayout {
            alignment: start;
            Button {
                text: "< Back";
                clicked => {
                    root.details-open = false;
                }
            }
        }
        HorizontalLayout {
            spacing: 20px;
            Rectangle {
                width: 200px;
                height: 300px;
                background: #1b1a24;
                border-radius: 8px;
                clip: true;
                if root.details-has-poster: Image {
                    source: root.details-poster;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.details-title;
                    color: white;
                    font-size: 28px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.details-description;
                    color: #c9c7d8;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
        Text {
            text: "Streams";
            color: white;
            font-size: 18px;
            font-weight: 600;
        }
        Text {
            text: root.details-status;
            color: #9d9bb0;
            font-size: 13px;
        }
        Text {
            text: root.play-message;
            color: #ff8a8a;
            font-size: 13px;
            wrap: word-wrap;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 8px;
                for stream[index] in root.streams: Rectangle {
                    background: #1b1a24;
                    border-radius: 6px;
                    TouchArea {
                        clicked => {
                            root.play-stream(index);
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        spacing: 2px;
                        Text {
                            text: stream.name;
                            color: white;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: stream.description;
                            color: #9d9bb0;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    if !root.playing: VerticalNavBar {
        rem-size: root.rem-size;
        x: 0px;
        y: root.bar-height;
        height: parent.height - root.bar-height;
        section: root.section;
        select(target) => {
            root.details-open = false;
            root.section = target;
        }
    }

    if !root.playing: HorizontalNavBar {
        rem-size: root.rem-size;
        x: 0px;
        y: 0px;
        width: parent.width;
        toggle-fullscreen => {
            root.full-screen = !root.full-screen;
        }
    }

    if root.section != Section.board && root.section != Section.discover && !root.details-open && !root.playing: VerticalLayout {
        x: root.nav-width;
        y: root.bar-height;
        width: parent.width - root.nav-width;
        height: parent.height - root.bar-height;
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Text {
            text: root.section-title;
            color: white;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: "This screen is not built yet.";
            color: #9d9bb0;
            font-size: 14px;
        }
    }

    if root.playing: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 24px;
        alignment: start;

        HorizontalLayout {
            alignment: start;
            Button {
                text: "< Back";
                clicked => {
                    root.stop-playback();
                }
            }
        }
    }
}
