import { ScrollView } from "std-widgets.slint";

export struct PosterData {
    title: string,
    poster: image,
    has-poster: bool,
}

export struct CatalogRow {
    name: string,
    cards: [PosterData],
}

component PosterCard inherits Rectangle {
    in property <PosterData> card;
    width: 150px;
    height: 262px;

    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 225px;
            background: #1b1a24;
            border-radius: 6px;
            clip: true;
            if root.card.has-poster: Image {
                source: root.card.poster;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
        Text {
            text: root.card.title;
            color: #e6e4f2;
            font-size: 13px;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "Stremio Lightning";
    preferred-width: 1100px;
    preferred-height: 720px;
    background: #0c0b11;

    in property <string> status: "Loading...";
    in property <[CatalogRow]> rows: [];

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Text {
            text: "Board";
            color: white;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: root.status;
            color: #9d9bb0;
            font-size: 14px;
        }
        ScrollView {
            VerticalLayout {
                spacing: 20px;
                for row in root.rows: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: row.name;
                        color: white;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Flickable {
                        height: 270px;
                        content-width: row.cards.length * 160px;
                        HorizontalLayout {
                            width: row.cards.length * 160px;
                            spacing: 10px;
                            for card in row.cards: PosterCard {
                                card: card;
                            }
                        }
                    }
                }
            }
        }
    }
}
