import { Button, ScrollView } from "std-widgets.slint";

export struct PosterData {
    item-id: string,
    kind: string,
    title: string,
    poster: image,
    has-poster: bool,
}

export struct CatalogRow {
    name: string,
    cards: [PosterData],
}

export struct StreamData {
    name: string,
    description: string,
}

component PosterCard inherits Rectangle {
    in property <PosterData> card;
    callback clicked();
    width: 150px;
    height: 262px;

    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 225px;
            background: #1b1a24;
            border-radius: 6px;
            clip: true;
            if root.card.has-poster: Image {
                source: root.card.poster;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
        Text {
            text: root.card.title;
            color: #e6e4f2;
            font-size: 13px;
            overflow: elide;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component MainWindow inherits Window {
    title: "Stremio Lightning";
    preferred-width: 1100px;
    preferred-height: 720px;
    background: #0c0b11;

    in property <string> status: "Loading...";
    in property <[CatalogRow]> rows: [];

    in-out property <bool> details-open: false;
    in property <string> details-title;
    in property <string> details-description;
    in property <image> details-poster;
    in property <bool> details-has-poster: false;
    in property <string> details-status;
    in property <[StreamData]> streams: [];

    callback open-item(string, string, string);

    if !root.details-open: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 24px;
        spacing: 12px;

        Text {
            text: "Board";
            color: white;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: root.status;
            color: #9d9bb0;
            font-size: 14px;
        }
        ScrollView {
            VerticalLayout {
                spacing: 20px;
                for row in root.rows: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: row.name;
                        color: white;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Flickable {
                        height: 270px;
                        content-width: row.cards.length * 160px;
                        HorizontalLayout {
                            width: row.cards.length * 160px;
                            spacing: 10px;
                            for card in row.cards: PosterCard {
                                card: card;
                                clicked => {
                                    root.details-open = true;
                                    root.open-item(card.item-id, card.kind, card.title);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.details-open: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 24px;
        spacing: 14px;

        HorizontalLayout {
            alignment: start;
            Button {
                text: "< Back";
                clicked => {
                    root.details-open = false;
                }
            }
        }
        HorizontalLayout {
            spacing: 20px;
            Rectangle {
                width: 200px;
                height: 300px;
                background: #1b1a24;
                border-radius: 8px;
                clip: true;
                if root.details-has-poster: Image {
                    source: root.details-poster;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.details-title;
                    color: white;
                    font-size: 28px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.details-description;
                    color: #c9c7d8;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
        Text {
            text: "Streams";
            color: white;
            font-size: 18px;
            font-weight: 600;
        }
        Text {
            text: root.details-status;
            color: #9d9bb0;
            font-size: 13px;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 8px;
                for stream in root.streams: Rectangle {
                    background: #1b1a24;
                    border-radius: 6px;
                    VerticalLayout {
                        alignment: start;
                        padding: 10px;
                        spacing: 2px;
                        Text {
                            text: stream.name;
                            color: white;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: stream.description;
                            color: #9d9bb0;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
