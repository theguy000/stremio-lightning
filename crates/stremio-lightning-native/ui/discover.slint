// Based on stremio-web (https://github.com/Stremio/stremio-web),
// Copyright (C) 2017-2024 Smart code 203358507 (upstream's header; the end year varies per file).
// Layout numbers translated by hand from src/routes/Discover/styles.less, src/common/screen-sizes.less
// and src/components/MetaItem/styles.less.
// Licence basis: ../THIRD_PARTY_NOTICES.md. Element ids reuse the web class names where one exists.
import { MetaItem, PosterData } from "board.slint";
import { Theme } from "theme.slint";

// Web: <MultiselectMenu class="select-input">. Only the closed label is drawn so far.
component SelectInput inherits Rectangle {
    in property <string> label;
    in property <length> rem-size;
    height: 3 * root.rem-size;
    border-radius: 1.5 * root.rem-size;
    background: Theme.overlay;

    label-container := Text {
        x: 1.5 * root.rem-size;
        width: parent.width - 3.5 * root.rem-size - 1.5 * root.rem-size;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        overflow: elide;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
    }
    icon := Image {
        source: @image-url("icons/caret-down.svg");
        width: root.rem-size;
        height: root.rem-size;
        x: parent.width - 1.5 * root.rem-size - self.width;
        y: (parent.height - self.height) / 2;
        colorize: Theme.caret-icon;
    }
}

export struct LinkGroup {
    label: string,
    links: [string],
}

export struct PreviewData {
    title: string,
    runtime: string,
    release-info: string,
    rating: string,
    description: string,
    groups: [LinkGroup],
    has-trailer: bool,
    logo: image,
    has-logo: bool,
    background: image,
    has-background: bool,
}

// Web: .link-container inside MetaLinks.
component PreviewPill inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + 2 * (1.25 * root.rem-size + 2px);
    height: 2.4 * root.rem-size;
    border-radius: 2 * root.rem-size;
    background: Theme.overlay;

    label := Text {
        x: 1.25 * root.rem-size + 2px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        overflow: elide;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
    }
}

// Web: the 6px scroll bar from App/styles.less (thumb --overlay-color, accent on hover, transparent track).
component ScrollThumb inherits Rectangle {
    in property <length> view-height;
    in property <length> content-height;
    in property <length> offset;
    width: 6px;
    visible: root.content-height > root.view-height + 1px;
    property <length> thumb-height: Math.max(24px, root.view-height * root.view-height / Math.max(root.content-height, 1px));
    property <length> travel: root.view-height - root.thumb-height;

    thumb := Rectangle {
        x: 0px;
        width: parent.width;
        height: root.thumb-height;
        y: root.travel * Math.min(Math.max(-root.offset / Math.max(root.content-height - root.view-height, 1px), 0), 1);
        border-radius: 3px;
        // Web: ::-webkit-scrollbar-thumb is --overlay-color (white at 5%). Its :hover accent rule does not apply in
        // Chrome when scrollbar-color is set, so the thumb stays white.
        background: Theme.overlay;
    }
}

// Web: MetaLinks. The label, then pills that wrap onto further lines (flex-wrap: wrap).
component PreviewLinks inherits VerticalLayout {
    in property <LinkGroup> group;
    in property <length> rem-size;
    spacing: 0px;
    padding-top: 1.5 * root.rem-size;

    label-container := Rectangle {
        height: 2 * root.rem-size;
        Text {
            x: 0px;
            y: 0px;
            height: 1.25 * root.rem-size;
            text: root.group.label;
            vertical-alignment: center;
            font-size: 0.95 * root.rem-size;
            font-weight: 700;
            color: Theme.text;
            opacity: 0.3;
        }
    }
    links-container := FlexboxLayout {
        spacing-horizontal: 0.75 * root.rem-size;
        spacing-vertical: 0.75 * root.rem-size;
        alignment: start;

        for link in root.group.links: link-container := PreviewPill {
            text: link;
            rem-size: root.rem-size;
        }
    }
    Rectangle {
        height: 0.75 * root.rem-size;
    }
}

// Web: .runtime-label and .release-info-label.
component InfoLabel inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + 0.8 * root.rem-size;

    label := Text {
        x: 0.4 * root.rem-size;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 1.25 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
    }
}

// Web: .imdb-button-container.
component ImdbButton inherits Rectangle {
    in property <string> text;
    in property <length> rem-size;
    width: label.preferred-width + root.rem-size + 3 * root.rem-size + 2 * (0.5 * root.rem-size + 2px);

    label := Text {
        x: 0.5 * root.rem-size + 2px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 1.25 * root.rem-size;
        font-weight: 600;
        color: Theme.text;
    }
    icon := Image {
        source: @image-url("icons/imdb.svg");
        colorize: Theme.imdb;
        
        x: label.x + label.preferred-width + root.rem-size;
        y: (parent.height - self.height) / 2;
        width: 3 * root.rem-size;
        height: 3 * root.rem-size;
    }
}

// Web: .action-button-container, round (4rem) or wide with a label.
component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> rem-size;
    height: 4 * root.rem-size;
    width: root.label == "" ? 4 * root.rem-size
        : 4 * root.rem-size + 1.75 * root.rem-size + root.rem-size + text.preferred-width + 0.4 * root.rem-size;
    border-radius: 4 * root.rem-size;
    background: Theme.overlay;

    icon-container := Image {
        source: root.icon;
        colorize: Theme.text;
        opacity: 0.9;
        width: 1.75 * root.rem-size;
        height: 1.75 * root.rem-size;
        x: root.label == "" ? (parent.width - self.width) / 2 : 2 * root.rem-size;
        y: (parent.height - self.height) / 2;
    }
    text := Text {
        visible: root.label != "";
        x: 2 * root.rem-size + 1.75 * root.rem-size + root.rem-size + 0.2 * root.rem-size;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        font-size: root.rem-size;
        font-weight: 500;
        color: Theme.text;
        opacity: 0.9;
    }
}

export component DiscoverContent inherits Rectangle {
    in property <[PosterData]> cards;
    in property <string> shape;
    in property <[string]> filters;
    in property <[PreviewData]> previews;
    in property <length> viewport-width;
    in-out property <int> selected-index: 0;
    callback open-item(string, string, string);
    callback load-next-page();
    callback select-item(int);

    property <length> rem-size: Theme.rem-size(root.viewport-width);
    property <bool> has-preview: root.previews.length > root.selected-index;
    property <PreviewData> preview: root.previews[root.selected-index];
    // Web: the preview panel is `display: none` from @xsmall (1000px) down.
    property <bool> preview-visible: root.viewport-width > 1000px;
    property <length> preview-width: root.preview-visible ? 29 * root.rem-size : 0px;
    property <length> catalog-width: root.width - root.preview-width;
    property <length> grid-right-margin: root.preview-visible ? 1.5 * root.rem-size : 0px;
    property <length> grid-width: root.catalog-width - root.grid-right-margin - 3 * root.rem-size;
    // The last matching rule in styles.less wins: 10 above 2800px, then 9, 8, 7, 6, 5, 4 (1300px),
    // and 5 again from 1000px down.
    property <int> columns: root.viewport-width > 2800px ? 10
        : root.viewport-width > 2500px ? 9
        : root.viewport-width > 2200px ? 8
        : root.viewport-width > 1900px ? 7
        : root.viewport-width > 1600px ? 6
        : root.viewport-width > 1300px ? 5
        : root.viewport-width > 1000px ? 4 : 5;
    property <length> gap: 0.5 * root.rem-size;
    property <length> cell-width: (root.grid-width - (root.columns - 1) * root.gap) / root.columns;
    property <float> poster-shape-ratio: root.shape == "square" ? 1.0
        : root.shape == "landscape" ? 0.5625 : 1.464;
    property <length> cell-height: 2 * root.rem-size
        + (root.cell-width - 2 * root.rem-size) * root.poster-shape-ratio
        + 4 * root.rem-size;
    property <int> row-count: Math.ceil(root.cards.length / root.columns);
    // Web: up to three inputs of 15rem that shrink together beside a 5rem filter button slot.
    property <int> input-count: Math.max(1, Math.min(root.filters.length, 3));
    property <length> input-width: Math.min(15 * root.rem-size,
        (root.catalog-width - 3 * root.rem-size - 5 * root.rem-size
            - (root.input-count - 1) * 1.5 * root.rem-size) / root.input-count);

    function check-end() {
        if (-meta-items-container.content-y + meta-items-container.height
            > meta-items-container.content-height - 400px) {
            root.load-next-page();
        }
    }

    discover-content := Rectangle {
        width: parent.width;
        height: parent.height;

        catalog-container := Rectangle {
            x: 0px;
            width: root.catalog-width;
            height: parent.height;

            selectable-inputs-container := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 6 * root.rem-size;

                for label[index] in root.filters: select-input := SelectInput {
                    x: 1.5 * root.rem-size + index * (root.input-width + 1.5 * root.rem-size);
                    y: 1.5 * root.rem-size;
                    width: root.input-width;
                    label: label;
                    rem-size: root.rem-size;
                    visible: index < 3;
                }
            }

            meta-items-container := Flickable {
                x: 0px;
                y: 6 * root.rem-size;
                width: root.catalog-width - root.grid-right-margin;
                height: parent.height - 6 * root.rem-size;
                content-width: self.width;
                content-height: root.row-count * root.cell-height + Math.max(root.row-count - 1, 0) * root.gap;
                changed content-y => {
                    root.check-end();
                }
                changed content-height => {
                    root.check-end();
                }

                for card[index] in root.cards: MetaItem {
                    x: 1.5 * root.rem-size + Math.mod(index, root.columns) * (root.cell-width + root.gap);
                    y: Math.floor(index / root.columns) * (root.cell-height + root.gap);
                    width: root.cell-width;
                    height: root.cell-height;
                    card: card;
                    selected: index == root.selected-index;
                    rem-size: root.rem-size;
                    poster-shape-ratio: root.poster-shape-ratio;
                    // Web: a click on a card that is not selected selects it, a second click opens it.
                    clicked => {
                        if (index == root.selected-index || !root.preview-visible) {
                            root.open-item(card.item-id, card.kind, card.title);
                        } else {
                            root.selected-index = index;
                            root.select-item(index);
                        }
                    }
                }
            }

            ScrollThumb {
                x: meta-items-container.x + meta-items-container.width - self.width;
                y: meta-items-container.y;
                height: meta-items-container.height;
                view-height: meta-items-container.height;
                content-height: meta-items-container.content-height;
                offset: meta-items-container.content-y;
            }
        }

        // Web: MetaPreview (compact). Selecting a card fills it.
        meta-preview-container := Rectangle {
            x: root.catalog-width;
            width: root.preview-width;
            height: parent.height;
            visible: root.preview-visible;
            background: Theme.modal-background;
            border-top-left-radius: 0.75 * root.rem-size;
            border-bottom-left-radius: 0.75 * root.rem-size;
            clip: true;

            // Web: blurred at 10px. Slint has no blur, so the image is fetched tiny and scaled up smoothly.
            if root.has-preview && root.preview.has-background: background-image-layer := Rectangle {
                x: -10px;
                y: -10px;
                width: parent.width + 20px;
                height: parent.height + 20px;

                background-image := Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview.background;
                    image-fit: cover;
                    opacity: 0.3;
                }
            }

            if root.has-preview: meta-info-container := Rectangle {
                x: 2.5 * root.rem-size;
                y: 2 * root.rem-size;
                width: root.preview-width - 5 * root.rem-size;
                height: parent.height - 12.5 * root.rem-size;

                info-flickable := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;

                    VerticalLayout {
                        spacing: 0px;
                        alignment: start;

                        Rectangle {
                            height: 8 * root.rem-size;
                            if root.preview.has-logo: logo := Image {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: 6 * root.rem-size;
                                source: root.preview.logo;
                                image-fit: contain;
                            }
                            if !root.preview.has-logo: logo-placeholder := Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: 6 * root.rem-size;
                                text: root.preview.title;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: top;
                                font-size: 1.7 * root.rem-size;
                                color: Theme.text;
                            }
                        }

                        runtime-release-info-container := HorizontalLayout {
                            height: 3.5714 * root.rem-size;
                            alignment: space-between;

                            if root.preview.runtime != "": runtime-label := InfoLabel {
                                text: root.preview.runtime;
                                rem-size: root.rem-size;
                            }
                            if root.preview.release-info != "": release-info-label := InfoLabel {
                                text: root.preview.release-info;
                                rem-size: root.rem-size;
                            }
                            if root.preview.rating != "": imdb-button-container := ImdbButton {
                                text: root.preview.rating;
                                rem-size: root.rem-size;
                            }
                        }

                        Rectangle {
                            height: root.rem-size;
                        }

                        // Web: line-height 2em. Slint's `line-height-factor` is relative to the font's natural line
                        // height, so the factor is two ems over the natural height, measured on a one-line text.
                        description-container := Rectangle {
                            height: Math.round(description-text.preferred-height / (2 * root.rem-size)) * 2 * root.rem-size;

                            description-line := Text {
                                text: "A";
                                font-size: root.rem-size;
                                visible: false;
                            }
                            description-text := Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                text: root.preview.description;
                                wrap: word-wrap;
                                font-size: root.rem-size;
                                line-height-factor: 2 * root.rem-size / description-line.preferred-height;
                                color: Theme.text;
                            }
                        }

                        for group in root.preview.groups: meta-links-container := PreviewLinks {
                            group: group;
                            rem-size: root.rem-size;
                        }
                    }
                }

                ScrollThumb {
                    x: parent.width - self.width;
                    y: 0px;
                    height: parent.height;
                    view-height: info-flickable.height;
                    content-height: info-flickable.content-height;
                    offset: info-flickable.content-y;
                }
            }

            if root.has-preview: action-buttons-container := HorizontalLayout {
                x: 2.5 * root.rem-size;
                y: parent.height - 7 * root.rem-size;
                width: root.preview-width - 5 * root.rem-size;
                height: 4 * root.rem-size;
                alignment: space-between;

                if root.preview.has-trailer: action-button-container := ActionButton {
                    icon: @image-url("icons/trailer.svg");
                    rem-size: root.rem-size;
                }
                group-container := Rectangle {
                    width: 8 * root.rem-size;
                    height: 4 * root.rem-size;
                    border-radius: 4 * root.rem-size;
                    background: Theme.overlay;

                    Image {
                        source: @image-url("icons/add-to-library.svg");
                        colorize: Theme.text;
                        opacity: 0.9;
                        x: (4 * root.rem-size - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1.75 * root.rem-size;
                        height: 1.75 * root.rem-size;
                    }
                    Image {
                        source: @image-url("icons/eye.svg");
                        colorize: Theme.text;
                        opacity: 0.9;
                        x: 4 * root.rem-size + (4 * root.rem-size - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1.75 * root.rem-size;
                        height: 1.75 * root.rem-size;
                    }
                }
                show-button := ActionButton {
                    icon: @image-url("icons/play.svg");
                    label: "Show";
                    rem-size: root.rem-size;
                }
            }
        }
    }
}
