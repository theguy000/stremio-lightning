// Based on stremio-web (https://github.com/Stremio/stremio-web), Copyright (C) 2017-2024 Smart code 203358507.
// Numbers translated by hand from src/routes/MetaDetails/styles.less,
// src/routes/MetaDetails/StreamsList/styles.less, src/routes/MetaDetails/StreamsList/Stream/styles.less
// and src/App/styles.less. Licence basis: ../THIRD_PARTY_NOTICES.md. Element ids reuse the web
// class names where one exists.
//
// Web: `.metadetails-content` Ã¢â‚¬â€ a row holding the MetaPreview panel, a flexible spacer, and a
// 30rem column for the Episodes or the Streams. The column's `backdrop-filter: blur(15px)` has no
// Slint equivalent, so only its 0.4 black shows through.
import { ScrollView } from "std-widgets.slint";
import { SelectOption } from "multiselect-menu.slint";
import { MetaPreview, PreviewData } from "meta-preview.slint";
import { Theme } from "theme.slint";
import { VideoRow, VideosList } from "videos-list.slint";

// One source offered for the chosen Video. Web: the addon's name, then the stream's own name
// above its description.
export struct StreamData {
    name: string,
    description: string,
    addon: string,
}

// Web: `.stream-container` — the stream's name over its description, and a play circle that fades
// in with the row's hover. The addon's name is not drawn: the stream's own name takes the row.
component StreamRow inherits Rectangle {
    in property <StreamData> source;
    in property <length> rem-size;
    /// Cut, the description shows three lines and the rest is stopped at the right edge. Wrapped,
    /// it shows every line and the row grows to hold them.
    in property <bool> wrap: false;
    callback clicked;

    // Three lines of the 0.9rem description, which is what a cut row shows. An addon can return
    // far more than that, so this is a cap and not a promise: the third line is where the text
    // stops, mid-word, at the row's right edge.
    property <length> description-cap: root.wrap ? 1000px : 3.5 * root.rem-size;
    // What the description actually takes: its full height while wrapping, the cap while cut.
    property <length> description-shown: Math.min(description-text.preferred-height, root.description-cap);

    // The row is as tall as its text needs, and never shorter than a Stream row was before. The
    // texts report the height they take at the width the layout gives them -- measured at 48px for
    // a three-line description, not one line -- so a wrapped row grows to hold every line and
    // nothing spills into the row below.
    height: Math.max(
        6 * root.rem-size,
        Math.max(name-text.preferred-height, root.description-shown) + 1 * root.rem-size,
    );
    border-radius: 0.75 * root.rem-size;
    background: touch.has-hover ? Theme.overlay : transparent;

    HorizontalLayout {
        padding-top: 0.5 * root.rem-size;
        padding-bottom: 0.5 * root.rem-size;
        padding-left: 1 * root.rem-size;
        padding-right: 1 * root.rem-size;
        spacing: 1 * root.rem-size;

        // The name takes the left slot the addon's name used to hold, and the description takes
        // everything left over beside it. Stacking the two in one column instead put the name in
        // a 7rem box that wrapped, pushed past the row's height and spilled into the next row.
        name-text := Text {
            width: 7 * root.rem-size;
            horizontal-stretch: 0;
            text: root.source.name;
            font-size: 1.1 * root.rem-size;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
            overflow: clip;
            vertical-alignment: center;
        }
        // The description's box is capped in cut mode, and a layout places a capped child at the
        // start of the row's cross axis -- which left the three lines sitting at the top with the
        // name centred beside them. The column centres the capped box in the row instead.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            description-text := Text {
                horizontal-stretch: 1;
                text: root.source.description;
                font-size: 0.9 * root.rem-size;
                color: Theme.text;
                opacity: 0.9;
                // Both modes wrap; only the cap differs. Clipped rather than elided, so a cut line
                // runs to the right edge and stops there instead of ending early with a gap.
                wrap: word-wrap;
                overflow: clip;
                max-height: root.description-cap;
            }
        }

        // Web: `.icon` — a 3rem circle of secondary accent, invisible until the row is hovered.
        // The glyph is white on the green, 1.2rem across, and the box it is drawn in is centred
        // by hand: a layout would stretch the image across its whole axis. The column keeps the
        // circle centred when a wrapped row grows taller than 6rem.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 3 * root.rem-size;
                height: 3 * root.rem-size;
                border-radius: 1.5 * root.rem-size;
                background: Theme.accent-green;
                opacity: touch.has-hover ? 1 : 0;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.2 * root.rem-size;
                    height: 1.2 * root.rem-size;
                    source: @image-url("icons/play.svg");
                    colorize: Theme.text;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Web: `.stream-placeholder-container` Ã¢â‚¬â€ the bars that stand in until an addon answers: a 5x2rem
// addon bar, description bars at 80% and 40%, and a play glyph pinned to the right. All of them in
// the placeholder grey rather than the white overlay the rest of the panel uses.
component StreamPlaceholder inherits Rectangle {
    in property <length> rem-size;

    height: 6 * root.rem-size;

    HorizontalLayout {
        padding-top: 0.5 * root.rem-size;
        padding-bottom: 0.5 * root.rem-size;
        padding-left: 1 * root.rem-size;
        padding-right: 1 * root.rem-size;
        spacing: 1 * root.rem-size;

        // Web: `.addon-container` Ã¢â‚¬â€ a layout stretches its children across its axis, so the bar
        // needs a column of its own to be centred in, level with the bars beside it.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 5 * root.rem-size;
                height: 2 * root.rem-size;
                border-radius: 0.75 * root.rem-size;
                background: Theme.placeholder-background;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 0.5 * root.rem-size;
            Rectangle {
                height: 1.2 * root.rem-size;
                width: 80%;
                border-radius: 0.75 * root.rem-size;
                background: Theme.placeholder-background;
            }
            Rectangle {
                height: 1.2 * root.rem-size;
                width: 40%;
                border-radius: 0.75 * root.rem-size;
                background: Theme.placeholder-background;
            }
        }

        // Web: `.play-icon` Ã¢â‚¬â€ a 3.5x5rem box holding only the glyph, so the row reads as a Stream
        // that has not arrived rather than a row that is missing something.
        Rectangle {
            width: 3.5 * root.rem-size;
            height: 5 * root.rem-size;
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 2.4 * root.rem-size;
                height: 2.4 * root.rem-size;
                source: @image-url("icons/play.svg");
                colorize: Theme.placeholder-background;
            }
        }
    }
}

// Web: StreamsList's `NumberInput` Ã¢â‚¬â€ a 3.5rem pill of the overlay colour holding a minus, the
// label over its value, and a plus. The buttons overlay the pill, so they read a shade lighter.
component NumberStepper inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <length> rem-size;
    callback stepped(int);

    width: 14 * root.rem-size;
    height: 3.5 * root.rem-size;
    border-radius: 3.5 * root.rem-size;
    background: Theme.overlay;

    for side in [{ plus: false, left: true }, { plus: true, left: false }] : Rectangle {
        x: side.left ? 0px : root.width - 3.5 * root.rem-size;
        width: 3.5 * root.rem-size;
        height: 3.5 * root.rem-size;
        border-radius: 1.75 * root.rem-size;
        background: Theme.overlay;
        Image {
            // Web: 1rem of padding inside the 3.5rem button.
            x: 1 * root.rem-size;
            y: 1 * root.rem-size;
            width: 1.5 * root.rem-size;
            height: 1.5 * root.rem-size;
            source: side.plus ? @image-url("icons/add.svg") : @image-url("icons/remove.svg");
            colorize: Theme.text;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.stepped(side.plus ? 1 : -1);
            }
        }
    }

    VerticalLayout {
        // Web: `.number-display` Ã¢â‚¬â€ flex 1 between the two 3.5rem buttons, centred, 1rem of padding.
        x: 3.5 * root.rem-size;
        width: parent.width - 7 * root.rem-size;
        alignment: center;
        spacing: 0;
        Text {
            text: root.label;
            font-size: 0.8 * root.rem-size;
            color: Theme.text;
            opacity: 0.7;
            horizontal-alignment: center;
        }
        Text {
            text: "\{root.value}";
            font-size: 1.2 * root.rem-size;
            color: Theme.text;
            horizontal-alignment: center;
        }
    }
}

// Web: `.message-container` Ã¢â‚¬â€ what stands where an empty Streams list would be: the Season and
// Episode steppers over a disabled "Show Streams", the empty illustration, the label, and the way
// to the Addons screen.
component StreamsMessage inherits Rectangle {
    in property <length> rem-size;
    in property <bool> show-steps: false;
    in property <int> season: 0;
    in property <int> episode: 0;
    in property <bool> can-show-streams: false;
    callback step-season(int);
    callback step-episode(int);
    callback show-streams;

    VerticalLayout {
        alignment: start;
        // Web: the message container pads itself by 1rem.
        padding: 1 * root.rem-size;

        if root.show-steps: VerticalLayout {
            alignment: start;
            spacing: 1 * root.rem-size;
            // Web: `.search` is 14rem wide Ã¢â‚¬â€ the steppers' own max-width Ã¢â‚¬â€ and the button stretches
            // across it. Its own 1rem bottom margin is the gap before the illustration.
            padding-bottom: 1 * root.rem-size;

            HorizontalLayout {
                alignment: center;
                NumberStepper {
                    label: "Season";
                    value: root.season;
                    rem-size: root.rem-size;
                    stepped(delta) => {
                        root.step-season(delta);
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                NumberStepper {
                    label: "Episode";
                    value: root.episode;
                    rem-size: root.rem-size;
                    stepped(delta) => {
                        root.step-episode(delta);
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    // Web: `.button-container` Ã¢â‚¬â€ a 2rem pill in the accent colour, 0.5 opacity and
                    // no pointer events while it names the Video already on screen.
                    width: 14 * root.rem-size;
                    height: 4 * root.rem-size;
                    border-radius: 2 * root.rem-size;
                    background: Theme.accent;
                    opacity: root.can-show-streams ? 1 : 0.5;
                    Text {
                        text: "Show Streams";
                        font-size: 1 * root.rem-size;
                        font-weight: 700;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    touch := TouchArea {
                        enabled: root.can-show-streams;
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-streams();
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            Image {
                // Web: a 10rem square, 0.9 opaque, over a 1rem gap.
                width: 10 * root.rem-size;
                height: 10 * root.rem-size;
                source: @image-url("images/empty.png");
                opacity: 0.9;
            }
        }
        VerticalLayout {
            padding-top: 1 * root.rem-size;
            padding-bottom: 2 * root.rem-size;
            Text {
                text: "No streams were found";
                font-size: 1.4 * root.rem-size;
                color: Theme.text;
                horizontal-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                // Web: `.install-button-container` Ã¢â‚¬â€ the secondary accent, 2rem radius, 4rem tall.
                height: 4 * root.rem-size;
                border-radius: 2 * root.rem-size;
                background: Theme.accent-green;
                HorizontalLayout {
                    alignment: center;
                    padding-left: 2 * root.rem-size;
                    padding-right: 2 * root.rem-size;
                    spacing: 1 * root.rem-size;
                    // A layout stretches its children across its axis, so the icon needs a column
                    // of its own to sit in the middle of, level with the label beside it.
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 2 * root.rem-size;
                            height: 2 * root.rem-size;
                            // Web's jigsaw glyph is drawn on a 512 grid, and at 2rem its notches
                            // fill in and it reads as a blob. This one is drawn on a 24 grid for
                            // this size.
                            source: @image-url("icons/install-addons.svg");
                            colorize: Theme.text;
                        }
                    }
                    Text {
                        text: "Install addons";
                        font-size: 1 * root.rem-size;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Web: `.videos-list` / `.streams-list` Ã¢â‚¬â€ the 30rem column: the Episode picker, or the Episode's
// name over the Streams the addons answered with. Rounded on its left in a row, along its top
// when the screen is one column.
component DetailsPanel inherits Rectangle {
    in property <length> rem-size;
    in property <[SelectOption]> seasons;
    in property <int> season-index: 0;
    in property <string> season-title;
    in property <[VideoRow]> episodes;
    in property <string> query;
    in property <bool> show-picker: false;
    in property <string> picked-label;
    in property <[StreamData]> streams;
    in property <int> streams-loading: 0;
    in property <bool> waits-for-streams: false;
    /// False until the addons have answered with the title itself. Nothing can be said about
    /// its Streams before that, so the panel waits instead of announcing there are none.
    in property <bool> has-title: false;
    in property <bool> rate-visible: false;
    in property <bool> rate-enabled: false;
    in property <bool> rated-liked: false;
    in property <bool> rated-loved: false;
    in property <string> play-message;
    in property <bool> has-steps: false;
    in property <int> season-number: 0;
    in property <int> episode-number: 0;
    in property <bool> can-show-streams: false;
    /// Whether the Streams list wraps its descriptions instead of cutting them to one line.
    in property <bool> wrap-streams: false;
    callback select-season(int);
    callback pick-video(string);
    callback search-videos(string);
    callback back-to-episodes();
    callback play-stream(int);
    callback stepped-season(int);
    callback stepped-episode(int);
    callback show-streams;
    callback toggle-stream-wrap;

    background: #00000066;
    // Web: rounded along its left, square against the window's edge.
    border-top-left-radius: 0.75 * root.rem-size;
    border-bottom-left-radius: 0.75 * root.rem-size;

    if root.show-picker: VideosList {
        seasons: root.seasons;
        season-index: root.season-index;
        season-title: root.season-title;
        videos: root.episodes;
        rem-size: root.rem-size;
        query: root.query;
        select-season(index) => {
            root.select-season(index);
        }
        pick-video(id) => {
            root.pick-video(id);
        }
        search-videos(text) => {
            root.search-videos(text);
        }
    }

    if root.show-picker == false: VerticalLayout {
        spacing: 0;

        // Web: .select-choices-wrapper Ã¢â‚¬â€ the way back beside the Episode's name. It belongs to a
        // list that stands for one chosen Episode, so a Film, whose Streams are its only page,
        // has none: that button had nothing to go back to and left "No streams were found" behind.
        // The cut/wrap toggle rides at the right of this row whether or not there is a way back.
        HorizontalLayout {
            // Web: .select-choices-wrapper carries a 1em top margin above the 3rem button.
            height: 4 * root.rem-size;
            padding-top: 1 * root.rem-size;
            padding-left: 1 * root.rem-size;
            padding-right: 1 * root.rem-size;
            spacing: 0.5 * root.rem-size;
            alignment: start;

            if root.picked-label != "": Rectangle {
                width: 3 * root.rem-size;
                height: 3 * root.rem-size;
                border-radius: 0.5 * root.rem-size;
                background: back-touch.has-hover ? Theme.overlay : transparent;
                // Centred by hand: a HorizontalLayout stretches its children instead.
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.5 * root.rem-size;
                    height: 1.5 * root.rem-size;
                    source: @image-url("icons/chevron-back.svg");
                    colorize: Theme.text;
                    opacity: 0.6;
                }
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.back-to-episodes();
                    }
                }
            }
            if root.picked-label != "": Text {
                // Button height, so its centred text lines up with the chevron beside it.
                height: 3 * root.rem-size;
                text: root.picked-label;
                color: Theme.text;
                font-size: root.rem-size;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Pushes the toggle to the row's right edge, and takes the label's place when a Film
            // has no label to stretch instead.
            Rectangle {
                horizontal-stretch: root.picked-label == "" ? 1 : 0;
            }

            // The Streams' descriptions can run to several lines. Web never had a switch for it;
            // this one cuts every row to a single line or lets them all wrap, and the choice is
            // kept beside the profile so it is the same after a restart.
            wrap-touch := Rectangle {
                width: 3 * root.rem-size;
                height: 3 * root.rem-size;
                horizontal-stretch: 0;
                border-radius: 0.5 * root.rem-size;
                background: root.wrap-streams ? Theme.overlay
                    : (wrap-hover.has-hover ? Theme.overlay : transparent);

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.5 * root.rem-size;
                    height: 1.5 * root.rem-size;
                    source: @image-url("icons/wrap-text.svg");
                    colorize: Theme.text;
                    opacity: root.wrap-streams ? 1 : 0.6;
                }
                wrap-hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-stream-wrap();
                    }
                }
            }
        }

        // Web: .streams-container Ã¢â‚¬â€ flex 1, padding 0 1rem, overflows.
        VerticalLayout {
            padding-left: 1 * root.rem-size;
            padding-right: 1 * root.rem-size;
            padding-top: 1 * root.rem-size;
            spacing: 0;

            Text {
                text: root.play-message;
                color: Theme.accent-red;
                font-size: 0.9 * root.rem-size;
                wrap: word-wrap;
            }

            // Web: nothing Ready yet means two placeholders Ã¢â‚¬â€ and nothing of the last
            // Episode's list survives the swap. They stand in while the title is still on its way,
            // whatever its addons turn out to be, and later only while an addon that offers
            // Streams is still out: with none installed the rows would be a wait for nothing.
            if root.streams.length == 0 && (root.streams-loading > 0 ? root.waits-for-streams : !root.has-title): VerticalLayout {
                alignment: start;
                StreamPlaceholder { rem-size: root.rem-size; }
                StreamPlaceholder { rem-size: root.rem-size; }
            }

            // Web: `.message-container` stands where the list would be once the addons have all
            // answered and none of them offered a stream. The title has to be in first: saying
            // "No streams were found" about a title whose name is not known yet is a guess, and on
            // a Series it would flash over the Episode list that is still coming.
            if root.streams.length == 0 && root.has-title && (root.streams-loading == 0 || !root.waits-for-streams): ScrollView {
                StreamsMessage {
                    rem-size: root.rem-size;
                    show-steps: root.has-steps;
                    season: root.season-number;
                    episode: root.episode-number;
                    can-show-streams: root.can-show-streams;
                    step-season(delta) => {
                        root.stepped-season(delta);
                    }
                    step-episode(delta) => {
                        root.stepped-episode(delta);
                    }
                    show-streams => {
                        root.show-streams();
                    }
                }
            }

            if root.streams.length > 0: ScrollView {
                VerticalLayout {
                    alignment: start;
                    for stream[index] in root.streams: StreamRow {
                        source: stream;
                        rem-size: root.rem-size;
                        wrap: root.wrap-streams;
                        clicked => {
                            root.play-stream(index);
                        }
                    }
                }
            }

            // Web: .addons-loading-container Ã¢â‚¬â€ the count of addons still out, over an
            // accent bar. It only appears once there is something to read.
            if root.streams.length > 0 && root.streams-loading > 0: VerticalLayout {
                alignment: center;
                padding: 2 * root.rem-size;
                spacing: 1 * root.rem-size;
                Text {
                    text: root.streams-loading + " addons loading";
                    color: Theme.text;
                    font-size: 1 * root.rem-size;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 90%;
                    height: 0.3 * root.rem-size;
                    border-radius: 0.75 * root.rem-size;
                    background: Theme.accent;
                }
            }
        }
    }
}

export component DetailsScreen inherits Rectangle {
    in property <PreviewData> preview;
    in property <bool> has-preview: false;
    in property <[VideoRow]> episodes;
    in property <string> video-query;
    in property <[SelectOption]> seasons;
    in property <int> season-index: 0;
    in property <string> season-title;
    in property <bool> show-picker: false;
    in property <string> picked-label;
    in property <[StreamData]> streams;
    in property <int> streams-loading: 0;
    in property <bool> waits-for-streams: false;
    /// False until the addons have answered with the title itself. Nothing can be said about
    /// its Streams before that, so the panel waits instead of announcing there are none.
    in property <bool> has-title: false;
    in property <bool> rate-visible: false;
    in property <bool> rate-enabled: false;
    in property <bool> rated-liked: false;
    in property <bool> rated-loved: false;
    in property <string> play-message;
    in property <bool> has-steps: false;
    in property <int> season-number: 0;
    in property <int> episode-number: 0;
    in property <bool> can-show-streams: false;
    /// Whether the Streams list wraps its descriptions instead of cutting them to one line.
    in property <bool> wrap-streams: false;
    in property <length> rem-size: 14px;
    /// The top bar's height: the artwork runs under it, the content does not.
    in property <length> bar-height: 0px;
    callback select-season(int);
    callback pick-video(string);
    callback search-videos(string);
    callback back-to-episodes();
    callback play-stream(int);
    callback step-season(int);
    callback step-episode(int);
    callback show-streams;
    callback toggle-stream-wrap;
    callback share;
    callback rate-like;
    callback rate-love;

    background: Theme.modal-background;

    // Web: .background-image-layer Ã¢â‚¬â€ fixed over the whole viewport, so the artwork also runs
    // under the top bar, with everything else laid on top of it.
    if root.has-preview && root.preview.has-background: Image {
        width: 100%;
        height: 100%;
        source: root.preview.background;
        image-fit: cover;
        opacity: 0.3;
    }

    // Web: .metadetails-content pads past the top overlay rather than starting flush under it.
    HorizontalLayout {
        y: root.bar-height + 1.5 * root.rem-size;
        height: parent.height - root.bar-height - 1.5 * root.rem-size;

        // Web: .meta-preview Ã¢â‚¬â€ flex 0 1 auto with `padding: 0 4rem 2rem 4rem`.
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-left: 4 * root.rem-size;
                padding-right: 4 * root.rem-size;
                padding-bottom: 2 * root.rem-size;
                MetaPreview {
                    preview: root.preview;
                    has-preview: root.has-preview;
                    rem-size: root.rem-size;
                    on-page: true;
                    rate-visible: root.rate-visible;
                    rate-enabled: root.rate-enabled;
                    rated-liked: root.rated-liked;
                    rated-loved: root.rated-loved;
                    share => {
                        root.share();
                    }
                    rate-like => {
                        root.rate-like();
                    }
                    rate-love => {
                        root.rate-love();
                    }
                }
            }
        }

        DetailsPanel {
            width: 30 * root.rem-size;
            rem-size: root.rem-size;
            seasons: root.seasons;
            season-index: root.season-index;
            season-title: root.season-title;
            episodes: root.episodes;
            query: root.video-query;
            show-picker: root.show-picker;
            picked-label: root.picked-label;
            streams: root.streams;
            streams-loading: root.streams-loading;
            waits-for-streams: root.waits-for-streams;
            has-title: root.has-preview;
            play-message: root.play-message;
            has-steps: root.has-steps;
            season-number: root.season-number;
            episode-number: root.episode-number;
            can-show-streams: root.can-show-streams;
            wrap-streams: root.wrap-streams;
            select-season(index) => {
                root.select-season(index);
            }
            pick-video(id) => {
                root.pick-video(id);
            }
            search-videos(text) => {
                root.search-videos(text);
            }
            back-to-episodes => {
                root.back-to-episodes();
            }
            play-stream(index) => {
                root.play-stream(index);
            }
            stepped-season(delta) => {
                root.step-season(delta);
            }
            stepped-episode(delta) => {
                root.step-episode(delta);
            }
            show-streams => {
                root.show-streams();
            }
            toggle-stream-wrap => {
                root.toggle-stream-wrap();
            }
        }
    }
}
