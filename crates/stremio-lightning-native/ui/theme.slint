// Colours come from @stremio/stremio-colors 5.2.0 (MIT), converted from HSL to hex.
// See ../THIRD_PARTY_NOTICES.md.
import "./fonts/PlusJakartaSans-Regular.ttf";
import "./fonts/PlusJakartaSans-Medium.ttf";
import "./fonts/PlusJakartaSans-SemiBold.ttf";
import "./fonts/PlusJakartaSans-Bold.ttf";

export global Theme {
    out property <string> font-family: "Plus Jakarta Sans";

    out property <color> background: #2a2843;
    out property <color> primary: #664181;
    out property <color> secondary: #3b4b81;
    out property <color> surface: #bfbfbf;
    out property <color> accent-red: #ff7070;
    out property <color> accent-green: #22b365;
    out property <color> accent-yellow: #ffba19;

    // Measured on web.stremio.com at 1100x720. Composited readings, not the page's CSS values.
    out property <brush> page-background: @linear-gradient(41deg, #0c0b11 0%, #1a173e 100%);
    out property <color> text: #ffffffe6;
    out property <color> accent: #7b5bf5;
    out property <color> overlay: #ffffff0d;
    out property <color> icon-muted: #5c5b66;
    out property <color> placeholder: #9594a0;
    out property <color> search-icon: #9998a6;
    out property <color> toolbar-icon: #63617a;
    out property <color> caret-icon: #9594a6;
    out property <color> avatar: #8088bc;
}
